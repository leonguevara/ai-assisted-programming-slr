	note = {arXiv:2510.20270 [cs.LG]},
	publisher = {arXiv},
	shorttitle = {{ImpossibleBench}},
	title = {{ImpossibleBench}: {Measuring} {LLMs}' {Propensity} of {Exploiting} {Test} {Cases}},
	url = {http://arxiv.org/abs/2510.20270},
