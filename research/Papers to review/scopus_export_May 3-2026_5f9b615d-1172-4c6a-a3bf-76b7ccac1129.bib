	year = {2025},
	journal = {Proceedings of Machine Learning Research},
	volume = {267},
	pages = {26058 - 26076},
	url = {https://www.scopus.com/pages/publications/105023636105?origin=resultslist},
	affiliations = {University of Hong Kong, Hong Kong; National University of Singapore, Singapore; Singapore University of Technology and Design, Singapore; University of Edinburgh, United Kingdom; Beijing University of Posts and Telecommunications, China; University of Cambridge, United Kingdom; King’s College London, United Kingdom},
	abstract = {As Large Language Models (LLMs) play an important role in code generation, enhancing both correctness and efficiency has become crucial. Current methods primarily focus on correctness, often overlooking efficiency. To address this gap, we introduce EFFICODER to improve both aspects by fine-tuning LLMs on a high-quality dataset EFFIINSTRUCT comprising correct and efficient code samples. Our method involves leveraging multiple LLMs to generate diverse candidate code solutions for various tasks across different programming languages. We then evaluate these solutions by measuring their execution time and memory usage through local execution. The code solution with the lowest execution time and memory consumption is selected as the final output for each task. Experimental results demonstrate significant improvements when fine-tuning with EF FIINSTRUCT. For instance, Qwen2.5-Coder-7B Instruct’s pass@1 score increases from 44.8% to 57.7%, while the average execution time for correct tasks decreases by 48.4%. EFFICODER offers a scalable and effective solution for advancing AIdriven code generation, benefiting both software development and computational problem-solving. Dataset and Code are available at https:// github.com/huangd1999/EffiCoder. © 2025, ML Research Press. All rights reserved.},
