@CONFERENCE{Kaynak2025827,
	author = {Kaynak, Ergun Batuhan and Lami, Mayasah and Moslemi, Sahand and Koyuncu, Anil},
	title = {LLMShot: Reducing Snapshot Testing Maintenance via LLMs},
	year = {2025},
	journal = {Proceedings - 2025 IEEE International Conference on Software Maintenance and Evolution, ICSME 2025},
	pages = {827 - 832},
	doi = {10.1109/ICSME64153.2025.00087},
	url = {https://www.scopus.com/pages/publications/105022487890?origin=resultslist},
	affiliations = {Bilkent University, Turkey},
	abstract = {Snapshot testing has emerged as a critical technique for UI validation in modern software development, yet it suffers from substantial maintenance overhead due to frequent UI changes causing test failures that require manual inspection to distinguish between genuine regressions and intentional design changes. This manual triage process becomes increasingly burdensome as applications evolve, creating a need for automated analysis solutions. This paper introduces LLMShot, a novel framework that leverages Vision-Language Models (VLMs) to automatically analyze snapshot test failures through semantic classification of UI changes. To evaluate LLMShot's effectiveness, we developed a comprehensive dataset using a feature-rich iOS application with configurable feature flags, creating realistic scenarios that produce authentic snapshot differences representative of real development workflows. Our evaluation using Gemma3 models demonstrates strong classification performance, with the 12 B variant achieving over 84 % recall in identifying failure root causes while the 4 B model offers practical deployment advantages with acceptable performance for continuous integration environments. However, our exploration of selective ignore mechanisms revealed significant limitations in current prompting-based approaches for controllable visual reasoning. LLMShot represents the first automated approach to semantic snapshot test analysis, offering developers structured insights that can substantially reduce manual triage effort and advance toward more intelligent UI testing paradigms.  © 2025 IEEE.},
	author_keywords = {automated test analysis; large language models; snapshot testing; software testing; user interface testing; vision-language models},
	keywords = {Automation; Computer vision; Semantics; Software design; Automated test; Automated test analyze; Interface testings; Language model; Large language model; Snapshot testing; Software testings; Test analysis; User interface testing; Vision-language model; Software testing},
