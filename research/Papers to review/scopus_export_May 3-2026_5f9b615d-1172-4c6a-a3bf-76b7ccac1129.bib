	keywords = {Computer aided software engineering; Modeling languages; Natural language processing systems; Requirements engineering; Software design; Support vector machines; Analysis and models; Analysis method; Language model; Large language model; Machine-learning; Model method; Natural languages; Requirement analysis; Requirements classifications; Requirements modeling; Application programs},
