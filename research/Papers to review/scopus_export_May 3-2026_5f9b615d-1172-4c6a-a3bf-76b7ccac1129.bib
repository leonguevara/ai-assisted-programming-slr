@ARTICLE{Dong20252468,
	author = {Dong, Zheng-Yu and Zhang, Wei-Feng and Xu, Lei and He, Hua and Mei, Guang-Hui and Xuan, Ji-Feng},
	title = {Automated Merge Conflict Resolution Based on Code Context and Large Language Models; [基于代码上下文与大语言模型的自动化合并冲突解决方法]},
	year = {2025},
	journal = {Jisuanji Xuebao/Chinese Journal of Computers},
	volume = {48},
