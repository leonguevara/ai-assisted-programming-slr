	affiliations = {Laboratory of Applied Geophysics, Geotechnics, Engineering Geology and Environment, Mohammadia School of Engineers, Mohammed V University in Rabat, Morocco; Laboratory of Engineering Sciences, National School of Applied Sciences, Ibn Tofail University, Kenitra, Morocco; School of Electrical Engineering and Computer Science, University of Ottawa, 800 King Edward Ave., Ottawa, ON, Canada},
