@ARTICLE{Hsueh2024,
	author = {Hsueh, Nien-Lin and Lin, Hsuen-Jen and Lai, Lien-Chi},
	title = {Applying Large Language Model to User Experience Testing},
	year = {2024},
	journal = {Electronics (Switzerland)},
