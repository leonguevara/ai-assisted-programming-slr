	title = {Designing Reusable LLM-Enhanced Assignments: A Quality-Oriented Framework for Software Engineering Education},
	year = {2025},
	journal = {Proceedings - 2025 IEEE 49th Annual Computers, Software, and Applications Conference, COMPSAC 2025},
	pages = {2212 - 2217},
