}

@CONFERENCE{Paul2025549,
	author = {Paul, Soumen and Majumdar, Srijoni and Shah, Raj and Das, Susmita and Ghosh, Madhusudan and Ganguly, Debasis and Calikli, Gul and Sanyal, Debarshi and Das, Partha Pratim and Clough, Paul D. and Bandyopadhyay, Ayan and Chattopadhyay, Samiran},
