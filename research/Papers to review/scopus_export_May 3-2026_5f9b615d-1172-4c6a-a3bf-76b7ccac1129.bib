	keywords = {Automatic programming; Benchmarking; Integrodifferential equations; Optimal systems; Project management; Software design; Visual languages; Code optimization; Codegeneration; Github copilot; Interactive development environment; Interactive development environment integration; Language model; Large language model; Real time coding; Tabnine; Work-flows; Codes (symbols)},
