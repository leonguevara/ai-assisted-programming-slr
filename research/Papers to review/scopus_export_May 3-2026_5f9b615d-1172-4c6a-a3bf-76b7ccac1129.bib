@ARTICLE{He2025,
	author = {He, Rui and Zhang, Liang and Lyu, Mengyao and Lyu, Liangqing and Xue, Changbin},
	title = {Using Large Language Models for Aerospace Code Generation: Methods, Benchmarks, and Potential Values},
