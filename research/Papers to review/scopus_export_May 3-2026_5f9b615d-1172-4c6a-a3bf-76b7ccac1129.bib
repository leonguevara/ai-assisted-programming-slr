@CONFERENCE{Zhong2025366,
	author = {Zhong, Zhuoqing and Liu, Wei and Yang, Changye},
	title = {RepoFusion-in-Decoder: Efficient Cross-File Code Completion via Lightweight Encoder Fusion},
	year = {2025},
	journal = {2025 5th International Conference on Advanced Algorithms and Neural Networks, AANN 2025},
	pages = {366 - 369},
	doi = {10.1109/AANN66429.2025.11257694},
	url = {https://www.scopus.com/pages/publications/105031116961?origin=resultslist},
	affiliations = {Wenzhou-Kean University, Department of Computer Science, Wenzhou, China; Central South University, Department of Computer Science and Engineering, Changsha, China},
	abstract = {Large language model (LLM) based code completion tools have greatly enhanced software development productivity by providing repository-aware suggestions. However, existing state-of-the-art decoder-only LLMs, such as Qwen2.5-Coder-3B, suffer from high latency, particularly due to expensive prefill computations when leveraging long, repository-scale contexts. This latency limits their practical deployment in highly interactive programming environments. In this work, we propose an efficient Fusion-in-Decoder (FiD) architecture that extends a pre-trained, high-quality decoder-only code LM with a lightweight encoder and trainable cross-attention layers, while keeping the decoder frozen. Our approach enables independent encoding and caching of cross-file code chunks, substantially reducing prefill time. We design a two-stage data preparation pipeline leveraging repository-level chunking and BM25-based retrieval to supply realistic multi-file context. Experiments on the Long Code Arena and RepoEval-Updated benchmarks demonstrate that our model achieves significant reductions in end-to-end latency, particularly with long prompts, while sustaining strong code completion performance. Our results highlight the promise of FiD-augmented decoder-only models for low-latency cross-file code completion at scale. © 2025 IEEE.},
	author_keywords = {Code Completion; Fusion-in-Decoder; Large Language Models},
	keywords = {Decoding; Signal encoding; Software design; Code completions; Completion tools; Development productivity; Enhanced software; Fusion-in-decoder; Language model; Large language model; Model-based OPC; Programming environment; State of the art; Benchmarking},
	correspondence_address = {Z. Zhong; Wenzhou-Kean University, Department of Computer Science, Wenzhou, China; email: zhongzh@kean.edu},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833159736-8},
	language = {English},
	abbrev_source_title = {Int. Conf. Adv. Algorithms Neural Networks, AANN},
