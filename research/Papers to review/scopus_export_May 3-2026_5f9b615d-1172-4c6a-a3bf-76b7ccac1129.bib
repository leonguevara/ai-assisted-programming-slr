@CONFERENCE{Da Giao2025221,
	author = {Da Giao, Hugo and Amaral, Vasco and Engels, Gregor and Flores, Andre and Pereira, Rui and Sauer, Stefan and Cunha, Jacome},
	title = {A Metamodel for Reengineering CI/CD Pipelines},
	year = {2025},
	journal = {Proceedings - 2025 ACM/IEEE 28th International Conference on Model Driven Engineering Languages and Systems, MODELS 2025},
	pages = {221 - 231},
	doi = {10.1109/MODELS67397.2025.00026},
	url = {https://www.scopus.com/pages/publications/105029814805?origin=resultslist},
	affiliations = {University of Porto, HASLab/INESC TEC, Faculty of Engineering, Portugal; NOVA University Lisbon, Portugal; Paderborn University, Software Innovation Campus Paderborn, Germany; OutSystems, Portugal},
	abstract = {In the realm of industrial software development, DevOps has emerged as the preferred approach for handling the highly iterative software production process. DevOps refers to the tight integration of development and operations activities, with Continuous Integration, Continuous Delivery, and Continuous Deployment (CI/CD) being pivotal methodologies for ensuring the iterative delivery of high-quality software. To achieve CI/CD, pipelines of activities are deployed using commercial tools. Due to the dynamic nature of these tools, CI/CD pipelines are often migrated to new versions or even new tools. Since this is mostly a manual process, it is a cumbersome and error-prone activity. To assist software engineers during this process, we propose a novel approach that leverages model-driven engineering (MDE) to support the migration of CI/CD pipelines. Our approach is inspired by the traditional reengineering horseshoe model, which abstracts existing pipeline artifacts into a comprehensive model as an intermediate representation. From these models, we can then generate semantic-equivalent pipelines for any novel CI/CD tool. Thus, our main contribution comprises a metamodel designed to represent the structure of existing CI/CD pipelines and build the foundation for MDE-based migration of CI/CD pipelines. We validated our metamodel by successfully modeling 400 existing pipelines. This evaluation demonstrated a 100% applicability rate when applied to configuration files from technologies that collectively account for over 92% of CI/CD scripts in use. Furthermore, we conducted a detailed case study demonstrating the practical applicability of our approach in real-world migration scenarios. Finally, we demonstrate that our metamodel promotes equivalence between an original pipeline and a new one generated from it in a different technology by showing through test cases that the execution traces of both pipelines are identical.  © 2025 IEEE.},
	author_keywords = {CI/CD; Code Generation; DevOps; Model-Driven Engineering; Reengineering; Software Evolution},
	keywords = {Iterative methods; Pipelines; Software design; Software quality; Codegeneration; Continuous delivery, and continuous deployment; Development and operations; Industrial software development; Meta model; Model-driven Engineering; Production process; Software Evolution; Software production; Tight integrations; Reengineering},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833154910-7},
	language = {English},
	abbrev_source_title = {Proc. - ACM/IEEE Int. Conf. Model Driven Eng. Lang. Syst., MODELS},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@CONFERENCE{Nadendla2025,
	author = {Nadendla, Sucharitha and Karanam, Sravya and Gehringer, Edward F.},
	title = {WIP: Literature Review on LLMs to Improve Code},
	year = {2025},
	journal = {Proceedings - Frontiers in Education Conference, FIE},
	pages = {},
	doi = {10.1109/FIE63693.2025.11328320},
	url = {https://www.scopus.com/pages/publications/105033060740?origin=resultslist},
	affiliations = {North Carolina State University, Raleigh, NC, United States},
	abstract = {This work-in-progress paper explores how Large Language Models (LLMs) can elevate code quality in software engineering education and practice. While recent advancements show promise in improving code style, documentation, and design principle adherence, existing research is fragmented, making it difficult to identify best practices. A curated review of 50 papers, screened and categorized using Covidence, focuses on three critical dimensions: code styling, documentation generation, and alignment with design principles. Studies limited to performance metrics or debugging were excluded to maintain a targeted scope. Initial analysis reveals that, although LLMs generate readable code, they often lack context-aware support for robust design and well-structured documentation. This research aims to establish a taxonomy of LLM applications and deliver actionable guidelines for using LLMs to produce clean, maintainable code that aligns with both instructional and professional standards. © 2025 IEEE.},
	author_keywords = {Code Quality; Large Language Models; Literature Review; Software Engineering Education},
