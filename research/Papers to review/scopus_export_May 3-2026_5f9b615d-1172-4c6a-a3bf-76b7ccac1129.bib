	url = {https://www.scopus.com/pages/publications/105035617231?origin=resultslist},
	affiliations = {Henan University of Science and Technology, Luoyang, China; Huanghe University of Science and Technology, Jiyuan, China; Huanghe University of Science and Technology, Zhengzhou, China},
	abstract = {In recent years, the automation of continuous integration and deployment in software engineering has been continuously improving. However, the hierarchical complexity of workflows and cross-framework dependencies still limit their efficiency and reliability. Large language models (LLMs) offer new insights into workflow generation, but traditional serialized generation methods struggle to model hierarchical structures and cross-node constraints, often leading to syntactic errors and semantic mismatches. To address these challenges, this paper proposes a hierarchical graph semantic-enhanced prefix finetuning method for workflow generation. First, structural features of workflows are extracted through Syntax Trees (ASTs), forming data representations for fine-tuning. Next, a Transformer is used for semantic mapping and feature encoding, establishing a unified representation of structure and semantics. Finally, a hierarchical graph neural network generates prefix vectors and injects them into the attention layers of a large language model, enabling parameter-efficient, structure-guided generation. Additionally, to avoid sequence bottlenecks and long-dependency attenuation, a hierarchical attention mechanism is employed to enhance the modeling capability of the graph neural network, ensuring structural consistency and semantic integrity throughout the decoding process. Experimental results show that this method effectively alleviates issues of structural and semantic inconsistency, demonstrating its effectiveness and universality in workflow generation tasks. © 2025 IEEE.},
	author_keywords = {CI/CD Workflow Generation; Hierarchical Attention; Hierarchical Graph Neural Networks; Large Language Models; Prefix FineTuning},
	keywords = {Computational linguistics; Graph neural networks; Graph structures; Graph theory; Industrial management; Industrial research; Semantic Web; Semantics; Software engineering; CI/CD workflow generation; Graph neural networks; Graph semantics; Hierarchical attention; Hierarchical graph neural network; Hierarchical graphs; Language model; Large language model; Prefix finetuning; Work-flows; Syntactics},
