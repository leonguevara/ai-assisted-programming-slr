@ARTICLE{Xiao2026,
	author = {Xiao, Xingyu and Chen, Peng and Jia, Qianqian and Tong, Jiejuan and Zhao, Jun and Zhao, Hongru and Liang, Jingang and Wang, Haitao},
	title = {An intelligent framework for automated human reliability data generation in complex industrial systems},
	year = {2026},
	journal = {Computers and Industrial Engineering},
	volume = {213},
