}

@ARTICLE{Pakis20251205,
	author = {Pakis, Ahmet Efe and Kolukisa-Tarhan, Ayca},
	title = {Code Generation in LLM Families: A Quality Comparison of Reasoner and Regular Models},
	year = {2025},
	journal = {International Conference on Computer Science and Engineering, UBMK},
	number = {2025},
	pages = {1205 - 1210},
	doi = {10.1109/UBMK67458.2025.11207012},
	url = {https://www.scopus.com/pages/publications/105030870280?origin=resultslist},
	affiliations = {Hacettepe University, Department of Computer Engineering, Ankara, Turkey},
	abstract = {AI-assisted code generation tools such as GitHub Copilot, Amazon CodeWhisperer, and ChatGPT are transforming software development by automating routine programming tasks. There is particularly novel advancement in large language models which now function as reasoner tools capable of generating code by running step-by-step internal conversations. This study aims to present a case study that investigates the code quality differences between standard and reasoning models within LLM families, specifically DeepSeek, Claude, and ChatGPT to evaluate the advantages and disadvantages one has over the other. Using prompts from HumanEval dataset, each model's generated code snippets are assessed for validity by compilation and for correctness through unit tests to compare their performance. Novel large language models generally exhibit higher code validity and correctness than previously studied models in the literature, with reasoning models showing varying degrees of improvement depending on the LLM family and prompt type. These findings suggest that the impact of reasoning techniques on code generation quality is complex and contingent on the specific language model and prompting strategy employed. GitHub Drive.  © 2025 IEEE.},
