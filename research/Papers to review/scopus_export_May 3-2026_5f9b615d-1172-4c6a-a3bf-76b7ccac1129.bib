	pages = {776 - 781},
	doi = {10.1109/ICIMTech67074.2025.11265694},
	url = {https://www.scopus.com/pages/publications/105031423404?origin=resultslist},
	affiliations = {Bina Nusantara University, School of Information Systems, Information Systems Department, Jakarta, 11480, Indonesia},
	abstract = {This research attempts to assess and contrast how well two generative AI models, ChatGPT and DeepSeek, perform when it comes to producing Python code using text-to-code and code-to-code prompt techniques. This research employs an experimental approach by evaluating the models' accuracy based on the generated code's classification outcomes, using logistic regression as the coding task. In order to guarantee structured input, the prompts are generated using six essential parameters: Task, Context, Example, Persona, Format, and Tone. As demonstrated by the results, ChatGPT consistently performs better than DeepSeek in both kinds of prompts, obtaining more balanced performance metrics and higher classification accuracy. Even though DeepSeek produces more expressive and detailed results, its efficacy declines in low-data situations, suggesting that it is more sensitive to prompt structure and dataset size. This research provides practical insights into rapid design and model selection for developers and researchers working with generative AI in software development tasks.  © 2025 IEEE.},
