@CONFERENCE{Yamani2025133,
	author = {Yamani, Asma and Baslyman, Malak and Ahmed, Moataz},
	title = {Are We Aligned? A Preliminary Investigation of the Alignment of Responsible AI Values between LLMs and Human Judgment},
	year = {2025},
	journal = {Proceedings - 2025 2nd IEEE/ACM International Conference on AI-powered Software, AIware 2025},
	pages = {133 - 142},
	doi = {10.1109/AIware69974.2025.00022},
	url = {https://www.scopus.com/pages/publications/105035228058?origin=resultslist},
	affiliations = {KFUPM, Information and Computer Science Department, Dhahran, Saudi Arabia; KFUPM, IRC for Finance and Digital Economy, Dhahran, Saudi Arabia; KFUPM, SDAIA-KFUPM Joint Research Center for Artificial Intelligence, Dhahran, Saudi Arabia},
	abstract = {Large Language Models (LLMs) are increasingly employed in software engineering tasks such as requirements elicitation, design, and evaluation, raising critical questions regarding their alignment with human judgments on responsible AI values. This study investigates how closely LLMs' value preferences align with those of two human groups-A USrepresentative sample and AI practitioners. We evaluate 23 LLMs across four tasks: (T1) selecting key responsible AI values, (T2) rating their importance in specific contexts, (T3) resolving tradeoffs between competing values, and (T4) prioritizing software requirements that embody those values. The results show that LLMs generally align more closely with AI practitioners than with the US-representative sample, emphasizing fairness, privacy, transparency, safety, and accountability. However, inconsistencies appear between the values that LLMs claim to uphold (Tasks 1-3) and the way they prioritize requirements (Task 4), revealing gaps in faithfulness between stated and applied behavior. These findings highlight the practical risk of relying on LLMs in requirements engineering without human oversight and motivate the need for systematic approaches to benchmark, interpret, and monitor value alignment in AI-Assisted software development. © 2025 IEEE.},
	author_keywords = {ethics; LLM; requirements analysis; responsible AI; values},
	keywords = {Alignment; Artificial intelligence; Human engineering; Software design; Critical questions; Design and evaluations; Engineering tasks; Human judgments; Language model; Large language model; Requirement analysis; Requirements elicitation; Responsible AI; Value; Requirements engineering},
	correspondence_address = {A. Yamani; KFUPM, Information and Computer Science Department, Dhahran, Saudi Arabia; email: g201906630@kfupm.edu.sa},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833158269-2},
