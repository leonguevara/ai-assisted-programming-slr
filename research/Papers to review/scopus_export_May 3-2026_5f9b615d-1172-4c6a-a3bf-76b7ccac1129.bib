@CONFERENCE{Porta2025140,
	author = {Porta, Antonio Della and Recupito, Gilberto and Lambiase, Stefano and Di Nucci, Dario and Palomba, Fabio},
	title = {Unlocking Code Simplicity: The Role of Prompt Patterns in Managing LLM Code Complexity},
	year = {2025},
	journal = {Proceedings - 2025 IEEE International Conference on Software Analysis, Evolution and Reengineering - Companion, SANER-C 2025},
	pages = {140 - 143},
	doi = {10.1109/SANER-C66551.2025.00028},
	url = {https://www.scopus.com/pages/publications/105030541806?origin=resultslist},
	affiliations = {University of Salerno, SeSa Lab, Italy},
	abstract = {The rapid growth of generative artificial intelligence, especially Large Language Models (LLMs), has greatly influenced software engineering by automating code generation tasks. Despite the potential, challenges in code maintainability and quality persist, mainly due to prompt design. This study examines how various prompt patterns influence the complexity of Python code generated by LLMs, using the Dev-Gpt dataset. Four prompt patterns were analyzed: Zero-Shot, Few-Shot, Chain-Of-Thought, and Personas. Complexity metrics assessed include Lines of Code (LOC), Cyclomatic Complexity, and Halstead metrics, with statistical analyses conducted using the Kruskal-Wallis test and post-hoc pairwise comparisons. Results showed significant differences in LOC and related sub-metrics among these prompt patterns. Notably, the Chain-Of-Thought pattern consistently generated more concise and efficient code, offering strategies to enhance LLM-generated code quality and maintainability.  © 2025 IEEE.},
