	affiliations = {College of Computer Science and Technology, College of Artificial Intelligence, College of Software, Nanjing University of Aeronautics and Astronautics, Nanjing, China; Nanjing University of Aeronautics and Astronautics, Nanjing, China; Nantong University, Nantong, China; Monash University, Clayton, Australia; National University of Defense Technology, Changsha, China; Singapore Management University, Singapore, Singapore; Birkbeck University of London, Great Britain and Northern Ireland, London, United Kingdom},
	abstract = {The widespread use of Large Language Models (LLMs) in software engineering has intensified the need for improved model and resource efficiency. In particular, for neural code generation, LLMs are used to translate function/method signature and DocString to executable code. DocStrings, which capture user requirements for the code and are typically used as the prompt for LLMs, often contain redundant information. Recent advancements in prompt compression have shown promising results in Natural Language Processing (NLP), but their applicability to code generation remains uncertain. Our empirical study shows that the state-ofthe-art prompt compression methods achieve only about 10% reduction, as further reductions would cause significant performance degradation. In our study, we propose a novel compression method, ShortenDoc, dedicated to DocString compression for code generation. Our experiments on six code generation datasets, five open source LLMs (1B to 10B parameters), and one closed-source LLM GPT-4o confirm that ShortenDoc achieves 25–40% compression while preserving the quality of generated code, outperforming other baseline methods at similar compression levels. The benefit of this method is to improve efficiency and reduce the token processing cost while maintaining the quality of the generated code, especially when calling third-party APIs. © 2026 Copyright held by the owner/author(s). Publication rights licensed to ACM.},
	author_keywords = {Code Generation; DocString Compression; Large Language Model},
	keywords = {Arts computing; Codes (symbols); Compaction; Natural language processing systems; Open source software; Open systems; % reductions; Codegeneration; Compression methods; Docstring compression; Docstrings; Language model; Large language model; Less is mores; Model efficiency; Resource efficiencies; Efficiency},
