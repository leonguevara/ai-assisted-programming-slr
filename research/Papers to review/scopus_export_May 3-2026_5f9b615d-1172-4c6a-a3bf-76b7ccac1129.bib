@CONFERENCE{Wang20253438,
	author = {Wang, Xuan and Wang, Yingchuan and Hu, Yongxiang and Zhang, Yu and Jin, Hailiang and Guo, Shiyu and Yuan, Juxing and Zhou, Yangfan},
	title = {From Redundancy to Efficiency: Exploiting Shared UI Interactions towards Efficient LLM-Based Testing},
	year = {2025},
	journal = {Proceedings - 2025 40th IEEE/ACM International Conference on Automated Software Engineering, ASE 2025},
	pages = {3438 - 3449},
	doi = {10.1109/ASE63991.2025.00284},
	url = {https://www.scopus.com/pages/publications/105034685512?origin=resultslist},
	affiliations = {Meituan, Shanghai, China; Meituan, Beijing, China; Fudan University, College of Computer Science and Artificial Intelligence, Shanghai, China; Fudan University, Shanghai Key Laboratory of Intelligent Information Processing, Shanghai, China},
	abstract = {Redundant test cases, although well-studied in software engineering, are previously underexplored in UI testing of mobile apps. Our study of real-world test suites shows that, equipped with large-scale testing suites, redundancy in UI testing often manifests as redundant UI interactions. Although negligible in traditional script-based workflows, such redundancy severely impacts the efficiency of emerging Large Language Model (LLM)-based UI agents, which incur substantial decision latency and token costs from repeated LLM queries for the same interactions. To this end, based on the idea of reusing LLMs' former decisions, we present TestWeaver, a cost-effective LLM-based testing framework. Leveraging a semantic annotated UI Transition Graph (UTG), TestWeaver is capable of detecting shared interactions across test cases. It processes each interaction with a single LLM query, and reuses the result whenever the same interaction occurs. We evaluate TestWeaver on real-world test suites from Meituan. It achieves a 92% success rate with an average cost of $0.11 and 89.7 seconds per case, outperforming the state-of-the-art. We have also deployed TestWeaver in a real-world testing workflow at Meituan for over six months. TestWeaver has executed nearly 2,000 test cases and uncovered 10 previously undetected bugs, while reducing manual testing effort by 75%. © 2025 IEEE.},
	author_keywords = {Automatic UI Testing; Cost Optimization; Large Language Models; Mobile Apps},
	keywords = {Application programs; Automatic testing; Cost effectiveness; Cost engineering; Mobile applications; Semantics; Software testing; Well testing; Automatic UI testing; Costs Optimization; Language model; Large language model; Mobile app; Model based testing; Real-world tests; Redundant tests; Test case; Work-flows; Redundancy},
	correspondence_address = {Y. Zhou; Fudan University, College of Computer Science and Artificial Intelligence, Shanghai, China; email: zyf@fudan.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-835035733-2},
	language = {English},
