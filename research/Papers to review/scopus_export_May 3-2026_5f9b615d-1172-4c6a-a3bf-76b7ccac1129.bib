	author = {Ma, Tong and Dai, Shenlong and Gao, Yongfan and Xu, Fengjie and Fang, Ling},
	title = {A Dual-Stage Framework for Behavior-Enhanced Automated Code Generation in Industrial-Scale Meta-Models},
