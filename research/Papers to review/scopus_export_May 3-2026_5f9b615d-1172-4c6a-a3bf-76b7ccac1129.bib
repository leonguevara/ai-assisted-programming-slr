@CONFERENCE{Wang20253334,
	author = {Wang, Fanyu and Arora, Chetan and Liu, Yonghui and Huang, Kaicheng and Tantithamthavorn, Chakkrit and Aleti, Aldeida and Sambathkumar, Dishan and Lo, David},
	title = {Multi-Modal Requirements Data-based Acceptance Criteria Generation using LLMs},
	year = {2025},
	journal = {Proceedings - 2025 40th IEEE/ACM International Conference on Automated Software Engineering, ASE 2025},
	pages = {3334 - 3345},
	doi = {10.1109/ASE63991.2025.00275},
	url = {https://www.scopus.com/pages/publications/105034633999?origin=resultslist},
	affiliations = {Monash University, Faculty of Information Technology, Clayton, VIC, Australia; Monash University, ESolutions, Clayton, VIC, Australia; Singapore Management University, School of Computing and Information Systems, Singapore},
	abstract = {Acceptance criteria (ACs) play a critical role in software development by clearly defining the conditions under which a software feature satisfies stakeholder expectations. However, manually creating accurate, comprehensive, and unambiguous acceptance criteria is challenging, particularly in user interface-intensive applications, due to the reliance on domain-specific knowledge and visual context that is not always captured by textual requirements alone. To address these challenges, we propose RAGcceptance-M2RE, a novel approach that leverages Retrieval-Augmented Generation (RAG) to generate acceptance criteria from multi-modal requirements data, including both textual documentation and visual UI information. We systematically evaluated our approach in an industrial case study involving an education-focused software system used by approximately 100,000 users. The results indicate that integrating multi-modal information significantly enhances the relevance, correctness, and comprehensibility of the generated ACs. Moreover, practitioner evaluations confirm that our approach effectively reduces manual effort, captures nuanced stakeholder intent, and provides valuable criteria that domain experts may overlook, demonstrating practical utility and significant potential for industry adoption. This research underscores the potential of multi-modal RAG techniques in streamlining software validation processes and improving development efficiency. We also make our implementation and a dataset available. © 2025 IEEE.},
	author_keywords = {Acceptance Criteria; Industry Study; Multi-Modal Large Language Models; Requirements Engineering; Requirements-Driven Testing; Retrieval-Augmented Generation},
	keywords = {Acceptance tests; Computer software; Education computing; Engineering education; Information retrieval; Knowledge management; Modal analysis; Software design; User interfaces; Acceptance criteria; Condition; Industry study; Language model; Multi-modal; Multi-modal large language model; Requirement engineering; Requirement-driven; Requirement-driven testing; Retrieval-augmented generation; Requirements engineering},
