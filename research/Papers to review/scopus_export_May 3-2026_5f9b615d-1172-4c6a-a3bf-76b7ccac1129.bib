	title = {Platform-Aware RTL Generation: Bridging the Gap between Design and Implementation},
	year = {2025},
	journal = {MBMV 2025 - Methoden und Beschreibungssprachen zur Modellierung und Verifikation von Schaltungen und Systemen, 28. Workshop},
	pages = {83 - 89},
	url = {https://www.scopus.com/pages/publications/105014118794?origin=resultslist},
	affiliations = {Infineon Technologies AG, Neubiberg, Germany; Technical University of Munich, Munich, Germany; Chipglobe GmbH, Munich, Germany},
	abstract = {The gap between design and implementation has long been a bottleneck in hardware development, with Register-Transfer Level (RTL) generation often neglecting the physical implementation constraints that can make or break a design. This paper presents a novel approach to Platform-Aware RTL Generation, bridging the gap between design and implementation by incorporating platform-aware considerations into the RTL generation stage. Our approach enables the creation of implementation-aware RTL code that takes into account the physical constraints of the target platform, such as timing, power, and area. By doing so, we reduce the number of design iterations and improve the overall efficiency of the hardware development process. The key to our approach is a flexible engine that interprets platform models and modifies design models through a set of fundamental editing operations, resulting in RTL code that is tailored for the target platform. We demonstrate the effectiveness of our approach through qualitative analysis and quantitative results, showing a significant 73% reduction in code generation effort for industrial-grade designs. By bridging the gap between design and implementation, our Platform-Aware RTL Generation flow has the potential to revolutionize the hardware development process, enabling faster time-to-market, improved design quality, and reduced development costs. © VDE VERLAG GMBH ∙ Berlin ∙ Offenbach.},
	author_keywords = {Deployment Platform Constraints; Design for Test; Model Driven Architecture; Platform-Aware RTL Design; RTL generation; Safety; Technology-Specific Optimization},
	keywords = {Computational methods; Computer aided software engineering; Computer hardware; Design for testability; Hardware-software codesign; Product design; Software architecture; Software design; Deployment platform constraint; Design for test; Level design; Model driven architectures; Optimisations; Platform-aware register-transfer level design; Register-transfer level; Register-transfer level generation; Technology-specific optimization; Codes (symbols)},
