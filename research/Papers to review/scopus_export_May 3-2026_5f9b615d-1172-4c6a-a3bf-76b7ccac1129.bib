}

@CONFERENCE{Barradas-Fernandez2025,
	author = {Barradas-Fernandez, Alvaro and Sanchez-Garcia, Angel J. and Alonso-Ramirez, Oscar and Limon, Xavier},
	title = {Current Status of Cluster Analysis Application in Software Construction Activities: A Systematic Literature Review},
	year = {2025},
	journal = {2025 Mexican International Conference on Computer Science, ENC 2025},
	pages = {},
	doi = {10.1109/ENC68268.2025.11311899},
	url = {https://www.scopus.com/pages/publications/105032035905?origin=resultslist},
	affiliations = {Universidad Veracruzana, Facultad de Estadística e Informática, Xalapa, Veracruz, Mexico},
	abstract = {This paper presents a Systematic Literature Review (SLR) on the application of Cluster Analysis (CA) in software construction activities. Following the guidelines of Kitchenham and Quasigold-standard, we identified and analyzed 28 primary studies published between 2019 and 2025. The review revealed nine CA algorithms applied in this context, with K-means being the most frequently adopted for its simplicity and efficiency, followed by Hierarchical Clustering, Fuzzy C-means, and DBSCAN. The findings show that CA has been used to group code fragments, support refactoring, classify developer profiles, automate code generation, organize APIs, and detect dependencies among modules. These applications contribute to improving software quality, scalability, and maintainability. However, challenges remain in selecting the optimal number of clusters, interpreting results reliably, and generalizing across heterogeneous software systems. Overall, CA demonstrates significant potential as a complementary approach to enhance efficiency and quality in software construction, providing practical benefits for software engineers while highlighting the need for methodological guidance and further research.  © 2025 IEEE.},
