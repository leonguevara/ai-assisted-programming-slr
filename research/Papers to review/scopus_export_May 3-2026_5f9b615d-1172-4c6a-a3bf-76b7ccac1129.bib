@ARTICLE{Ginde202560955,
	author = {Ginde, Gouri and Ruhe, Guenther and Saunders, Chad},
	title = {Rethinking Technological Investment and Cost-Benefit: A Software Requirements Dependency Extraction Case Study},
	year = {2025},
	journal = {IEEE Access},
