	title = {Fine-Tuning and Evaluating Distilled DeepSeek Models for Code Reasoning},
	year = {2025},
	journal = {Proceedings - 2025 19th International Conference on Advanced Computing and Analytics, ACOMPA 2025},
	pages = {37 - 41},
	doi = {10.1109/ACOMPA69200.2025.00013},
	url = {https://www.scopus.com/pages/publications/105034132251?origin=resultslist},
	affiliations = {Thai Nguyen University of Information and Communication Technology (ICTU), Thai Nguyen, Viet Nam; Distance Learning Center, Thai Nguyen University, Thai Nguyen, Viet Nam; National Taiwan University, Taipei, Taiwan},
	abstract = {Source code reasoning is a critical aspect of software engineering, demanding language models capable of understanding, generating, and reasoning about complex program logic. This paper evaluates the effectiveness of distilled large language models (LLMs) fine-tuned for reasoning over code. We focus on three models distilled from DeepSeek-R1: two based on the Qwen architecture (with 1.5B and 7B parameters) and one based on LLaMA (8B parameters). All models were fine-tuned on the CodeAlpaca-DeepSeek-32B-Reasoning dataset, which emphasizes logical coherence in code generation and comprehension tasks. Performance was assessed using the ROUGE-L metric. The results demonstrate that the DeepSeek-Distill-Qwen-1.5B model achieved the highest ROUGE-L score at 43%, followed by the Qwen-7B model at 40%. In contrast, the LLaMA-8B model lagged significantly behind with only 10%. These findings suggest that the Qwen-based models outperform their LLaMA-based counterpart, despite having fewer parameters. The superior performance of the Qwen architecture highlights the importance of architectural compatibility and distillation strategy in enhancing reasoning capabilities for code tasks. This study provides empirical evidence that smaller, well-distilled models can rival or surpass larger models in specific domains. It suggests that optimizing architectural alignment and task-specific fine-tuning is more beneficial than merely increasing model size, especially for practical deployments requiring computational efficiency. ©2025 IEEE.},
	author_keywords = {Code reasoning; DeepSeek Distilled; Fine-tuning; LLMs; Model Reasoning},
	keywords = {Architecture; Codes (symbols); Computation theory; Distillation; Logic programming; Software engineering; Code reasoning; Complex programs; Deepseek distilled; Fine tuning; Language model; Large language model; Model reasonings; Performance; Program logic; Source codes; Computational efficiency},
