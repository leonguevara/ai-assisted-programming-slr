	title = {CoderUJB: An Executable and Unified Java Benchmark for Practical Programming Scenarios},
	year = {2024},
	journal = {ISSTA 2024 - Proceedings of the 33rd ACM SIGSOFT International Symposium on Software Testing and Analysis},
	pages = {124 - 136},
