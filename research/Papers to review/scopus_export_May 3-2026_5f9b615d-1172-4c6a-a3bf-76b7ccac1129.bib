	title = {CodeQUEST: Evaluation and Improvement of Code Quality Using LLMs},
	year = {2025},
	journal = {Proceedings - 2025 IEEE 36th International Symposium on Software Reliability Engineering Workshops, ISSREW 2025},
	pages = {123 - 130},
	doi = {10.1109/ISSREW67781.2025.00060},
	url = {https://www.scopus.com/pages/publications/105030539035?origin=resultslist},
	affiliations = {Sean Moran JPMorgan Chase},
	abstract = {This paper presents CodeQUEST, an innovative framework leveraging Large Language Models (LLMs) to iteratively assess and enhance code quality across various dimensions, adhering to software engineering best practices. CodeQUEST consists of two main components: The Evaluator, which provides quantitative scores and qualitative summaries to assess code quality, and the Optimizer, which refines the code iteratively based on Evaluator feedback. Applying CodeQUEST to a curated dataset of Python and JavaScript examples across multiple LLMs, we reveal two significant findings: CodeQUEST reliably evaluates code quality, with assessments closely matching established metrics, and the Optimizer substantially improves code quality, achieving a mean relative percentage improvement exceeding 50 %. The Evaluator's validity is supported by proxy metrics such as Pylint Score, Radon Maintainability Index, and Bandit output logs, all showing meaningful correlations. Our results, consistent across LLMs and programming languages, highlight CodeQUEST's potential to automate code quality evaluation and enhancement in the GenAI era, representing a major advancement in software development practices. The code implementation of the framework is available at https://github.com/jpmorganchase/CodeQuest.  © 2025 IEEE.},
	author_keywords = {Actor-Critic; Code Quality Improvement; LLMs; Software Engineering},
