@CONFERENCE{Diao20251784,
	author = {Diao, Xiaoxu and Vaddi, Pavan Kumar and Smidts, Carol},
	title = {Experimental Validation of the Instrumentation and Control Design Evaluation Method for Predicting and Estimating Common Cause Failures in Software Development},
	year = {2025},
