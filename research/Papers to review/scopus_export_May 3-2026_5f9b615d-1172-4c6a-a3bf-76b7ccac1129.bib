@CONFERENCE{Zhang2025609,
	author = {Zhang, Huixiang and Emu, Mahzabeen},
	title = {Quantum-Guided Test Case Minimization for LLM-Based Code Generation},
	year = {2025},
	journal = {Proceedings - 2025 IEEE International Conference on Collaborative Advances in Software and Computing, CASCON 2025},
	pages = {609 - 610},
