@ARTICLE{Alsaleh2025,
	author = {Alsaleh, Nahed and Alnanih, Reem and Alowidi, Nahed},
	title = {Enhancing Software Usability Through LLMs: A Prompting and Fine-Tuning Framework for Analyzing Negative User Feedback},
	year = {2025},
	journal = {Computers},
	volume = {14},
