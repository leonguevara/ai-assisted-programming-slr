@CONFERENCE{Wang2025178,
	author = {Wang, Taiming and Jiang, Yanjie and Dong, Chunhao and Zhang, Yuxia and Liu, Hui},
	title = {Wired for Reuse: Automating Context-Aware Code Adaptation in IDEs via LLM-Based Agent},
	year = {2025},
	journal = {Proceedings - 2025 40th IEEE/ACM International Conference on Automated Software Engineering, ASE 2025},
	pages = {178 - 190},
	doi = {10.1109/ASE63991.2025.00023},
	url = {https://www.scopus.com/pages/publications/105034693622?origin=resultslist},
	affiliations = {Beijing Institute of Technology, School of Computer Science and Technology, Beijing, 100081, China; Tianjin University, College of Intelligence and Computing, Tianjin, 300072, China},
	abstract = {Copy-paste-modify is a widespread and pragmatic practice in software development, where developers adapt reused code snippets, sourced from platforms such as Stack Overflow, GitHub, or LLM outputs, into their local codebase. A critical yet underexplored aspect of this adaptation is code wiring: the context-aware process of substituting unresolved variables in pasted code with suitable variables or expressions from the surrounding context. Existing solutions either rely on heuristic rules or historical templates, often failing to effectively utilize contextual information, despite studies showing that over half of adaptation cases are context-dependent. In this paper, we introduce WIRL, an LLM-based agent for code wiring framed as a Retrieval-Augmented Generation (RAG) infilling task. WIRL combines an LLM, a customized toolkit, and an orchestration module to identify unresolved variables, retrieve context, and perform context-aware substitutions. To balance efficiency and autonomy, the agent adopts a mixed strategy: deterministic rule-based steps for common patterns, and a state-machine-guided decision process for intelligent exploration. We evaluate WIRL on a carefully curated, high-quality dataset consisting of real-world code adaptation scenarios. Our approach achieves an exact match precision of 91.7% and a recall of 90.0%, outperforming advanced LLMs by 22.6 and 13.7 percentage points in precision and recall, respectively, and surpassing IntelliJ IDEA by 54.3 and 49.9 percentage points. These results underscore its practical utility, particularly in contexts with complex variable dependencies or multiple unresolved variables. We believe WIRL paves the way for more intelligent and context-aware developer assistance in modern IDEs. © 2025 IEEE.},
	author_keywords = {Agent; Code Adaptation; Code Reuse; Copy-paste-modify Practices; Large Language Models},
	keywords = {Computer software reusability; Copying; Intelligent agents; Software design; User interfaces; Code adaptation; Code reuse; Context aware process; Context-Aware; Copy-paste-modify practice; Language model; Large language model; Percentage points; Reuse; Stack overflow; Codes (symbols)},
	correspondence_address = {Y. Jiang; Tianjin University, College of Intelligence and Computing, Tianjin, 300072, China; email: yanjiejiang@tju.edu.cn},
