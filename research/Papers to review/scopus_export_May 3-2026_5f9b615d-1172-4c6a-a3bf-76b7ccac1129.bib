@ARTICLE{Gatchalee20254532,
	author = {Gatchalee, Pagon},
	title = {A Model-Driven and Explainable Framework for LLM-Powered Text Classification in Web Intelligence and Marketing Applications},
	year = {2025},
	journal = {Advances in Artificial Intelligence and Machine Learning},
	volume = {5},
	number = {4},
	pages = {4532 - 4552},
