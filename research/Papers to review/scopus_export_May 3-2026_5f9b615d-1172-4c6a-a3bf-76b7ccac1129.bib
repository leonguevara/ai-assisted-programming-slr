@CONFERENCE{Chen2025657,
	author = {Chen, Zhi and Jiang, Lingxiao},
	title = {Evaluating Software Development Agents: Patch Patterns, Code Quality, and Issue Complexity in Real-World GitHub Scenarios},
	year = {2025},
	journal = {Proceedings - 2025 IEEE International Conference on Software Analysis, Evolution and Reengineering, SANER 2025},
	pages = {657 - 668},
	doi = {10.1109/SANER64311.2025.00068},
	url = {https://www.scopus.com/pages/publications/105007302779?origin=resultslist},
	affiliations = {School of Computing and Information Systems, Singapore Management University, Centre for Research on Intelligent Software Engineering, Singapore},
	abstract = {In recent years, AI-based software engineering has progressed from pre-trained models to advanced agentic workflows, with Software Development Agents representing the next major leap. These agents, capable of reasoning, planning, and interacting with external environments, offer promising solutions to complex software engineering tasks. However, while much research has evaluated code generated by large language models (LLMs), comprehensive studies on agent-generated patches, particularly in real-world settings, are lacking. This study addresses that gap by evaluating 4,892 patches from 10 top-ranked agents on 500 real-world GitHub issues from SWE-Bench Verified, focusing on their impact on code quality. Our analysis shows no single agent dominated, with 170 issues unresolved, indicating room for improvement. Even for patches that passed unit tests and resolved issues, agents made different file and function modifications compared to the gold patches from repository developers, revealing limitations in the benchmark's test case coverage. Most agents maintained code reliability and security, avoiding new bugs or vulnerabilities; while some agents increased code complexity, many reduced code duplication and minimized code smells. Finally, agents performed better on simpler codebases, suggesting that breaking complex tasks into smaller sub-tasks could improve effectiveness. This study provides the first comprehensive evaluation of agent-generated patches on real-world GitHub issues, offering insights to advance AI-driven software development.  © 2025 IEEE.},
	author_keywords = {Code Quality; GitHub Issues; Large Language Models; Patch Generation; Software Development Agents},
	keywords = {Application programs; Computer operating systems; Computer software maintenance; Computer software selection and evaluation; Groupware; Intelligent agents; Mobile agents; Open source software; Software design; Software packages; Software prototyping; Software quality; Software reliability; Software testing; Subroutines; Verification; Code quality; Evaluating software; Github issue; Language model; Large language model; Patch generation; Patch patterns; Pattern code; Real-world; Software development agent; Autonomous agents},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833153510-0},
	language = {English},
	abbrev_source_title = {Proc. - IEEE Int. Conf. Softw. Anal., Evol. Reengineering, SANER},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@CONFERENCE{Buckley2025338,
	author = {Buckley, Sarah and Razzaq, Abdul and English, Michael},
	title = {A Preliminary Assessment of SLR's Reliance on Preprints, in the Area of LLMs4SE},
	year = {2025},
	journal = {International Symposium on Empirical Software Engineering and Measurement},
	pages = {338 - 343},
	doi = {10.1109/ESEM64174.2025.00043},
	url = {https://www.scopus.com/pages/publications/105032665383?origin=resultslist},
	affiliations = {University of Limerick, Computer Science and Information Systems, Ireland},
	abstract = {Background: Systematic Literature Reviews (SLRs) and Mapping Studies (MSs) are established features of academic Software Engineering literature. But for new, exciting areas in the field, there exists a tension between supporting fellow academics, with reviews that provide a timely synthesis of the available evidence, and the maturity of the literature relied on. Aims: The increasingly prevalent use of preprint databases like arXiv, for immediate publication of results, suggests that this tension deserves evaluation. Hence, this paper evaluates preprint reliance for SLRs/MSs in the rapidly developing area of LLMs4SE: Large Language Models for Software Engineering. Method: The paper analyses surveys on LLMs4SE, identifying the proportion of arXiv preprints that the surveys employ, the additional quality assurance measures applied to the preprints, and tracing the assertions made in the surveys to the preprints' subsequent peer-reviewed articles for consistency. Results: Our initial review found a small number of surveys, congruent with LLMs recent growth in software engineering. The reviews that exist rely on a significant proportion of pre-prints, and meaningful quality criteria are rarely applied to mitigate against this. We note that although a significant proportion of the preprints are subsequently published in peer-reviewed fora, a significant number are not. In cases where the preprints have been subsequently published in peer-reviewed fora, consistency between the assertions made in the review and the peer-reviewed article is relatively high, but not absolute. Conclusions: Our results suggest that increased quality criteria should be applied to the preprints employed and consistency checking between preprints and surveys should be heightened. © 2025 IEEE.},
	author_keywords = {LLMs; Pre-Prints; SLRs; Software Engineering},
	keywords = {Distributed computer systems; Quality assurance; Quality control; Assurance measures; Consistency checking; Language model; LLM; Mapping studies; Paper analysis; Pre-print; Preliminary assessment; Quality criteria; Systematic literature review; Software engineering},
	publisher = {IEEE Computer Society},
