@CONFERENCE{Kansab2025577,
	author = {Kansab, Samah and Bordeleau, Francis and Tizghadam, Ali},
	title = {RevMine: An LLM-Assisted Tool for Code Review Mining and Analysis Across Git Platforms},
	year = {2025},
	journal = {Proceedings - 2025 IEEE International Conference on Collaborative Advances in Software and Computing, CASCON 2025},
	pages = {577 - 578},
