	author = {Pornmaneerattanatri, Soratouch and Takahashi, Keichi and Kashiwa, Yutaro and Ichikawa, Kohei and Iida, Hajimu},
	title = {Automatic Parallelization with CodeT5+: A Model for Generating OpenMP Directives},
	year = {2024},
	journal = {Proceedings - 2024 IEEE International Conference on Cluster Computing Workshops, CLUSTER Workshops 2024},
	pages = {127 - 135},
	doi = {10.1109/CLUSTERWorkshops61563.2024.00028},
