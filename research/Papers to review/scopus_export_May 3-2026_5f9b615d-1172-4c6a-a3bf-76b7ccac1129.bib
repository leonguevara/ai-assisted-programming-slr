@CONFERENCE{Ashraf2025606,
	author = {Ashraf, Humza and Danish, Syed Muhammad and Rahman, Shadikur and Sattar, Zeeshan},
	title = {Toward Green Code: Prompting Small Language Models for Energy-Efficient Code Generation},
	year = {2025},
	journal = {2025 3rd International Conference on Foundation and Large Language Models, FLLM 2025},
	pages = {606 - 612},
	doi = {10.1109/FLLM67465.2025.11391183},
	url = {https://www.scopus.com/pages/publications/105035830165?origin=resultslist},
	affiliations = {Algoma University, Brampton, Canada; Ericsson Inc, Ottawa, Canada},
	abstract = {There is a growing concern about the environmental impact of large language models (LLMs) in software development, particularly due to their high energy use and carbon footprint. Small Language Models (SLMs) offer a more sustainable alternative, requiring fewer computational resources while remaining effective for fundamental programming tasks. In this study, we investigate whether prompt engineering can improve the energy efficiency of SLMs in code generation. We evaluate four open-source SLMs, StableCode-Instruct-3B, Qwen2.5-Coder-3B-Instruct, CodeLlama-7B-Instruct, and Phi-3-Mini-4K-Instruct, across 150 Python problems from LeetCode, evenly distributed into easy, medium, and hard categories. Each model is tested under four prompting strategies: role prompting, zero-shot, few-shot, and chain-of-thought (CoT). For every generated solution, we measure runtime, memory usage, and energy consumption, comparing the results with a human-written baseline. Our findings show that CoT prompting provides consistent energy savings for Qwen2.5-Coder and StableCode-3B, while CodeLlama-7B and Phi-3-Mini-4K fail to outperform the baseline under any prompting strategy. These results highlight that the benefits of prompting are model-dependent and that carefully designed prompts can guide SLMs toward greener software development. © 2025 IEEE.},
	author_keywords = {Code Generation; Performance Evaluation; Prompt Engineering; Small Language Models; Sustainability},
	keywords = {Codes (symbols); Energy efficiency; Energy utilization; Environmental impact; Open source software; Open systems; Software design; Codegeneration; Computational resources; Energy; Energy efficient codes; Energy use; Language model; Performances evaluation; Programming tasks; Prompt engineering; Small language model; Sustainable development},
	correspondence_address = {H. Ashraf; Algoma University, Brampton, Canada; email: hashraf@algomau.ca},
	editor = {Erenli K. and Guetl C. and Jararweh Y. and Jansen J.},
