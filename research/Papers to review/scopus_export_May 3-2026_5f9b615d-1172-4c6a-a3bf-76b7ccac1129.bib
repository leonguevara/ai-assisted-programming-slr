@CONFERENCE{Bhogavalli2025191,
	author = {Bhogavalli, Srinivas and Sonani, Raj and Goel, Nayan and Velugubantla, Venkatesh and Panchal, Ayush},
	title = {ArchCrafter: Leveraging LLMs to Scan and Interpretable Software Architecture Flaws},
	year = {2025},
	journal = {2025 IEEE 16th Annual Information Technology, Electronics and Mobile Communication Conference, IEMCON 2025},
	pages = {191 - 197},
	doi = {10.1109/IEMCON67450.2025.11381148},
	url = {https://www.scopus.com/pages/publications/105034712163?origin=resultslist},
	affiliations = {MSR Technology Group, TX, United States; Cornell University, NY, United States; Upgrade Inc, CA, United States; Meridian Cooperative, Atlanta, United States; TX, United States},
	abstract = {Hidden architectural flaws such as tight coupling, dependency bloat, and tangled module interactions can silently erode scalability and maintainability until problems become critical. In this paper, we introduce ArchCrafter, an interactive framework powered by large language models (LLMs) that detects architectural issues in real time and supports teams in designing more resilient systems. At its center, CraftCore integrates transformer-based language understanding with dynamic graph neural networks to analyze codebases and UML diagrams, pinpointing structural risks as they emerge. The FlawMesh component then maps these risks onto intuitive module graphs. Complementary modules include the DesignSync Forecaster for predictive insights, the TeamAlign Annotator for collaborative feedback, the RefactorGuide Assistant (enhanced by SHAP and LIME) for actionable recommendations, and the FlawHeat Visualizer for highlighting high-risk regions. Evaluated on 500 open-source repositories and the ArchBench dataset, ArchCrafter achieved 90% detection accuracy, 85% prioritization precision, and improved performance by 30% on a banking-system prototype. By integrating seamlessly with Git, CI/CD pipelines, and UML editors, ArchCrafter enhances both code quality and developer trust, with 90% of users reporting positive experiences. We conclude with insights from real-world deployment and outline directions for multimodal, explainable architectural analysis. © 2025 IEEE.},
	author_keywords = {AI for software engineering; GenAI; LLMs},
	keywords = {Arches; Architecture; Distributed computer systems; Human computer interaction; Open source software; Open systems; Software architecture; User experience; AI for software engineering; Dynamic graph; GenAI; Graph neural networks; Language model; Language understanding; Large language model; Real- time; Resilient systems; Tight coupling; Real time systems},
