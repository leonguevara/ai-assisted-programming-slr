@CONFERENCE{Zhang202523268,
	author = {Zhang, Xiaoqing and Liu, Yuhan and Sung, Flood and Chen, Xiuying and Shang, Shuo and Yan, Rui},
	title = {Thinking Before Running! Efficient Code Generation with Thorough Exploration and Optimal Refinement},
	year = {2025},
	journal = {Proceedings of the Annual Meeting of the Association for Computational Linguistics},
	pages = {23268 - 23281},
	doi = {10.18653/v1/2025.findings-acl.1195},
	url = {https://www.scopus.com/pages/publications/105028601945?origin=resultslist},
	affiliations = {Gaoling School of Artificial Intelligence, Renmin University of China, China; Moonshot AI; Mohamed bin Zayed University of Artificial Intelligence, United Arab Emirates; University of Electronic Science and Technology of China, China; School of Artificial Intelligence, Wuhan University, China; Engineering Research Center of Next-Generation Intelligent Search and Recommendation, MoE, China},
	abstract = {Code generation is crucial in software engineering for automating the coding process efficiently. While test-time computation methods show promise, they suffer from high latency due to multiple computation rounds. To overcome this, we introduce ThinkCoder, a framework that combines thorough exploration with optimal refinement. The exploration phase diversifies the solution space by searching for potential solutions, followed by a refinement phase that enhances precision. This approach allows us to select the best solution through careful consideration before taking action, avoiding excessive trial and error. To further minimize test-time computation overhead, we introduce preference-driven optimization with Reinforced Self-Training (ReST), which uses exploration trajectories from ThinkCoder to guide LLM's evolution. This approach enhances LLM's exploration efficiency via preference learning, cutting costs while maintaining accuracy. ThinkCoder boosts the performance with a single LLM, excelling on benchmarks like HumanEval and MBPP. Compared to SOTA models, it improves Pass@1 by 3.0% over MapCoder with just 6.4% of the computation cost. Against AgentCoder, ThinkCoder achieves a 0.5% higher Pass@1 after 2 rounds, outperforming AgentCoder's 5 rounds. Additionally, ReST with success trajectories enhances efficiency, allowing models like LLaMA2-7B to achieve competitive results using only 20% of the computational resources. These results highlight the framework's effectiveness and scalability. © 2025 Association for Computational Linguistics.},
	keywords = {Codes (symbols); Computational efficiency; Computational linguistics; Computer programming; Optimal systems; Optimization; Program compilers; Signal encoding; Codegeneration; Coding process; Computation methods; Computation overheads; Exploration phasis; Refinement phase; Self-training; Solution space; Test time; Trial and error; Benchmarking},
	correspondence_address = {Y. Liu; Gaoling School of Artificial Intelligence, Renmin University of China, China; email: yuhan.liu@ruc.edu.cn; R. Yan; Gaoling School of Artificial Intelligence, Renmin University of China, China; email: ruiyan@ruc.edu.cn},
	editor = {Che W. and Nabende J. and Shutova E. and Pilehvar M.T.},
