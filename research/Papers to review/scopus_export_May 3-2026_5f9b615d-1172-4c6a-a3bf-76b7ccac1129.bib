	title = {Federated Retrieval-Augmented Generation: A Systematic Mapping Study},
	year = {2025},
	journal = {EMNLP 2025 - 2025 Conference on Empirical Methods in Natural Language Processing, Findings of EMNLP 2025},
	pages = {7362 - 7374},
	doi = {10.18653/v1/2025.findings-emnlp.388},
