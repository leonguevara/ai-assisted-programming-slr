	title = {Role-Aware Intelligent Agent Framework for Enhanced Code Generation Using Large Language Model},
	year = {2025},
	journal = {International Conference on Communication, Computer and Information Technology, IC3IT 2025},
	pages = {},
	doi = {10.1109/IC3IT66137.2025.11341145},
