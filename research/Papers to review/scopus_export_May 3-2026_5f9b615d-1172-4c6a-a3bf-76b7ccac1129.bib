	year = {2025},
	journal = {2025 3rd International Conference on Software Engineering and Information Technology, ICoSEIT 2025},
	pages = {},
	doi = {10.1109/ICoSEIT67010.2025.11290782},
	url = {https://www.scopus.com/pages/publications/105031609361?origin=resultslist},
	affiliations = {Telkom University, School of Computing, Bandung, Indonesia},
	abstract = {Test case generation is an essential component in the software testing lifecycle. Despite its importance, generating test cases automatically using Large Language Models such as GPT remains a challenging task. One of the most persistent issues observed is the inconsistency of generated outputs in terms of format, structure, and quantity, even when the input requirements are highly similar. Such inconsistencies reduce reliability, increase the need for human intervention, and limit the applicability of LLMs in real-world Quality Assurance practices. To address this limitation, this paper introduces a method aimed at enhancing the consistency of generated test cases by improving the model's comprehension of requirements through a continual domain-adaptive pretraining approach. In this method, the GPT model is continually trained on functional requirements collected from a hospital management system, which are preprocessed using Natural Language Processing techniques to minimize ambiguity, normalize linguistic variations, and capture domain-specific patterns that reinforce contextual understanding. The performance of the pretrained model is then systematically compared with the baseline ChatGPT model using three evaluation metrics. Experimental results demonstrate that the proposed model achieves 100% requirement coverage, records a significantly higher Jaccard similarity score of 0.78, and consistently generates executable test cases with a stable structure that aligns with best practices in software testing. These findings highlight the effectiveness of continual pretraining in improving requirement comprehension, reducing variability in generated outputs, and ultimately contributing to the development of more reliable, consistent, and scalable automated software testing workflows.  © 2025 IEEE.},
	author_keywords = {continual pretraining; hospital information system; jaccard similarity; NLP; selenium testing; software testing automation; test case generation},
	keywords = {Automatic test pattern generation; Automation; Biomedical engineering; Computer aided software engineering; Hospitals; Life cycle; Management information systems; Medical computing; Model checking; Natural language processing systems; Software testing; Continual pretraining; Hospital information systems; Jaccard similarity; Pre-training; Selenia testing; Software testing automation; Software testings; Test case; Test case generation; Testing automation; Quality assurance},
