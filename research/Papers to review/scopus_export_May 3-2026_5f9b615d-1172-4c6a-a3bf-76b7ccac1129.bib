@CONFERENCE{Arya20251082,
	author = {Arya and Thushara, M.G.},
	title = {Information Retrieval From Software Specifications Using Hybrid Semantic and Syntactic Analysis},
	year = {2025},
	journal = {Proceedings of the 9th International Conference on Inventive Systems and Control, ICISC 2025},
	pages = {1082 - 1088},
	doi = {10.1109/ICISC65841.2025.11188038},
	url = {https://www.scopus.com/pages/publications/105020972811?origin=resultslist},
	affiliations = {Department of Mathematics, Amrita School of Physical Sciences, Amrita Vishwa Vidyapeetham, Kerala, Amritapuri, India; Department of Computer Science and Applications, Amrita School of Computing, Amrita Vishwa Vidyapeetham, Kerala, Amritapuri, India},
	abstract = {Software specifications are crucial in the development and maintenance of systems. These documents are often lengthy, complex, and written in natural language, making it challenging for engineers to efficiently extract relevant information. This study aims to extract entities and their relations from software specification text across multiple domains, using a rule-based approach combined with syntactic parsing tools like spaCy. These entities and relations are then used to generate entity-relation triplets, hence forming a structured representation of the unstructured text. Semantic search is then performed by generating word embeddings of the user queries and the extracted triplets to identify the most relevant triplets and generate contextually accurate answers for the queries. A comparative evaluation of transformer-based models is conducted. Based on the evaluation metrics, SBERT showed better results with 46.7 % precision and 89.8 % recall compared to other large language models (LLMs). High accuracy indicates that the model encodes sentences into fixed size embeddings accurately and hence provides better results for semantic search. By integrating entity relation triplets from rule-based approach with semantic embeddings from LLMs, the hybrid approach provides a robust framework for enhanced information retrieval, enabling accurate, context-aware answers and facilitating informed decision-making in software development processes. © 2025 IEEE.},
	author_keywords = {entity-relation extraction; information retrieval; large language models; natural language processing; rulebased approach; SBERT; semantic search; software specifications; spaCy; syntactic parsing},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833151247-7},
	language = {English},
	abbrev_source_title = {Proc. Int. Conf. Inventive Syst. Control, ICISC},
	type = {Conference paper},
	publication_stage = {Final},
