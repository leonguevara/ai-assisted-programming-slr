	year = {2024},
	journal = {ICECOS 2024 - 4th International Conference on Electrical Engineering and Computer Science, Proceeding},
	pages = {391 - 398},
	doi = {10.1109/ICECOS63900.2024.10791206},
	url = {https://www.scopus.com/pages/publications/85215279850?origin=resultslist},
	affiliations = {Gadjah Mada University, Department of Electrical Engineering and Information Technology, Yogyakarta, Indonesia},
	abstract = {Software effort estimation (SEE) in Agile Software Development (ASD) has been a longstanding challenge for software engineers. The traditional approach estimates effort scores known as Story Point (SP) to measure user stories. The approach was an expert judgment method in which experts propose certain values of story points based on their experience through various mechanisms such as planning poker, Dot Voting, Bucket System, etc. The process will become challenging if experts have different opinions about the value of certain story points, which may result in a longer duration for completion. Many algorithms have been proposed to optimize the method. The utilization of Artificial Intelligence (AI) and Machine Learning (ML) has greatly simplified processes. Various algorithms are utilized, including Fuzzy, SVM, Naive Bayes, KNN, ANN, RNN, CNN, and LSTM, and utilizing Large Language Models (LLMs) for advancement. This paper employs the hybrid model of Bidirectional Encoder Representations from Transformers (BERT) - Multilayer Perceptron (MLP), which we call alterBERT, to perform regression for estimating Story Points (SP). We will assess the model over the TAWOS dataset and compare it with the previous model, GPT2SP, and other GPT2 architecture. The dataset consists of issues from 39 open-source projects mined from JIRA Software. According to the experimental result, we conclude that the alterBERT models have better performance, outperforming the other models with an average MAE and RMSE, respectively, about 1.72 and 2.51. © 2024 IEEE.},
	author_keywords = {Agile Software Development; Artificial Intelligence; effort estimation; Large Language Model; Machine Learning; Story Point},
	keywords = {Adversarial machine learning; Computer software selection and evaluation; Problem oriented languages; Agile software development; Effort Estimation; Estimation problem; Language model; Large language model; Machine-learning; Point estimation; Software effort estimation; Story point; Traditional approachs; Open source software},
