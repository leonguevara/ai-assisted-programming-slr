@ARTICLE{Liu20241675,
	author = {Liu, Changshu and Cetin, Pelin and Patodia, Yogesh and Ray, Baishakhi and Chakraborty, Saikat and Ding, Yangruibo},
	title = {Automated Code Editing with Search-Generate-Modify},
	year = {2024},
	journal = {IEEE Transactions on Software Engineering},
	volume = {50},
	number = {7},
	pages = {1675 - 1686},
	doi = {10.1109/TSE.2024.3376387},
	url = {https://www.scopus.com/pages/publications/85189301152?origin=resultslist},
	affiliations = {Columbia University, Department of Computer Science, New York, 10027, NY, United States; Microsoft Research, Redmond, 98052, WA, United States},
	abstract = {Code editing is essential in evolving software development. In literature, several automated code editing tools are proposed, which leverage Information Retrieval-based techniques and Machine Learning-based code generation and code editing models. Each technique comes with its own promises and perils, and for this reason, they are often used together to complement their strengths and compensate for their weaknesses. This paper proposes a hybrid approach to better synthesize code edits by leveraging the power of code search, generation, and modification. Our key observation is that a patch that is obtained by search & retrieval, even if incorrect, can provide helpful guidance to a code generation model. However, a retrieval-guided patch produced by a code generation model can still be a few tokens off from the intended patch. Such generated patches can be slightly modified to create the intended patches. We developed a novel tool to solve this challenge: SarGaM, which is designed to follow a real developer's code editing behavior. Given an original code version, the developer may search for the related patches, generate or write the code, and then modify the generated code to adapt it to the right context. Our evaluation of SarGaM on edit generation shows superior performance w.r.t. the current state-of-the-art techniques. SarGaM also shows its effectiveness on automated program repair tasks. © 2024 IEEE.},
	author_keywords = {automated program repair; Bug fixing; edit-based neural network},
	keywords = {Automation; Codes (symbols); Job analysis; Learning systems; Network coding; Personnel training; Software design; Automated program repair; Bug-fixing; Code; Codegeneration; Context models; Decoding; Editbased neural network; Neural-networks; Task analysis; Transformer; Repair},
	correspondence_address = {C. Liu; Columbia University, Department of Computer Science, New York, 10027, United States; email: cl4062@cs.columbia.edu},
