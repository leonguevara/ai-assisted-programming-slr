	year = {2025},
	journal = {Learning and Analytics in Intelligent Systems},
	volume = {52},
	pages = {1 - 57},
	doi = {10.1007/978-3-031-98410-5_1},
	url = {https://www.scopus.com/pages/publications/105017972670?origin=resultslist},
	affiliations = {Software Engineering Lab, Department of Informatics, University of Piraeus, Piraeus, Greece; Pattern Recognition, Machine Learning and Multimedia Lab, Department of Informatics, University of Piraeus, Piraeus, Greece; Tsurumi University, Yokohama, Japan},
	abstract = {The Joint Conference on Knowledge-Based Software Engineering (JCKBSE) celebrates 30 years as a highly scientific forum dedicated to advancing research in knowledge-based software engineering. This chapter reviews the significant contributions made over three decades and examines the emerging need to rename the conference as the International Conference on Artificial Intelligence-Empowered Software Engineering (AIESE2024). JCKBSE has promoted research in requirements analysis, software development, and software quality attributes, including efficiency, robustness, and reliability. As artificial intelligence, particularly machine learning, generative AI, and intelligent automation, plays an increasing role in software engineering, the transition to AIESE2024 reflects the expansion of its scope beyond traditional knowledge-based techniques. To illustrate this shift, this chapter provides a retrospective review of research contributions presented at JCKBSE, analyzing the evolution of methodologies, tools, and frameworks that have shaped the discipline. By examining published works from JCKBSE and related venues, it discusses advancements in knowledge representation, intelligent decision-making, and software engineering automation, along with their impact on software design, verification, and maintenance. Additionally, the review highlights the growing significance of emerging software qualities, such as reliability, transparency, explainability, and trustworthiness, which are becoming essential as AI-driven methods become more integrated into software development. By tracing research progress over the past 30 years and showing ongoing trends, this chapter illustrates how AI-driven advancements are forming the future of AI-empowered software engineering. It reinforces the need for a broader and more inclusive perspective, positioning the conference as a dynamic forum that embraces emerging advancements while continuing to promote research and innovation in the evolving field of AI-driven software engineering. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	author_keywords = {AI-Empowered Software Engineering; Artificial Intelligence; ChatGPT; e-Learning; Energy and AI; Generative AI; Knowledge-Based Software Engineering; Large Language Models; Machine Learning; Medical AI; Software Engineering; User Modelling},
	keywords = {Automation; Behavioral research; Computer aided software engineering; Computer software maintenance; Computer software selection and evaluation; Engineering education; Engineering research; Knowledge representation; Learning systems; Machine learning; Software design; Software quality; Software reliability; Verification; AI-empowered software engineering; ChatGPT; E - learning; Energy; Energy and AI; Generative AI; Knowledge-based software engineering; Knowledge-based softwares; Language model; Large language model; Machine-learning; Medical AI; User Modelling; E-learning},
