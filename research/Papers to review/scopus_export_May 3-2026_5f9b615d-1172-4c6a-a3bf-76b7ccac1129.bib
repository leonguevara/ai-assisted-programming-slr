@CONFERENCE{Magfira202560,
	author = {Magfira, Fortia and Irawan, Feri and Harahap, Basyaruddin Ismail},
	title = {An Empirical Study of Generative AI for CRUD Code: A PHP Case with Tutorial Based Novice Baselines},
	year = {2025},
	journal = {Proceedings of 2025 IEEE International Conference on Data and Software Engineering, ICoDSE 2025},
	pages = {60 - 65},
