@CONFERENCE{Nair2025,
	author = {Nair, Reshma P and Thushara, M.G.},
	title = {NL2Code: A Hybrid NLP and Model-Driven Framework for Automated Code Generation from Natural Language and UML},
	year = {2025},
	journal = {2025 IEEE International Students' Conference on Electrical, Electronics and Computer Science, SCEECS 2025},
