	keywords = {Codes (symbols); Energy efficiency; Energy utilization; Open source software; Open systems; Optimal systems; Power management; Software design; Sustainable development; Codegeneration; Early exit; Green AI; Language model; Language processing; Large language model; Model inference; Natural languages; Pruning; Sustainable AI; Economic and social effects},
