@ARTICLE{Reiche2025448,
	author = {Reiche, Michael and Leidner, Jochen L.},
	title = {Welcome to the Team: Chat Agents for Machine Learning Project Management Support},
	year = {2025},
	journal = {Lecture Notes in Networks and Systems},
	volume = {1567 LNNS},
	pages = {448 - 469},
	doi = {10.1007/978-3-032-00071-2_28},
	url = {https://www.scopus.com/pages/publications/105014331107?origin=resultslist},
	affiliations = {Center for Responsible Artificial Intelligence Research (CRAI), Coburg University of Applied Sciences, Friedrich-Streib-Str. 2, Coburg, 96450, Germany; University of Sheffield, Regents Court, 211 Portobello, Sheffield, S1 4DP, United Kingdom},
	abstract = {Planning and managing projects, especially those involving machine learning (ML), can be challenging without clear guidance. To address this, various general and specialized ML methodologies have been developed. However, people are still needed to follow these methods: junior team members might not know what to do or in what order, while senior members, though experienced, may skip steps under stress. To make project planning and execution of ML projects more systematic and reliable, we created an automatic interactive chat agent by applying Retrieval-Augmented Generation (RAG) to a state-of-the-art foundational large language model (LLM). This chat agent acts like a “virtual team member”, answering questions about projects and/or a chosen ML methodology, and actioning some limited delegated tasks. We also describe MLProjBench, a novel dataset of independently created questions and model answers, intended to serve as a benchmark for future similar tools aimed at this novel task, and evaluated our chat agent using it. We assess a combination of background documents via RAG to model answers, and we also compare the outputs of different model variants. Our results show that a pre-trained LLM based on neural transformers, equipped with a methodology manual for additional background knowledge via a RAG regime can provide valuable assistance. Among a set of six chat agent variants automatically evaluated against a set of human-authored model answers, the variant that uses MANDALA.ML performed best in our automatic evaluation. We also introduce a new evaluation metric, ωLP-ROUGE to avoid possible metric gaming that ROUGE suffers from. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	author_keywords = {Intelligent assistants; Large language models; Machine learning applications; Machine learning project management; Methodology; Natural language chat; Natural language processing; Retrieval-augmented generation; Software agents; Software tools; Workflow},
	keywords = {Application programs; Behavioral research; Computational linguistics; Computer aided software engineering; Human computer interaction; Human resource management; Information retrieval; Intelligent agents; Learning algorithms; Learning systems; Machine learning; Natural language processing systems; Virtual reality; Intelligent assistants; Language model; Language processing; Large language model; Learning projects; Machine learning applications; Machine learning project management; Machine-learning; Methodology; Natural language chat; Natural language processing; Natural languages; Retrieval-augmented generation; Software-tools; Work-flows; Project management},
