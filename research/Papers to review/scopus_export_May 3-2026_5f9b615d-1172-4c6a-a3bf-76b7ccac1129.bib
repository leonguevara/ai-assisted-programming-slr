@CONFERENCE{Pilone2025870,
	author = {Pilone, Arthur},
	title = {Ensuring Code Integrity in the Era of AI-Assisted Software Development},
	year = {2025},
	journal = {Proceedings - 2025 IEEE International Conference on Software Maintenance and Evolution, ICSME 2025},
	pages = {870 - 872},
