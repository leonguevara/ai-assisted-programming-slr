@CONFERENCE{Kan2025540,
	author = {Kan, Xuan and Dai, Yu and Shi, Jiancheng},
	title = {ABCM: Agent-Based Complexity Management Method for Intelligent Manufacturing},
	year = {2025},
	journal = {Proceedings of the 2025 5th International Conference on Automation Control, Algorithm and Intelligent Bionics, ACAIB 2025},
	pages = {540 - 546},
	doi = {10.1145/3760269.3760353},
	url = {https://www.scopus.com/pages/publications/105021331646?origin=resultslist},
	affiliations = {Sichuan University, Sichuan, Chengdu, China; Southwest China Research Institute of Electronic Equipment, Sichuan, Chengdu, China},
	abstract = {Modern intelligent manufacturing systems are inherently complex, driven by product variety, dynamic scheduling, and intricate interactions among humans, machines, and materials. This complexity presents significant challenges for production planning, control, and decision-making. To address these issues, we propose ABCM (Agent-Based Complexity Management), a novel method that integrates system dynamics simulation with a large language model (LLM)-based agent framework. ABCM utilizes PySD to simulate manufacturing processes and extract structured model outputs, which are analyzed through a suite of modular tools registered within a LangChain agent. These tools enable the computation of descriptive statistics, dynamic performance indicators, and complexity metrics—including entropy, rise time, overshoot, and integral errors—thus allowing for automated, data-driven complexity assessment. The agent autonomously interprets simulation results, identifies performance bottlenecks, and offers optimization recommendations. A case study demonstrates the practical application of ABCM in managing production variability and enhancing system responsiveness. The modular and extensible architecture supports scalable deployment in diverse intelligent manufacturing scenarios, contributing to improved adaptability, efficiency, and complexity control. © 2025 Copyright held by the owner/author(s).},
