	keywords = {Advanced Analytics; Economic and social effects; Economics; File editors; History; Population dynamics; Search engines; Social psychology; Social software; Behavioral science; Design science; Empirical Software Engineering; Grounded theory; Qualitative data; Qualitative Data Analysis (QDA); Qualitative research; Social computing; Sociotechnical; Theory development; Emotional intelligence; Social behavior},
	publisher = {Springer International Publishing},
