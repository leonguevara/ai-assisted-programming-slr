@CONFERENCE{Tripathi2025723,
	author = {Tripathi, Yash and Kohli, Vijayent and Misra, Shriya},
	title = {Confident but Incorrect: Mitigating Hallucination and Overconfidence in Agentic AI Coders},
	year = {2025},
	journal = {Proceedings of the IEEE International Conference Image Information Processing},
	pages = {723 - 728},
	doi = {10.1109/ICIIP68302.2025.11346318},
	url = {https://www.scopus.com/pages/publications/105033232943?origin=resultslist},
	affiliations = {Interviewbit Technologies Private Limited, Bengaluru, India; Ford Motor Company, Dearborn, MI, United States; Dell Technologies, Austin, TX, United States},
	abstract = {Agentic AI capable of independent software development is transforming productivity in engineering. But their increasing independence brings up important dependability issues that require careful thought. These systems typically produce code that seems technically sound at first glance but has underlying logical or functional errors; this issue is called hallucination. The problem worsens and there are fewer opportunities for human review or confirmation when such erroneous outputs are given excessive confidence. The study presented here claims that the systematic cause of these shortcomings is training approaches in big language models that emphasize reinforcement learning based on human feedback and aimed at terminal outcomes. Such methods, which prioritize seeming plausibility over substantive truth and encourage stylistic coherence at the expense of rigorous reasoning, jeopardize the software architectures' ongoing resilience. To counter this, a different training strategy is advised. The primary change, referred to as reinforcement learning from process supervision, causes supervisors to focus on intermediate reasoning paths rather than terminal products. This alignment includes tried-and-true engineering techniques that place a high value on sequential verification and clear justification articulation. A subsequent improvement includes formal verification and uncertainty estimates in the generative pipeline, which allows models to detect and signal epistemic constraints in code synthesis. These interventions are supported by empirical evaluations: on a defined benchmark group, the pass-at-one accuracy measure improved by 14 percentage points compared to the baseline, and the ROC curve area increased from 0.68 to 0.78, indicating improved failure anticipation efficacy. These results provide a viable path for agentic AI to participate in programming tasks as trustworthy, reflective partners, instead of assertive but faulty assistants. © 2025 IEEE.},
	author_keywords = {agentic AI; code generation; formal verification; hallucination; large language models; process supervision; reinforcement learning; software reliability; uncertainty quantification},
	keywords = {Codes (symbols); Computational methods; Personnel training; Software design; Uncertainty analysis; Agentic AI; Codegeneration; Dependability issues; Hallucination; Language model; Large language model; Process supervision; Reinforcement learnings; Software-Reliability; Uncertainty quantifications; Formal verification; Software reliability},
	correspondence_address = {Y. Tripathi; Interviewbit Technologies Private Limited, Bengaluru, India; email: tripathiyash1004@gmail.com},
	editor = {Jakhar A.K. and Kumar A. and Sehgal V.K.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
