}

@CONFERENCE{Mao2025897,
	author = {Mao, Zhenyu and Keung, Jacky and Zhang, Fengji and Liu, Shuo and Wang, Yifei and Li, Jialong},
	title = {Towards Engineering Multi-Agent LLMs: A Protocol-Driven Approach},
	year = {2025},
	journal = {Proceedings - Asia-Pacific Software Engineering Conference, APSEC},
	pages = {897 - 901},
	doi = {10.1109/APSEC66846.2025.00100},
	url = {https://www.scopus.com/pages/publications/105035214345?origin=resultslist},
	affiliations = {City University of Hong Kong, Hong Kong, Hong Kong; Waseda University, Tokyo, Japan},
	abstract = {The increasing demand for software development has driven interest in automating software engineering (SE) tasks using Large Language Models (LLMs). Recent efforts extend LLMs into multi-agent systems (MAS) that emulate collaborative development workflows, but these systems often fail due to three core deficiencies: under-specification, coordination misalignment, and inappropriate verification, arising from the absence of foundational SE structuring principles. This paper introduces Software Engineering Multi-Agent Protocol (SEMAP), a protocol-layer methodology that instantiates three core SE design principles for multi-agent LLMs: (1) explicit behavioral contract modeling, (2) structured messaging, and (3) lifecycleguided execution with verification, and is implemented atop Google s Agent-to-Agent (A2A) infrastructure. Empirical evaluation using the Multi-Agent System Failure Taxonomy (MAST) framework demonstrates that SEMAP effectively reduces failures across different SE tasks. In code development, it achieves up to a 69.6% reduction in total failures for function-level development and 56.7% for deployment-level development. For vulnerability detection, SEMAP reduces failure counts by up to 47.4% on Python tasks and 28.2% on C/C++ tasks. © 2025 IEEE.},
	author_keywords = {AI Agent Protocols; AI for SE; Large Language Models; Multi-Agent Systems; Software Engineering},
	keywords = {C++ (programming language); Failure (mechanical); Intelligent agents; Modeling languages; Safety engineering; Software design; Systems analysis; Verification; AI agent protocol; AI for software engineering; Collaborative development; Development workflow; Engineering tasks; Language model; Large language model; Multi agent; Multiagent systems (MASs); Underspecification; Multi agent systems},
	correspondence_address = {S. Liu; City University of Hong Kong, Hong Kong, Hong Kong; email: sliu273-c@my.cityu.edu.hk},
