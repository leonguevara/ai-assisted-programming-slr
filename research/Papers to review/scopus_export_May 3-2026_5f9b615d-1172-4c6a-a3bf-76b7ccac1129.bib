@CONFERENCE{Anandayuvaraj2024506,
	author = {Anandayuvaraj, Dharun and Campbell, Matthew and Tewari, Arav and Davis, James C},
	title = {FAIL: Analyzing Software Failures from the News Using LLMs},
	year = {2024},
	journal = {Proceedings - 2024 39th ACM/IEEE International Conference on Automated Software Engineering, ASE 2024},
	pages = {506 - 518},
	doi = {10.1145/3691620.3695022},
	url = {https://www.scopus.com/pages/publications/85212427208?origin=resultslist},
	affiliations = {Purdue University, West Lafayette, IN, United States},
	abstract = {Software failures inform engineering work, standards, regulations. For example, the Log4J vulnerability brought government and industry attention to evaluating and securing software supply chains. Retrospective failure analysis is thus a valuable line of software engineering research. Accessing private engineering records is difficult, so such analyses tend to use information reported by the news media. However, prior works in this direction have relied on manual analysis. That has limited the scale of their analyses. The community lacks automated support to enable such analyses to consider a wide range of news sources and incidents.To fill this gap, we propose the Failure Analysis Investigation with LLMs (FAIL) system. FAIL is a novel LLM-based pipeline that collects, analyzes, and summarizes software failures as reported in the news. FAIL groups articles that describe the same incidents. It then analyzes incidents using existing taxonomies for postmortems, faults, and system characteristics. To tune and evaluate FAIL, we followed the methods of prior works by manually analyzing 31 software failures. FAIL achieved an F1 score of 90% for collecting news about software failures, a V-measure of 0.98 for merging articles reporting on the same incident, and extracted 90% of the facts about failures. We then applied FAIL to a total of 137,427 news articles from 11 providers published between 2010 and 2022. FAIL identified and analyzed 2,457 distinct failures reported across 4,184 articles. Our findings include: (1) current generation of large language models are capable of identifying news articles that describe failures, and analyzing them according to structured taxonomies; (2) high recurrences of similar failures within organizations and across organizations; and (3) severity of the consequences of software failures have increased over the past decade. The full FAIL database is available so that researchers, engineers, and policymakers can learn from a diversity of software failures. © 2024 Copyright is held by the owner/author(s). Publication rights licensed to ACM.},
	author_keywords = {empirical software engineering; large language models; news analysis; software failure analysis},
	keywords = {Computer software selection and evaluation; Enterprise software; Empirical Software Engineering; Engineering works; Language model; Large language model; News analyze; News articles; Software failure; Software failure analyze; Software supply chains; Work standards; Taxonomies},
	correspondence_address = {D. Anandayuvaraj; Purdue University, West Lafayette, United States; email: dananday@purdue.edu},
	publisher = {Association for Computing Machinery, Inc},
	isbn = {979-840071248-7},
	language = {English},
	abbrev_source_title = {Proc. - ACM/IEEE Int. Conf. Autom. Softw. Eng., ASE},
	type = {Conference paper},
