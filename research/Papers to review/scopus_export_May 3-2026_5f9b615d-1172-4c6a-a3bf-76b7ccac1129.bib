@CONFERENCE{Ozer2026684,
	author = {Ozer, Mehmet Ali and Dundar, Salih},
	title = {Evaluating LLM Performance on CWE Identification and CVSS Estimation},
	year = {2026},
	journal = {Proceedings - 5th International Conference on Informatics and Software Engineering, IISEC 2026},
	pages = {684 - 688},
	doi = {10.1109/IISEC69317.2026.11418496},
	url = {https://www.scopus.com/pages/publications/105036000968?origin=resultslist},
	affiliations = {Orion Innovation, İstanbul, Turkey},
	abstract = {Software vulnerabilities pose critical security risks, yet manual assessment of Common Weakness Enumeration (CWE) classifications and Common Vulnerability Scoring System (CVSS) scores requires specialized expertise and does not scale to modern vulnerability volumes. While Large Language Models (LLMs) demonstrate impressive code understanding capabilities, their effectiveness at vulnerability severity assessment from code patches remains unexplored. This paper presents a systematic empirical evaluation of nine state-of-the-art LLMs on vulnerability assessment tasks using 300 real-world CVEs from the BinPool dataset. We evaluate models on three tasks: CWE classification, CVSS score prediction, and categorical severity assessment. Our analysis reveals substantial performance variation across models, with Gemini-3-Flash-Preview achieving the best CVSS prediction accuracy (MAE: 1.197) and severity classification (59.7% accuracy). Surprisingly, general purpose models significantly outperformed the models specialized for coding across all metrics (CVSS: p < 0.001; Severity: p = 0.007; CWE: p < 0.001), suggesting domain-specific code training does not translate to improved vulnerability assessment. Analysis of class-level predictions reveals systematic bias toward HIGH and MEDIUM severity classifications, with models rarely identifying CRITICAL or LOW vulnerabilities (<2% of predictions). These findings highlight both the potential and fundamental limitations of current LLMs for automated vulnerability assessment, informing both the future development of security-focused language models and the safe deployment of LLM-based code generation systems, including agentic coding assistants. © 2026 IEEE.},
	author_keywords = {Code-Specialized Models; Large Language Models; Software Security; Vulnerability Assessment},
