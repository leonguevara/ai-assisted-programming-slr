@ARTICLE{Obeidat2025,
	author = {Obeidat, Rasha and Alawneh, Luay and Al-Harahsheh, Yara},
	title = {Exploring prompting for dialectical machine translation: a focus on north Jordanian Arabic},
	year = {2025},
	journal = {PeerJ Computer Science},
	volume = {11},
	pages = {},
	doi = {10.7717/peerj-cs.3209},
	url = {https://www.scopus.com/pages/publications/105024885108?origin=resultslist},
