@ARTICLE{Ito2025487,
	author = {Ito, Waka and Obara, Yui and Sato, Miyu and Kuramitsu, Kimio},
	title = {Hallucination Detection on Code Generation with SelfCheckGPT},
	year = {2025},
	journal = {Journal of Information Processing},
	volume = {33},
	pages = {487 - 493},
	doi = {10.2197/ipsjjip.33.487},
	url = {https://www.scopus.com/pages/publications/105013665935?origin=resultslist},
	affiliations = {Graduate School of Science, Division of Mathematical and Physical Sciences, Japan Women’s University, Tokyo, Bunkyo, 112–8681, Japan; Department of Mathematics, Physics, and Computer Science, Japan Women’s University, Tokyo, Bunkyo, 112–8681, Japan},
	abstract = {Large language models (LLMs) are expected to bring automation and efficiency to software development, including programming. However, an LLM encounters a challenge known as “hallucination,” where it produces incorrect content or outputs that deviate from input requirements. SelfCheckGPT is one of the methods designed to detect hallucinations. Its key feature lies in its ability to infer the occurrence of hallucinations without requiring reference data or test cases. Although SelfCheckGPT has been evaluated and applied in natural language processing tasks such as text summarization and question answering, its performance in code generation has not yet been explored. In this study, we applied SelfCheckGPT to the HumanEval dataset, a standard benchmark for code generation, and investigated its evaluation performance by comparing it with execution-based evaluations. The results revealed that calculating similarity using BLEU, ROUGE-L, and EditSim is adequate for predicting the correctness of code or, in other words, hallucinations. © 2025 Information Processing Society of Japan.},
