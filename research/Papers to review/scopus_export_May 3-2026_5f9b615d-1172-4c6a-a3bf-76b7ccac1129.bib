	keywords = {Computational complexity; Computer aided software engineering; Decision making; Intelligent agents; Production control; Smart manufacturing; Agent based; Agent-based systems; Complexity management; Complexity metrics; Intelligent Manufacturing; Management agents; Manufacturing complexity; Modulars; PySD; Simulation-based analysis; Autonomous agents},
	correspondence_address = {J. Shi; Southwest China Research Institute of Electronic Equipment, Chengdu, Sichuan, China; email: shijcbit@163.com},
