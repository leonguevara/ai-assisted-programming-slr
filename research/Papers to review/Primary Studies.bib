},
	file = {PDF:/Users/lguevara/Zotero/storage/KHU636UI/Dozono et al. - 2026 - Large Language Models for Secure Code Assessment A Multi-Language Empirical Study.pdf:application/pdf},
}

@misc{nascimento_llm4ds_2024,
