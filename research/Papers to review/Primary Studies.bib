},
	file = {PDF:/Users/lguevara/Zotero/storage/6NI6HK53/Shihab et al. - 2025 - The Effects of GitHub Copilot on Computing Students' Programming Effectiveness, Efficiency, and Proc.pdf:application/pdf},
