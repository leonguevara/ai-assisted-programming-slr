@misc{rodriguez_comparative_2025,
	title = {Comparative {Evaluation} of {Total} {Cost} of {Ownership} ({TCO}) in {Software} {Development} for a {FinTech} {Company} with {Operations} in {Costa} {Rica}: {Junior} {Human} {Capital} vs. {GitHub} {Copilot}},
	url = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6266838},
	abstract = {This article presents a comparative analysis of the Total Cost of Ownership (TCO) for the software development phase between junior human capital and artificial intelligence technologies (GitHub Copilot) in a FinTech company with operations in Costa Rica. Through financial analysis methodologies, key TCO components are examined, including direct costs (acquisition, licenses, salaries), indirect costs (training, maintenance, management), productivity (speed, quality), and risks (technical, operational). The study develops a financial evaluation model that enables executives to identify the economic breakeven point between both options, facilitating technology investment decisions grounded in concrete financial metrics and return on investment analysis. The results provide a reference framework for optimizing resource allocation in software development within the specific context of FinTech companies. Corrected calculations show a Return on Investment (ROI) of 60.23\% and a payback period of 7.32 months for GitHub Copilot implementation, with a breakeven threshold of 98 story points annually.},
