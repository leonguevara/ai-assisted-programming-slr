@inproceedings{perry_users_2023,
	address = {Copenhagen Denmark},
	title = {Do {Users} {Write} {More} {Insecure} {Code} with {AI} {Assistants}?},
	isbn = {979-8-4007-0050-7},
	url = {https://dl.acm.org/doi/10.1145/3576915.3623157},
