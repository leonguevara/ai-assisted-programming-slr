},
	annote = {Paper\_011
},
	file = {PDF:/Users/lguevara/Zotero/storage/XMZ4R2WF/Nascimento et al. - 2024 - LLM4DS Evaluating Large Language Models for Data Science Code Generation.pdf:application/pdf},
