@inproceedings{yue_prefix-tuning_2025,
	title = {Prefix-{Tuning} for {Large} {Language} {Models} {Enhanced} with {Hierarchical} {Graph} {Semantics} in {CI}/{CD} {Workflow} {Generation}},
	isbn = {979-833156606-7 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105035617231?origin=resultslist},
	doi = {10.1109/ISPDS67367.2025.11391071},
	abstract = {In recent years, the automation of continuous integration and deployment in software engineering has been continuously improving. However, the hierarchical complexity of workflows and cross-framework dependencies still limit their efficiency and reliability. Large language models (LLMs) offer new insights into workflow generation, but traditional serialized generation methods struggle to model hierarchical structures and cross-node constraints, often leading to syntactic errors and semantic mismatches. To address these challenges, this paper proposes a hierarchical graph semantic-enhanced prefix finetuning method for workflow generation. First, structural features of workflows are extracted through Syntax Trees (ASTs), forming data representations for fine-tuning. Next, a Transformer is used for semantic mapping and feature encoding, establishing a unified representation of structure and semantics. Finally, a hierarchical graph neural network generates prefix vectors and injects them into the attention layers of a large language model, enabling parameter-efficient, structure-guided generation. Additionally, to avoid sequence bottlenecks and long-dependency attenuation, a hierarchical attention mechanism is employed to enhance the modeling capability of the graph neural network, ensuring structural consistency and semantic integrity throughout the decoding process. Experimental results show that this method effectively alleviates issues of structural and semantic inconsistency, demonstrating its effectiveness and universality in workflow generation tasks. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Int. {Conf}. {Inf}. {Sci}., {Parallel} {Distrib}. {Syst}., {ISPDS}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Yue, Q. and Liu, Y. and Fu, W. and Guo, S. and Kong, Y. and Li, C.},
	year = {2025},
	note = {Journal Abbreviation: Int. Conf. Inf. Sci., Parallel Distrib. Syst., ISPDS},
	keywords = {Software engineering, Semantics, Large Language Models, Computational linguistics, Language model, Large language model, Syntactics, Work-flows, Industrial research, Graph theory, Graph neural networks, Semantic Web, Industrial management, CI/CD workflow generation, CI/CD Workflow Generation, Graph semantics, Graph structures, Hierarchical attention, Hierarchical Attention, Hierarchical graph neural network, Hierarchical Graph Neural Networks, Hierarchical graphs, Prefix finetuning, Prefix FineTuning},
	pages = {135--143},
