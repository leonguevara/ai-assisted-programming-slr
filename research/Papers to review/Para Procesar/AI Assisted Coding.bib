	keywords = {Large language models, Software engineering, Dataset, Language model, Large language model, Performance, Benchmarking, Systematic Review, Abstracting, Benchmark datasets, Performances evaluation, Research artefacts, Screening process, Systematic reviews, Title-abstract screening},
	pages = {218--229},
	annote = {Export Date: 04 May 2026; Cited By: 0; Conference name: 2025 ACM/IEEE International Symposium on Empirical Software Engineering and Measurement, ESEM 2025; Conference date: 2 October 2025 through 3 October 2025; Conference code: 219070},
