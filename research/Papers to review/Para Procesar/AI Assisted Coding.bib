	year = {2025},
	keywords = {Artificial intelligence, Information systems, Security, Privacy, Language model, Large language model, Large datasets, Network security, Personnel training, Sensitive data, AI Technologies, Best practices, Defence mechanism, Defence mechanisms, Information leakage, LLM attack, LLM attacks, Sensitive informations, Social networking (online), User data},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: C. Hongsong; Department of Computer Science, University of Science and Technology Beijing (USTB), Beijing, 100083, China; email: Chenhs@ustb.edu.cn},
