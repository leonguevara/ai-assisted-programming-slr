	year = {2024},
	note = {Journal Abbreviation: Proc. - Int. Conf. Softw. Eng. Res. Innov., CONISOFT},
	keywords = {Chatbots, LLM, Search engines, Computer aided software engineering, Language model, Codegeneration, Software design, Computer software selection and evaluation, State of the art, Systematic literature review, Problem oriented languages, 'current, Secure software development, Systematic Literature Review, Secure Software Development, Code recommender, Code Recommenders, Modeling technology, State of research},
