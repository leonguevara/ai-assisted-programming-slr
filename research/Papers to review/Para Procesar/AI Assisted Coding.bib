}

@article{ismail_ai-driven_2025,
	title = {{AI}-{Driven} {Automation} for {Transforming} the {Future} of {Software} {Development}},
	volume = {40},
	issn = {22518223 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105024091356?origin=resultslist},
	doi = {10.22034/jipm.2025.728106},
	abstract = {Background: Artificial Intelligence (AI) has recently emerged as a transformative innovation within the software industry, disrupting conventional approaches to application development by automating tasks, refining code, and enhancing resource efficiency. Prior research indicates the effectiveness of AI-powered tools across various domains. However, contemporary studies lack a detailed analysis of the diverse sectors utilizing AI tools for software development. Objective: This article aims to identify the potential benefits and impacts of AI in software development, specifically regarding time-to-market, productivity, code quality, bug-fixing rates, resource flexibility, and developer satisfaction. The goal is to present fact-based information about AI{\textquoteright}s impact on multiple industries and scopes of work. Methods: A mixed-methods research design was employed to analyze quantitative data from 40 projects across healthcare, financial services, retail, technology, and e-commerce industries. Data were collected using various project management tools, automated testing environments, and online questionnaires addressed to developers. The study incorporated a comparative evaluation of AI-based projects and traditional projects, with statistical analysis. Results: AI-driven software development projects demonstrated a mean reduction in time-to-market by 34.6\%, an improvement in code quality by 70\%, and a mean reduction in bug-fixing time by 57.7\%. Productivity per sprint increased by over 70\%, resource flexibility was higher (90.2\% in AI projects vs. 67.8\% in traditional projects), and developers reported higher satisfaction levels. These findings reinforce the concept that AI significantly enhances workflow and the achievement of optimal results. Conclusion: AI substantially improves both the speed and quality of software development. Further research should expand to explore the experiences of different sectors, the application of AI-driven tools, their differentiation, and usage, as well as the ethical considerations to promote sustainable and innovative software engineering solutions. {\textcopyright} 2025 Iranian Research Institute for Scientific Information and Documentation. All rights reserved.},
	language = {English},
	journal = {Iranian Journal of Information Processing and Management},
	publisher = {Iranian Research Institute for Scientific Information and Documentation},
	author = {Ismail, L.S. and Jamil, A.S. and Dastanbekovich, A.A. and Al-Dosari, I.H.M. and Salman, K.},
	year = {2025},
	keywords = {artificial intelligence (AI), software engineering, software development, code generation, debugging, AI-driven automation, automated testing, continuous delivery (CD), continuous integration (CI), machine learning (ML)},
	pages = {87--118},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: A.A. Dastanbekovich; Osh State University, Osh City, 723500, Kyrgyzstan; email: Aazimov@oshsu.kg},
}

@inproceedings{srinivas_generative_2026,
	title = {Generative {AI}-{Assisted} {Framework} for {Secure} and {Autonomous} {Software} {Development} {Lifecycle} {Optimization}},
	isbn = {979-833159981-2 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105036577383?origin=resultslist},
	doi = {10.1109/ICIPCN67432.2026.11438791},
	abstract = {The rapid evolution of software development demands innovative approaches to enhance security, efficiency, and automation throughout the Software Development Lifecycle (SDLC). This paper presents a comprehensive Generative AI-assisted framework that integrates large language models and machine learning techniques to optimize and secure the SDLC. The proposed framework leverages generative AI capabilities across multiple phases including requirements analysis, code generation, vulnerability detection, automated testing, and deployment optimization. By incorporating AI-driven threat modeling and continuous security assessment, the framework addresses critical challenges in identifying vulnerabilities early in development while maintaining code quality and reducing time-to-market. The system employs advanced prompt engineering techniques and context-aware code analysis to generate secure code patterns, detect security anomalies, and suggest remediation strategies in real-time. Experimental validation demonstrates significant improvements in vulnerability detection rates, code quality metrics, and development efficiency compared to traditional SDLC approaches. The framework achieves automated security scanning with minimal false positives while maintaining developer productivity. This research contributes to the emerging field of AI-assisted software engineering by providing a practical, scalable solution for organizations seeking to modernize their development processes while prioritizing security and autonomy. {\textcopyright} 2026 IEEE.},
