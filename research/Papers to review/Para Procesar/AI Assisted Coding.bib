@article{milhem_assessing_2025,
	title = {Assessing {ChatGPT}'s {Capability} in {Extracting} {Architectural} {Elements} from {Software} {Systems}},
	volume = {17},
	issn = {20748523 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105014195202?origin=resultslist},
	doi = {10.15849/IJASCA.250730.11},
	abstract = {Software architecture plays a critical role in ensuring system quality, yet manually identifying architectural patterns and tactics in codebases remains time-consuming and error prone. While traditional tools like Archie automate parts of this process, the emergence of large language models (LLMs) like ChatGPT offers new opportunities for scalable, intelligent analysis. This work aims to investigate the capability of ChatGPT, a large language model (LLM), for software design analysis, specifically in detecting architectural patterns and tactics. We evaluated ChatGPT-4o and Archie on five open-source systems (Apache Storm, Flink, Spark, Gradle, and Maven) using precision, recall, F1-score, and accuracy metrics. The methodology involved: (1) processing entire codebases (via zipped uploads) and architecturally significant snippets, (2) manually validating outputs against a ground truth, and (3) comparing results with Archie{\textquoteright}s established benchmarks. Results reveal that ChatGPT achieves 57\% accuracy for pattern detection outperforming Archie (44.4\%) in systems like Spark and Gradle, where modern patterns (e.g., Pipeline, Master-Slave) are prevalent. However, it achieves a precision of 23\% vs. Archie{\textquoteright}s 75\% for tactic detection, highlighting limitations in recognizing traditional architectural strategies. Both tools face challenges with false positives, but ChatGPT demonstrates superior adaptability to newer paradigms. These results suggest that LLMs can augment{\textemdash}but not yet replace{\textemdash} traditional tools for architectural analysis. ChatGPT{\textquoteright}s strength in pattern extraction bridges gaps in automation, while its tactic detection limitations underscore the need for hybrid approaches. This study provides empirical insights into LLMs{\textquoteright} role in software engineering, paving the way for more intelligent, collaborative architecture analysis tools. {\textcopyright} Al-Zaytoonah University of Jordan (ZUJ).},
	language = {English},
	number = {2},
	journal = {International Journal of Advances in Soft Computing and its Applications},
	publisher = {Al-Zaytoonah University of Jordan},
	author = {Milhem, H. and Harrison, N.B.},
	year = {2025},
	keywords = {Software Engineering, ChatGPT Assessment, ChatGPT Evaluation, Elements Extraction, Pattern, Tactic},
	pages = {209--231},
	annote = {Export Date: 04 May 2026; Cited By: 0},
}

@inproceedings{wu_retrieval_2025,
	title = {A {Retrieval} {Filtering} and {Thought} {Enhancement} {Framework} for {Function}-{Level} {Code} {Generation} {Based} on {Large} {Language} {Model}},
	isbn = {1062922X (ISSN); 979-833153358-8 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105033150008?origin=resultslist},
	doi = {10.1109/SMC58881.2025.11343122},
	abstract = {The function-level code generation is an important task in the combination of software engineering and artificial intelligence, which aims to improve the productivity of software development by automatically generating function-level code based on task descriptions. However, this task currently suffers from several problems: 1) in the fine-tuning phase, current large language models cannot sufficiently capture the detailed syntactic structure of the code dataset; 2) previous retrieval-augmented methods cannot adequately consider the complex dependencies between code snippets in external code repositories; 3) existing large language models introducing self-repair mechanism tend to overfocus on previously generated erroneous code during the self-repair process. To solve these problems, we propose a retrieval filtering and thought enhancement framework for function-level code generation based on large language model. In our model, we design an abstract syntax tree mapping preprocessing module to preprocess the dataset and help large language models learn the detailed syntax information of the dataset. Furthermore, we design a retrieval filtering and thought enhancement module to retrieve the most relevant snippets of code for the task and to enhance the chain-of-thought of our model. In addition, we design a self-repair mechanism to prevent large language models from overfocusing on generated erroneous code, helping them explore more solutions to repair the erroneous code. We experimented and evaluated our model on HumanEval, MBPP, and MultiPLE benchmarks to compare with other baseline models. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Conf. {Proc}. {IEEE} {Int}. {Conf}. {Syst}. {Man} {Cybern}.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Wu, C. and Zhang, P. and Jiang, X. and Liu, S.},
	year = {2025},
	note = {Journal Abbreviation: Conf. Proc. IEEE Int. Conf. Syst. Man Cybern.},
	keywords = {Artificial intelligence, Computational linguistics, Language model, Repair, Syntactics, Codegeneration, Codes (symbols), Large datasets, Fine tuning, Automatic programming, Software design, Task description, Functions level, Enhancement framework, Generating functions, Phase currents, Repair mechanism, Self repair},
	pages = {2170--2177},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: S. Liu; Qilu University of Technology (Shandong Academy of Sciences), Key Laboratory of Computing Power Network and Information Security, Ministry of Education, Shandong Computer Science Center (National Supercomputer Center in Jinan), Jinan, China; email: liusong@qlu.edu.cn; Conference name: 2025 IEEE International Conference on Systems, Man, and Cybernetics, SMC 2025; Conference date: 5 October 2025 through 8 October 2025; Conference code: 219622; CODEN: PICYE},
}

@inproceedings{tripathi_confident_2025,
	title = {Confident but {Incorrect}: {Mitigating} {Hallucination} and {Overconfidence} in {Agentic} {AI} {Coders}},
	isbn = {2640074X (ISSN); 979-833155618-1 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105033232943?origin=resultslist},
	doi = {10.1109/ICIIP68302.2025.11346318},
	abstract = {Agentic AI capable of independent software development is transforming productivity in engineering. But their increasing independence brings up important dependability issues that require careful thought. These systems typically produce code that seems technically sound at first glance but has underlying logical or functional errors; this issue is called hallucination. The problem worsens and there are fewer opportunities for human review or confirmation when such erroneous outputs are given excessive confidence. The study presented here claims that the systematic cause of these shortcomings is training approaches in big language models that emphasize reinforcement learning based on human feedback and aimed at terminal outcomes. Such methods, which prioritize seeming plausibility over substantive truth and encourage stylistic coherence at the expense of rigorous reasoning, jeopardize the software architectures' ongoing resilience. To counter this, a different training strategy is advised. The primary change, referred to as reinforcement learning from process supervision, causes supervisors to focus on intermediate reasoning paths rather than terminal products. This alignment includes tried-and-true engineering techniques that place a high value on sequential verification and clear justification articulation. A subsequent improvement includes formal verification and uncertainty estimates in the generative pipeline, which allows models to detect and signal epistemic constraints in code synthesis. These interventions are supported by empirical evaluations: on a defined benchmark group, the pass-at-one accuracy measure improved by 14 percentage points compared to the baseline, and the ROC curve area increased from 0.68 to 0.78, indicating improved failure anticipation efficacy. These results provide a viable path for agentic AI to participate in programming tasks as trustworthy, reflective partners, instead of assertive but faulty assistants. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Proc. {IEEE} {Int}. {Conf}. {Image} {Inf}. {Process}., {ICIIP}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Tripathi, Y. and Kohli, V. and Misra, S.},
	editor = {{Jakhar A.K.} and {Kumar A.} and {Sehgal V.K.}},
	year = {2025},
	note = {Journal Abbreviation: Proc. IEEE Int. Conf. Image Inf. Process., ICIIP},
	keywords = {Software reliability, code generation, large language models, Formal verification, Language model, Large language model, Codegeneration, Codes (symbols), Reinforcement learnings, Software design, Personnel training, Computational methods, reinforcement learning, formal verification, Software-Reliability, hallucination, Hallucination, Agentic AI, agentic AI, Dependability issues, process supervision, Process supervision, software reliability, Uncertainty analysis, uncertainty quantification, Uncertainty quantifications},
	pages = {723--728},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: Y. Tripathi; Interviewbit Technologies Private Limited, Bengaluru, India; email: tripathiyash1004@gmail.com; Conference name: 8th International Conference on Image Information Processing, ICIIP 2025; Conference date: 27 November 2025 through 29 November 2025; Conference code: 219631},
}

@inproceedings{matloob_unlocking_2025,
	title = {Unlocking {Code} {Understanding}: {A} {Local}-{First} {Hybrid} {Knowledge} {Graph} {Approach}},
	isbn = {979-833159953-9 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105036977689?origin=resultslist},
	doi = {10.1109/ICCA66035.2025.11430945},
	abstract = {Modern enterprise software development is often hampered by the immense complexity of large-scale, proprietary codebases. While Large Language Models (LLMs) offer a path to automate complex software development tasks, their application is frequently limited by context window sizes and critical security concerns over sending source code to external APIs. In this paper, we present a novel, local-first AI agent designed to integrate into modern Integrated Development Environments (IDEs) and build a deep, contextual understanding of codebases while preserving data privacy. The cornerstone of our system is a hybrid knowledge graph that synergistically combines a structured, AI-generated symbolic representation of the code with a dense semantic vector index, all running on the developer's local machine. We introduce a distributed worker architecture that parallelizes the expensive analysis and indexing process across multiple worker processes. Our evaluation demonstrates that this parallel architecture significantly reduces analysis time compared to sequential methods. Furthermore, we show that our hybrid retrieval method provides more accurate and relevant context for downstream code generation tasks than either purely symbolic or purely semantic approaches. Our work presents a practical and secure architecture for embedding powerful, context-aware AI assistants directly within an enterprise development environment, enabling advanced task automation without compromising code privacy. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Int. {Conf}. {Comput}. {Appl}., {ICCA} - {Proc}.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Matloob, Y. and Kamal, H.A. and Abdelkader, N.},
	editor = {{Alja'am J.M.} and {Taqi N.}},
	year = {2025},
	note = {Journal Abbreviation: Int. Conf. Comput. Appl., ICCA - Proc.},
	keywords = {Semantics, Large Language Models, Computer aided software engineering, Language model, Large language model, Codes (symbols), Computer programming languages, Automatic programming, Software design, Data privacy, Application programming interfaces (API), Code understanding, Software Engineering, Static analysis, Retrieval-augmented generation, Enterprise software, Retrieval-Augmented Generation, Static Analysis, Knowledge graphs, Agentic AI, Parallel architectures, Developer tool, Developer Tools, Hybrid knowledge, Local-first AI, Local-First AI, Workers'},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: Y. Matloob; Cairo University, Communications and Electronics Dept., Giza, Egypt; email: youssefmatloob@gmail.com; Conference name: 7th International Conference on Computer and Applications, ICCA 2025; Conference date: 22 December 2025 through 24 December 2025; Conference code: 222144},
