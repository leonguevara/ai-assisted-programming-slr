	year = {2025},
	keywords = {Large language models, Software engineering, Literature reviews, Empirical study, Literature review, Computer aided software engineering, Language model, Large language model, Codegeneration, Computer software selection and evaluation, Performance, Engineering tasks, Empirical studies, Optimisations, Text generations, Reasoning tasks},
	annote = {Export Date: 04 May 2026; Cited By: 46; Correspondence Address: J. Chen; School of Software Engineering, Sun Yat-sen University, Guangdong, China; email: chenjch86@mail.sysu.edu.cn; CODEN: ESENF},
