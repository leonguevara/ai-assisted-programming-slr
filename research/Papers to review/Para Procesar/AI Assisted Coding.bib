	keywords = {LLMs, Open source software, Language model, Large language model, Codegeneration, Codes (symbols), Fine tuning, Software design, Computer hardware description languages, Open systems, State of the art, Benchmarking, Model-driven, Pre-training, Economic and social effects, Contamination, Data contamination, Data Contamination, Hardware design, Benchmark data, Hardware Design},
