@inproceedings{xiao_coorlog_2025,
	title = {{CoorLog}: {Efficient}-{Generalizable} {Log} {Anomaly} {Detection} via {Adaptive} {Coordinator} in {Software} {Evolution}},
	isbn = {979-835035733-2 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105034697714?origin=resultslist},
	doi = {10.1109/ASE63991.2025.00097},
	abstract = {Frequent software updates lead to log evolution, posing generalization challenges for current log anomaly detection. Traditional log anomaly detection research focuses on using small deep learning models (SMs), but these models inherently lack generalization due to their closed-world assumption. Large language models (LLMs) exhibit strong semantic understanding and generalization capabilities, making them promising for log anomaly detection. However, they suffer from computational inefficiencies. To balance efficiency and generalization, we propose a collaborative log anomaly detection scheme (CoorLog) that uses an adaptive coordinator to integrate SM and LLM. The coordinator determines if incoming logs have evolved. Non-evolved logs are routed to the SM, while evolved logs are directed to the LLM for detailed inference using the constructed Evol-CoT. To gradually adapt to evolution, we introduce the adaptive evolution mechanism (AEM), which updates the coordinator to redirect evolved logs identified by the LLM to the SM. Simultaneously, the SM is fine-tuned to inherit the LLM's judgment on these logs. Extensive experiments on real-world datasets demonstrate that CoorLog achieves superior F1-scores in both intra-version and inter-version anomaly detection. Additionally, CoorLog reduces processing time by 91.63\% and token consumption by 85.59\% compared to using an LLM alone. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Proc. - {IEEE}/{ACM} {Int}. {Conf}. {Autom}. {Softw}. {Eng}., {ASE}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Xiao, P. and Duan, C. and He, M. and Jia, T. and Wu, Y. and Xu, J. and Gao, G. and Zhang, L. and Hong, W. and Li, Y. and Huang, G.},
	year = {2025},
	note = {Journal Abbreviation: Proc. - IEEE/ACM Int. Conf. Autom. Softw. Eng., ASE},
	keywords = {Software engineering, Semantics, Deep learning, Large Language Models, Language model, Large language model, Anomaly detection, Learning systems, 'current, Learning models, Distributed computer systems, Software Evolution, Anomaly Detection, Generalisation, Model collaboration, Model Collaboration, Software updates, System log, System Logs},
	pages = {1119--1131},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: Y. Li; Peking University, School of Software and Microelectronics, Beijing, China; email: li.ying@pku.edu.cn; T. Jia; Peking University, Institute for Artificial Intelligence, Beijing, China; email: jia.tong@pku.edu.cn; Conference name: 2025 40th IEEE/ACM International Conference on Automated Software Engineering, ASE 2025; Conference date: 16 November 2025 through 20 November 2025; Conference code: 220073},
}

@inproceedings{pakis_code_2025,
	title = {Code {Generation} in {LLM} {Families}: {A} {Quality} {Comparison} of {Reasoner} and {Regular} {Models}},
	isbn = {25211641 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105030870280?origin=resultslist},
	doi = {10.1109/UBMK67458.2025.11207012},
	abstract = {AI-assisted code generation tools such as GitHub Copilot, Amazon CodeWhisperer, and ChatGPT are transforming software development by automating routine programming tasks. There is particularly novel advancement in large language models which now function as reasoner tools capable of generating code by running step-by-step internal conversations. This study aims to present a case study that investigates the code quality differences between standard and reasoning models within LLM families, specifically DeepSeek, Claude, and ChatGPT to evaluate the advantages and disadvantages one has over the other. Using prompts from HumanEval dataset, each model's generated code snippets are assessed for validity by compilation and for correctness through unit tests to compare their performance. Novel large language models generally exhibit higher code validity and correctness than previously studied models in the literature, with reasoning models showing varying degrees of improvement depending on the LLM family and prompt type. These findings suggest that the impact of reasoning techniques on code generation quality is complex and contingent on the specific language model and prompting strategy employed. GitHub Drive.  {\textcopyright} 2025 IEEE.},
