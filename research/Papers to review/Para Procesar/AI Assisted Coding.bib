	annote = {Snippet: {\textellipsis} tasks, benchmarks, and evaluation metrics. Finally, we {\textellipsis} so ftware engineering. We anticipate this work will shed some lights on p ushing the boundaries of LLM-based agents in software {\textellipsis}},
	file = {PDF:/Users/lguevara/Zotero/storage/QFMTH466/Jin et al. - 2024 - From llms to llm-based agents for software engineering A survey of cu rrent, challenges and future.pdf:application/pdf},
}

