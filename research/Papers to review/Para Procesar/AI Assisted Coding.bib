@article{godoy_large_2024,
	title = {Large language model evaluation for high-performance computing software development},
	volume = {36},
	issn = {15320626 (ISSN)},
	url = {https://www.scopus.com/pages/publications/85203089199?origin=resultslist},
	doi = {10.1002/cpe.8269},
	abstract = {We apply AI-assisted large language model (LLM) capabilities of GPT-3 targeting high-performance computing (HPC) kernels for (i) code generation, and (ii) auto-parallelization of serial code in C~++, Fortran, Python and Julia. Our scope includes the following fundamental numerical kernels: AXPY, GEMV, GEMM, SpMV, Jacobi Stencil, and CG, and language/programming models: (1) C++ (e.g., OpenMP [including offload], OpenACC, Kokkos, SyCL, CUDA, and HIP), (2) Fortran (e.g., OpenMP [including offload] and OpenACC), (3) Python (e.g., numpy, Numba, cuPy, and pyCUDA), and (4) Julia (e.g., Threads, CUDA.jl, AMDGPU.jl, and KernelAbstractions.jl). Kernel implementations are generated using GitHub Copilot capabilities powered by the GPT-based OpenAI Codex available in Visual Studio Code given simple {\textless}kernel{\textgreater} + {\textless}programming model{\textgreater} + {\textless}optional hints{\textgreater} prompt variants. To quantify and compare the generated results, we propose a proficiency metric around the initial 10 suggestions given for each prompt. For auto-parallelization, we use ChatGPT interactively giving simple prompts as in a dialogue with another human including simple {\textquotedblleft}prompt engineering{\textquotedblright} follow ups. Results suggest that correct outputs for C++ correlate with the adoption and maturity of programming models. For example, OpenMP and CUDA score really high, whereas HIP is still lacking. We found that prompts from either a targeted language such as Fortran or the more general-purpose Python can benefit from adding language keywords, while Julia prompts perform acceptably well for its Threads and CUDA.jl programming models. We expect to provide an initial quantifiable point of reference for code generation in each programming model using a state-of-the-art LLM. Overall, understanding the convergence of LLMs, AI, and HPC is crucial due to its rapidly evolving nature and how it is redefining human-computer interactions. {\textcopyright} 2024 John Wiley \& Sons Ltd.},
	language = {English},
	number = {26},
	journal = {Concurrency and Computation: Practice and Experience},
	publisher = {John Wiley and Sons Ltd},
	author = {Godoy, W.F. and Valero-Lara, P. and Teranishi, K. and Balaprakash, P. and Vetter, J.S.},
	year = {2024},
	keywords = {Python, code generation, GPT, large language model, Language model, Large language model, Codegeneration, Model evaluation, Computer software selection and evaluation, Program processors, Application programming interfaces (API), Program debugging, Problem oriented languages, Report generators, C++ (programming language), FORTRAN (programming language), High-performance computing, Performance computing, Simple++, auto-parallelization, Auto-parallelization, high-performance computing, programming models, Programming models},
	annote = {Export Date: 04 May 2026; Cited By: 11; Correspondence Address: W.F. Godoy; Computing and Computational Sciences Directorate, Oak Ridge National Laboratory, Oak Ridge, United States; email: godoywf@ornl.gov; CODEN: CCPEB},
}

@inproceedings{sakharova_integrating_2023,
	title = {Integrating {Symbolic} {Execution} into the {Fine}-{Tuning} of {Code}-{Generating} {LLMs}},
	volume = {4},
	isbn = {979-889176192-6 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105027001036?origin=resultslist},
	doi = {10.18653/v1/2025.naacl-srw.27},
	abstract = {Code-generating Large Language Models (LLMs) have become essential tools in modern software development, enhancing productivity and accelerating development. This paper aims to investigate the fine-tuning of code-generating LLMs using Reinforcement Learning and Direct Preference Optimization, further improving their performance. To achieve this, we enhance the training data for the reward model with the help of symbolic execution techniques, ensuring more comprehensive and objective data. With symbolic execution, we create a custom dataset that better captures the nuances in code evaluation. Our reward models, fine-tuned on this dataset, demonstrate significant improvements over the baseline, CodeRL, in estimating the quality of generated code. Our code-generating LLMs, trained with the help of reward model feedback, achieve similar results compared to the CodeRL benchmark. {\textcopyright} 2025 Association for Computational Linguistics.},
	language = {English},
