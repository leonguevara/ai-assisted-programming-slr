	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Obbayed, S. and Kumaraswamy, B. and Hemamalini, V. and Madhuri, T.N.P. and Bhuvaneshwari, K.S. and Adnan, M.M. and Al Saadi, M.A.M.},
