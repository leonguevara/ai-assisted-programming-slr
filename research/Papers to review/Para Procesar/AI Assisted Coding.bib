}

@inproceedings{cunha_llm-codeval_2025,
	title = {Llm-{Codeval}: {A} {Framework} for {Verifying} {Implementations} of {Mathematical} {Functions} {Using} {Language} {Models}},
	isbn = {978-953290143-6 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105022014671?origin=resultslist},
	doi = {10.23919/softcom66362.2025.11197356},
	abstract = {Mathematical functions are essential to software systems in areas like probabilistic modeling, simulation, and scientific computing. However, verifying their correctness becomes challenging when definitions come from proprietary tools or academic literature without reference code, leaving no clear ground truth. This paper proposes LLMCODEVAL, a lightweight and systematic framework for validating such implementations using Large Language Models (LLMs). The framework comprises three stages: (i) specification and implementation based on formal contracts; (ii) semantic validation via LLM-generated correctness proofs, followed by expert review; and (iii) empirical evaluation using statistical metrics. We applied LLM-CODEVAL to five ranked-node aggregation functions in Bayesian Networks (BNs) across 48 scenarios with varying weights, variances, and parent states. All implementations achieved Brier Scores below 0.0001, with LLM proofs aligning to specifications after at most two review iterations. The results demonstrate that LLM-CODEVAL enables explainable, auditable, and reproducible verification of mathematical functions. Its stage-based design makes it adaptable to domains where formal definitions exist but verified implementations are unavailable. These findings underscore both the potential and the current limitations of LLM-assisted verification: while LLMs excel at structuring logical arguments, they still require expert oversight to ensure precise mathematical semantics. {\textcopyright} 2025 University of Split, FESB.},
	language = {English},
	booktitle = {Int. {Conf}. {Softw}., {Telecommun}. {Comput}. {Networks}, {SoftCOM}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Cunha, F. and Perkusich, M. and Albuquerque, D. and Gorgonio, K. and Perkusich, A.},
	year = {2025},
	note = {Journal Abbreviation: Int. Conf. Softw., Telecommun. Comput. Networks, SoftCOM},
	keywords = {Mathematical functions, Semantics, Software testing, Large Language Models, Computer aided software engineering, Language model, Large language model, Codes (symbols), Computer programming languages, Software Engineering, Statistical tests, Software-systems, Formal specification, Test Automation, Modeling simulation, Theorem proving, Academic literature, Bayesian networks, Bayesia n networks, Bayesian Networks, Code validation, Code Validation, Probabilistic models},
	annote = {Export Date: 04 May 2026; Cited By: 0; Conference name: 33rd International Conference on Software, Telecommunications and Computer Networks, SoftCOM 2025; Conference date: 18 September 2025 through 20 September 2025; Conference code: 214065},
}

