	keywords = {Artificial intelligence, code generation, large language model, Language model, Large language model, Codegeneration, Codes (symbols), Computer programming languages, Automatic programming, Software design, Source codes, State of the art, Automated code generation, Code evaluation, Security of data, Human like, Arts computing, code error, Code error, code evaluation, Development time},
