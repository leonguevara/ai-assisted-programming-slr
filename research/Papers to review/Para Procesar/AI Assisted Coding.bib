@inproceedings{elengovan_cloud-aware_2026,
	title = {Cloud-{Aware} {Secure} {Software} {Design} using {Model}-{Driven} {Security} {Engineering}},
	isbn = {979-833154881-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105035732182?origin=resultslist},
	doi = {10.1109/ICEARS67481.2026.11416557},
	abstract = {Cloud computing has transformed the deployment of software with its offerings of scalability and on-demand services, but in turn, there are security aspects specific to cloud computing such as multi-tenant risk, dynamic scaling risk, and complex compliance issues. Traditional security approaches tend not to incorporate security considerations throughout the software lifecycle, and this will result in design-time and runtime vulnerabilities. This study presents a Cloud-Aware Secure Software Design methodology with the help of Model-Driven Security Engineering (MDSE) with an aim to systematically incorporate the security requirements right from design to deployment while considering the cloud specific threats. The methodology is a combination of cloud context analysis, security enhanced modeling, automated transformation to cloud aware designs, threat simulation, code generation with embedded security controls and security monitoring. Experimental evaluation using the OWASP Web Security Dataset showed that the proposed method achieves a 32\% reduction of security defects, outperforming 5 state-of-the-art approaches in terms of quality in modeling depth, cloud adaptation, coverage of threat, and automation. Results show that the methodology helps to improve early detection of vulnerabilities, minimize rework and improve the alignment of design and runtime security posture. In conclusion, the study provides a coherent pipeline for secure cloud software development to provide practical information on the adoption of model-driven security in cloud-native environments. {\textcopyright} 2026 IEEE.},
	language = {English},
	booktitle = {Proc. {Int}. {Conf}. {Electron}. {Renew}. {Syst}., {ICEARS}},
