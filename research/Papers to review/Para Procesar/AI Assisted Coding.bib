	keywords = {User feedback, Code Generation, Codegeneration, Software design, Generation systems, Neural code, Speed up, Data poisoning, Data Poisoning, Feedback channel, Feedback mechanisms, Neural modelling, Security implications, User Feedback},
	pages = {528--540},
	annote = {Export Date: 04 May 2026; Cited By: 5; Correspondence Address: X. Du; Monash University, Melbourne, Australia; email: xiaoning.du@monash.edu; Z. Sun; Singapore Management University, Singapore, Singapore; email: zhensuuu@gmail.com; Conference name: 33rd ACM SIGSOFT International Symposium on Software Testing and Analysis, ISSTA 2024; Conference date: 16 September 2024 through 20 September 2024; Conference code: 202635},
