	note = {Journal Abbreviation: Proc. - ACM/IEEE Int. Conf. Autom. Softw. Eng. Workshops, ASEW},
	keywords = {large language models, Computer aided software engineering, Language model, Large language model, Codegeneration, Application programs, Empirical studies, Secure codes, Transformer modeling, Metric, Security evaluation, Security assessment, metrics, pre-trained transformer model, Pre-trained transformer model, security evaluation},
	pages = {54--65},
	annote = {Export Date: 04 May 2026; Cited By: 12; Conference name: 39th ACM/IEEE International Conference on Automated Software Engineering Workshops, ASEW 2024; Conference date: 28 October 2024 through 1 November 2024; Conference code: 204633},
