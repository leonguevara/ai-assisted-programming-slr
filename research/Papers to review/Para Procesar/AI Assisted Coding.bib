@article{li_few-shot_2024,
	title = {Few-shot code translation via task-adapted prompt learning},
	volume = {212},
	issn = {01641212 (ISSN)},
	url = {https://www.scopus.com/pages/publications/85187555984?origin=resultslist},
	doi = {10.1016/j.jss.2024.112002},
	abstract = {Pre-trained models such as CodeT5 and TransCoder have achieved impressive progress in software engineering. However, fine-tuning PLMs for code translation is confronted with significant challenges owing to the scarce availability of parallel code. Large language models such as ChatGPT have exhibited considerable promise in few-shot learning where only a small number of demonstration examples are given to the LLM. Yet they have not been specifically optimized for domain-specific tasks, and their use often entails significant manual effort in manually curating prompts. In this paper, we propose FSCTrans, a novel parameter-efficient tuning approach for code translation when furnished with only a few demonstration examples. (1) to efficiently reuse prior knowledge during pre-training, FSCTrans employs task-adapted prompt tuning, which freezes the pre-trained CodeT5 while merely updating parameters in a small prompt module; (2) to enable parameter efficient tuning on only a small number of examples, FSCTrans bridges pre-training to the translation task through a new pre-training objective of code-to-code generation. We evaluate FSCTrans on Java<->Python and Java<->C\# datasets from both real-world projects and online judge problems. The evaluation results show that FSCTrans is remarkably effective in few-shot code translation: on average, it improves CodeT5 by 54.61\% and 31.59\% in terms of BLEU-4 and CodeBLEU; notably, FSCTrans demonstrates 14.42\% and 18.36\% superior performance in Java {\textrightarrow} C\# translations in terms of BLEU-4 and CodeBLEU compared to ChatGPT. {\textcopyright} 2024 Elsevier Inc.},
	language = {English},
	journal = {Journal of Systems and Software},
	publisher = {Elsevier Inc.},
	author = {Li, X. and Yuan, S. and Gu, X. and Chen, Y. and Shen, B.},
	year = {2024},
	keywords = {Python, Software engineering, Computational linguistics, Language model, Codes (symbols), Fine tuning, Learning systems, Code translation, Java programming language, Translation (languages), Pre-trained language model, Parameter-efficient fine-tuning, Pre-training, Few-shot learning, Bridges, Parallel code, Task-adapted prompt tuning, Transcoder},
	annote = {Export Date: 04 May 2026; Cited By: 25; Correspondence Address: B. Shen; School of Electronic Information and Electrical Engineering, Shanghai Jiao Tong University, Shanghai, 800 Dongchuan Road, China; email: bjshen@sjtu.edu.cn; CODEN: JSSOD},
}

@inproceedings{asare_user-centered_2024-1,
	title = {A {User}-{Centered} {Security} {Evaluation} of {Copilot}},
	isbn = {02705257 (ISSN); 979-840070217-4 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85185370141?origin=resultslist},
	doi = {10.1145/3597503.3639154},
	abstract = {Code generation tools driven by artificial intelligence have recently become more popular due to advancements in deep learning and natural language processing that have increased their capabilities. The proliferation of these tools may be a double-edged sword because while they can increase developer productivity by making it easier to write code, research has shown that they can also generate insecure code. In this paper, we perform a user-centered evaluation GitHub's Copilot to better understand its strengths and weaknesses with respect to code security. We conduct a user study where participants solve programming problems (with and without Copilot assistance) that have potentially vulnerable solutions. The main goal of the user study is to determine how the use of Copilot affects participants' security performance. In our set of participants (n=25), we find that access to Copilot accompanies a more secure solution when tackling harder problems. For the easier problem, we observe no effect of Copilot access on the security of solutions. We also observe no disproportionate impact of Copilot use on particular kinds of vulnerabilities. Our results indicate that there are potential security benefits to using Copilot, but more research is warranted on the effects of the use of code generation tools on technically complex problems with security requirements.  {\textcopyright} 2024 ACM.},
	language = {English},
	booktitle = {Proc {Int} {Conf} {Software} {Eng}},
	publisher = {IEEE Computer Society},
	author = {Asare, O. and Asokan, N. and Nagappan, M.},
	year = {2024},
	note = {Journal Abbreviation: Proc Int Conf Software Eng},
	keywords = {Software engineering, Deep learning, software engineering, Copilot, code generation, Security, Codegeneration, Codes (symbols), Natural language processing systems, Natural languages, User study, security, Language processing, Code generation tools, Security evaluation, User-centred, user study, copilot, Learning languages},
	pages = {1947--1957},
	annote = {Export Date: 04 May 2026; Cited By: 6; Conference name: 44th ACM/IEEE International Conference on Software Engineering, ICSE 2024; Conference date: 14 April 2024 through 20 April 2024; Conference code: 200261; CODEN: PCSED},
