	year = {2024},
	note = {Journal Abbreviation: Commun. Comput. Info. Sci.},
	keywords = {Language model, Large language model, Source codes, Large Language Model, C++ (programming language), Development costs, Energy, Energy-consumption, Javascript, Controlled experiment, Energy Consumption, Code llama, Code Llama, Green software, Green Software},
	pages = {161--176},
