@inproceedings{ozer_evaluating_2026,
	title = {Evaluating {LLM} {Performance} on {CWE} {Identification} and {CVSS} {Estimation}},
	isbn = {979-833158031-5 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105036000968?origin=resultslist},
	doi = {10.1109/IISEC69317.2026.11418496},
	abstract = {Software vulnerabilities pose critical security risks, yet manual assessment of Common Weakness Enumeration (CWE) classifications and Common Vulnerability Scoring System (CVSS) scores requires specialized expertise and does not scale to modern vulnerability volumes. While Large Language Models (LLMs) demonstrate impressive code understanding capabilities, their effectiveness at vulnerability severity assessment from code patches remains unexplored. This paper presents a systematic empirical evaluation of nine state-of-the-art LLMs on vulnerability assessment tasks using 300 real-world CVEs from the BinPool dataset. We evaluate models on three tasks: CWE classification, CVSS score prediction, and categorical severity assessment. Our analysis reveals substantial performance variation across models, with Gemini-3-Flash-Preview achieving the best CVSS prediction accuracy (MAE: 1.197) and severity classification (59.7\% accuracy). Surprisingly, general purpose models significantly outperformed the models specialized for coding across all metrics (CVSS: p {\textless} 0.001; Severity: p = 0.007; CWE: p {\textless} 0.001), suggesting domain-specific code training does not translate to improved vulnerability assessment. Analysis of class-level predictions reveals systematic bias toward HIGH and MEDIUM severity classifications, with models rarely identifying CRITICAL or LOW vulnerabilities ({\textless}2\% of predictions). These findings highlight both the potential and fundamental limitations of current LLMs for automated vulnerability assessment, informing both the future development of security-focused language models and the safe deployment of LLM-based code generation systems, including agentic coding assistants. {\textcopyright} 2026 IEEE.},
	language = {English},
	booktitle = {Proc. - {Int}. {Conf}. {Informatics} {Softw}. {Eng}., {IISEC}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
