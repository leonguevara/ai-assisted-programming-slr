	publisher = {Chinese Academy of Sciences},
	author = {Li, G. and Peng, X. and Wang, Q.-X. and Xie, T. and Jin, Z. and Wang, J. and Ma, X.-X. and Li, X.-D.},
	year = {2023},
	keywords = {Decision making, Computational linguistics, Language model, Large language model, Natural languages, Software design, Engineering tasks, Behavioral research, Computer software, Software-tools, Human-machine collaboration, large language model (LLM), Collaborative tools, Human-machine, human-machine collaborative, Human-machine collaborative, software development and evolution, Software development and evolution},
