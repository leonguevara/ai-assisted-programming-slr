@phdthesis{liu_towards_2024,
	address = {Australia},
	type = {{PhD} {Thesis}},
	title = {Towards {Reliable} {LLM}-based {Software} {Development} {Tools}},
	shorttitle = {Reliable {LLM}-based {Software} {Development} {Tools}},
	url = {https://doi.org/10.26180/27328362},
	doi = {10.26180/27328362},
	abstract = {Large language models (LLMs) have emerged as powerful tools for software development, demonstrating capabilities in code completion, summarization, review, and generation. Despite their potential, the reliability of these LLM-based tools in real-world applications remains a significant concern as they are adopted more widely. This thesis systematically examines key factors that impact the reliability of LLM-based software development tools. First, we conduct a comprehensive empirical evaluation of popular pre-trained LLMs, such as CodeT5+, CodeBERT, and CodeGPT, on representative benchmark datasets for software development tasks. The analysis uncovers significant biases in these datasets, including data duplication and lack of diversity, leading to inflated performance metrics that do not accurately reflect the models{\textquoteright} capabilities in practical scenarios. Specifically, when biased duplicated examples are removed, the performance of the models decreases substantially. Explainability analysis further reveals that current LLMs, built upon unreliable datasets, lack robustness, struggling to reliably recognize critical code tokens. Second, we systematically assess the reliability of code generated by the state-of-the-art ChatGPT model, a powerful LLM based on the GPT-3.5 architecture. By analyzing over 4,000 code snippets generated for 2,033 programming tasks in Java and Python, we identify a range of code quality issues, including syntactic errors, semantic bugs, logical flaws, and maintainability problems. Subsequently, we also investigate ChatGPT{\textquoteright}s selfrepairing ability and its interaction with static analysis tools to fix the code quality issues. Although ChatGPT exhibits self-repairing abilities, the research underscores the need for further enhancements to ensure the generation of reliable and secure code. Lastly, the thesis delves into the security and privacy implications of deploying LLMbased software development applications in Visual Studio Code (i.e., VSCode extensions), a critical aspect of their reliability. Specifically, it uncovers serious security flaws in VSCode extensions that can allow adversaries to covertly obtain or manipulate credential-related data from other extensions. To measure the prevalence of these risks, the thesis develops a novel automated risk detection framework and applies it to 27,261 real-world VSCode extensions, revealing that 8.5\% of them are exposed to credentialrelated data leakage, emphasizing the importance of reliable security measures. In summary, this thesis provides a comprehensive investigation of the reliability of LLMbased software development tools, addressing key factors such as benchmark dataset quality, generated code quality, and software development application security. The findings offer valuable insights and recommendations for building more reliable LLMbased tools to enhance developer productivity and software quality.},
	language = {en},
	urldate = {2026-05-17},
	school = {Monash University},
	author = {Liu, Yue},
	year = {2024},
	note = {Doctoral thesis submitted July 27, 2024.
Supervisor approval signed August 30, 2024.
Contains multiple empirical studies on reliability, benchmark validity, code quality, and security of LLM-based software development tools.},
	annote = {E194
},
	annote = {Paper\_194
},
	file = {PDF:/Users/lguevara/Zotero/storage/FJWP2J3T/Liu - 2024 - Towards Reliable LLM-based Software Development Tools.pdf:application/pdf},
}

@misc{basic_vulnerabilities_2026,
	title = {From {Vulnerabilities} to {Remediation}: {A} {Systematic} {Literature} {Review} of {LLMs} in {Code} {Security}},
	shorttitle = {From {Vulnerabilities} to {Remediation}},
	url = {http://arxiv.org/abs/2412.15004},
	doi = {10.48550/arXiv.2412.15004},
	abstract = {Large Language Models (LLMs) have emerged as powerful tools for automating various programming tasks, including security-related ones, such as detecting and fixing vulnerabilities. Despite their promising capabilities, when required to produce or modify pre-existing code, LLMs could introduce vulnerabilities unbeknown to the programmer. When analyzing code, they could miss clear vulnerabilities or signal nonexistent ones. In this Systematic Literature Review (SLR), we aim to investigate both the security benefits and potential drawbacks of using LLMs for a variety of code-related tasks. In particular, first we focus on the types of vulnerabilities that could be introduced by LLMs, when used for producing code. Second, we analyze the capabilities of LLMs to detect and fix vulnerabilities, in any given code, and how the prompting strategy of choice impacts their performance in these two tasks. Last, we provide an in-depth analysis on how data poisoning attacks on LLMs can impact performance in the aforementioned tasks.},
	language = {en},
