	annote = {Export Date: 04 May 2026; Cited By: 1; Correspondence Address: M.M. Trigui; Information \& Computer Science Department (ICS), King Fahd University of Petroleum \& Minerals (KFUPM), Dhahran 31261, Saudi Arabia; email: g202318370@kfupm.edu.sa; W.G. Al-Khatib; Information \& Computer Science Department (ICS), King Fahd University of Petroleum \& Minerals (KFUPM), Dhahran 31261, Saudi Arabia; email: wasfi@kfupm.edu.sa},
