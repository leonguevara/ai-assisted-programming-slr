@inproceedings{huang_semanticsentinel_2025,
	title = {{SemanticSentinel}: {LLM}-{Based} {Semantic} {Consistency} for {Malicious} {Package} {Detection}},
	isbn = {979-833155587-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105036168465?origin=resultslist},
	doi = {10.1109/ICCTIT68197.2025.11406234},
	abstract = {The burgeoning growth of open-source package ecosystems, exemplified by npm, underpins modern software development, yet simultaneously expands the attack surface for malicious actors. Typosquatting and obfuscation techniques represent critical vectors for injecting malware into the software supply chain. Traditional detection mechanisms, primarily reliant on lexical similarity metrics such as Levenshtein distance, struggle with semantically divergent yet functionally malicious packages, resulting in high false positive and negative rates. This paper introduces SemanticSentinel, a novel framework that leverages Large Language Models (LLMs) to perform deep semantic analysis of package metadata and code. By transcending superficial string comparisons, SemanticSentinel identifies contextual inconsistencies and malicious intent often overlooked by lexical detectors. Our empirical evaluation on a dataset of malicious npm packages demonstrates that SemanticSentinel achieves a superior F1-score of 0.93, significantly outperforming baseline Levenshtein-based approaches (F1-score of 0.68). This substantial improvement underscores the efficacy of LLM-driven semantic understanding in fortifying software supply chain security against stealthy, evolving threats.  {\textcopyright} 2025 IEEE.},
