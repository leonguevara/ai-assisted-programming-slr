@inproceedings{pan_automated_2025,
	title = {Automated {Mesh} {Generation} in {FEM}: {A} {Novel} {Approach} {Using} {Large} {Language} {Models}},
	isbn = {28369734 (ISSN); 978-166546580-9 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105030975631?origin=resultslist},
	doi = {10.1109/ICEPT67137.2025.11157286},
	abstract = {The automation of mesh generation in finite element method (FEM) simulations plays a crucial role in reducing computational effort while ensuring high accuracy. Traditional approaches for mesh refinement, particularly in geometries with stress concentrations, often involve post-processing error estimation and iterative adjustments, resulting in significant computational overhead. Recent advancements in large language models (LLMs) have demonstrated their potential to enhance various engineering processes by enabling more intelligent, context-aware predictions. This work explores the integration of LLMs into the automation of mesh generation, focusing on their ability to predict regions requiring finer mesh refinement directly from the geometric features of a model. By using a priori error predictions based on LLM analysis, the process significantly reduces the need for iterative corrections, leading to faster and more efficient mesh generation. The method was tested on a set of 100 common geometric models, achieving a success rate of 88.4\%, with 66.8\% of generated meshes having computational errors below 10\%, as measured by the Zienkiewicz-Zhu (ZZ) error estimator. Moreover, this approach accelerates the mesh generation process by up to 3.54 times compared to traditional methods, validating the effectiveness of LLM-driven automation in FEM simulations. This work provides a promising pathway for improving the efficiency of mesh generation in engineering simulations, leveraging the power of AI to streamline traditionally labor-intensive processes.  {\textcopyright} 2025 IEEE.},
	language = {English},
	number = {2025},
	booktitle = {Int. {Conf}. {Electron}. {Packag}. {Technol}., {ICEPT}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Pan, F. and Yin, C. and Dou, G.},
	year = {2025},
	note = {Journal Abbreviation: Int. Conf. Electron. Packag. Technol., ICEPT},
	keywords = {Automation, Computer aided software engineering, Language model, Large language model, Iterative methods, Error analysis, Traditional approachs, Forecasting, Adaptive meshing, Automated mesh generations, Computational effort, Element method, Finite element method, High-accuracy, Large language model (LLM), Mesh generation, Mesh refinement, Simulation automation},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: C. Yin; Southeast University, Nanjing, China; email: yincy@seu.edu.cn; G. Dou; Southeast University, Nanjing, China; email: gdou@seu.edu.cn; Conference name: 26th International Conference on Electronic Packaging Technology, ICEPT 2025; Conference date: 5 August 2025 through 7 August 2025; Conference code: 212870},
