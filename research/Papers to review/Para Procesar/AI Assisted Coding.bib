@article{aytekin_automating_2026,
	title = {Automating code generation for a new ecosystem: establishing baselines with large language model based code generation for {ArkTS} and {HarmonyOS}},
	volume = {33},
	issn = {09288910 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105031479086?origin=resultslist},
	doi = {10.1007/s10515-026-00599-9},
	abstract = {Automated code generation has advanced significantly with large language models (LLMs), yet their performance in emerging domain-specific languages for practical software development remains largely untested. This gap is particularly critical for major, rapidly growing platforms like Huawei{\textquoteright}s HarmonyOS. Powering over 900 million devices, the HarmonyOS ecosystem is shifting to a native-only application environment with the HarmonyOS NEXT update. This shift makes development in its native ArkTS UI language essential, driving an urgent need for effective developer tools. Addressing this industry challenge, we conduct the first systematic evaluation of Large Language Models (LLMs) on their ability to generate valid ArkTS code to accelerate the software development lifecycle and assist developers in mastering this new language. To ground our evaluation in practical scenarios, we introduce two curated datasets: a test dataset, ArkTS-Test, and a training dataset for fine-tuning, both derived from common UI development tasks in ArkTS. Using these datasets, we evaluate a diverse range of LLMs{\textemdash}from large-scale proprietary models (e.g., Claude, Gemini, DeepSeek-V3, Qwen3 Coder, from 70b to up to 671B total parameters) to smaller open-source models (7B{\textendash}14B) and report our observations. Next, we propose a methodology called Iterative Compilation Feedback (ICF), which enables LLMs to autonomously correct their own code by leveraging compiler error messages. Our experiments show that ICF boosts the syntactic Pass@1 of large-scale LLMs to as high as 91\%. Furthermore, we show that fine-tuning a small-scale LLM (GPT-4o-mini) and combining it with our ICF method yields results comparable to the best-performing large-scale models. Finally, we conclude with a detailed categorization of compilation errors, identifying which types our ICF method resolves most effectively and which persist due to model knowledge limitations. {\textcopyright} The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2026.},
	language = {English},
	number = {2},
	journal = {Automated Software Engineering},
	publisher = {Springer},
	author = {Aytekin, M.C. and Y{\i}lmaz, F.G. and Demirezen, M.U.},
	year = {2026},
	keywords = {Code generation, Feedback, Ecosystems, Large language models (LLMs), Open source software, Computational linguistics, Language model, Large language model, Syntactics, Codegeneration, Codes (symbols), Large datasets, Fine tuning, Automatic programming, Software design, Open systems, Large-scales, Problem oriented languages, Program compilers, ArkTS, Compiler feedback, Harmonyos, HarmonyOS, Iterative compilation, Low resource languages, Low-resource languages},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: M.C. Aytekin; MSDC Department DC, Huawei T{\"u}rkiye R \& D Center, {\.I}stanbul, Turkey; email: mehmet.cem.aytekin@huawei.com; CODEN: ASOEE},
}

@article{foster_unifying_2025,
	title = {Unifying {Model} {Execution} and {Deductive} {Verification} with {Interaction} {Trees} in {Isabelle}/{HOL}},
	volume = {34},
	issn = {1049331X (ISSN)},
	url = {https://www.scopus.com/pages/publications/105005198079?origin=resultslist},
	doi = {10.1145/3702981},
	abstract = {Model execution allows us to prototype and analyse software engineering models by stepping through their possible behaviours, using techniques like animation and simulation. On the other hand, deductive verification allows us to construct formal proofs demonstrating satisfaction of certain critical properties in support of high-assurance software engineering. To ensure coherent results between execution and proof, we need unifying semantics and automation. In this article, we mechanise Interaction Trees (ITrees) in Isabelle/HOL to produce an execution and verification framework. ITrees are coinductive structures that allow us to encode infinite labelled transition systems, yet they are inherently executable. We use ITrees to create verification tools for stateful imperative programs, concurrent programs with message passing in the form of the CSP and Circus languages, and abstract system models in the style of the Z and B methods. We demonstrate how ITrees can account for diverse semantic presentations, such as structural operational semantics, a relational program model, and CSP's failures-divergences trace model. Finally, we demonstrate how ITrees can be executed using the Isabelle code generator to support the animation of models.  {\textcopyright} 2025 Copyright held by the owner/author(s). Publication rights licensed to ACM.},
	language = {English},
	number = {4},
	journal = {ACM Transactions on Software Engineering and Methodology},
	publisher = {Association for Computing Machinery},
	author = {Foster, S. and Hur, C.-K. and Woodcock, J.},
	year = {2025},
	keywords = {Software quality, Software testing, Search engines, Formal verification, Code Generation, Computer aided software engineering, Codegeneration, Software design, Application programs, Computer operating systems, Computer software selection and evaluation, Software packages, Software prototyping, C (programming language), Computer program listings, Computer software maintenance, Software engineering model, Program compilers, Model checking, Report generators, Formal specification, Animation and Simulation, Animation and simulations, Automated program verification, Automated Program Verification, B-method, Circus language, Circus Language, Coinductive structure, Coinductive Structures, Communicating sequential process, CSP (Communicating Sequential Processes), Deductive verification, Deductive Verification, Formal Methods, High assurance, High-assurance software, High-Assurance Software, Imperative programming, Imperative programming verification, Imperative Programming Verification, Interaction tree, Interaction Trees (ITrees), Isabelle, Isabelle/HOL, Machine oriented languages, Model Execution, Model executions, Proof automation, Proof Automation, Software Engineering Models, Structural operational semantics, Structural Operational Semantics, Theorem Proving, Unifying Theories of Programming, Unifying theory of programming, UTP (Unifying Theories of Programming), Z and B method, Z and B Methods},
	pages = {1--40},
	annote = {Export Date: 04 May 2026; Cited By: 1; Correspondence Address: S. Foster; University of York, York, United Kingdom; email: simon.foster@york.ac.uk; CODEN: ATSME},
}

@inproceedings{li_enhancing_2025,
	title = {Enhancing {Human}-{IDE} {Interaction} in the {SDLC} using {LLM}-based {Mediator} {Agents}},
	isbn = {15397521 (ISSN); 979-840071276-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105013968961?origin=resultslist},
	doi = {10.1145/3696630.3728721},
	abstract = {Large Language Model (LLM)-based autonomous agents provide state-of-the-art performance in various tasks throughout the Software Development Lifecycle (SDLC). Although these agents can be integrated into Integrated Development Environments (IDEs), standalone applications impose cognitive burdens on programmers due to fragmented tool usage across the SDLC. This paper proposes a framework for a mediator agent that serves as the unified interface between the programmer, IDE tools, agentic tools, and external multi-agent systems. The framework aims to simplify interaction, reduce context switching, and automate the orchestration of the IDE tools. By aligning with proposed levels of SE automation, the mediator agent sets the stage for next-generation human-computer collaboration, enhancing productivity, and advancing software engineering automation. {\textcopyright} 2025 Copyright held by the owner/author(s).},
