}

@inproceedings{pombo_bridging_2025,
	title = {{BRIDGING} {Human} {Expertise} and {Generative} {AI} in {Software} {Quality}: {A} {Study} on {Code} {Smell} {Detection} in {Software} {Engineering} {Education}},
	isbn = {979-833159841-9 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105033231586?origin=resultslist},
	doi = {10.1109/TALE66047.2025.11346609},
	abstract = {Large language models (LLMs) transform software engineering by providing AI-assisted coding, debugging, and software quality analysis. Integrated into tools such as ChatGPT and GitHub Copilot, these models assist in code generation, refactoring, and issue detection, improving developer productivity. However, AI still presents challenges such as confabulations, limited contextual understanding, and inconsistencies in code recommendations. This study examines the role of LLMs in code smell detection, evaluating their effectiveness as a complementary tool in software engineering education. An experiment was conducted with higher education students, comparing manual and AI-assisted code smell detection through hands-on exercises. The pre- and post-experiment questionnaires assessed participants' trust in AI, familiarity with code smells, and confidence in manual detection. Although AI accelerated analysis and identified common patterns, it struggled with contextual reasoning, occasionally producing misleading recommendations. The findings suggest that AI can improve software quality assessment but requires human oversight to ensure reliable and context-aware results. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {{TALE} - {IEEE} {Int}. {Conf}. {Teach}., {Assess}., {Learn}. {Eng}., {Proc}.},
