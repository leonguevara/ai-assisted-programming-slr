	note = {arXiv:2507.00788 [cs]},
	keywords = {Computer Science - Software Engineering, Computer Science - Artificial Intelligence},
	annote = {Comment: Preprint of study preregistered at ICSME 2025 with In-Principal Acceptance. https://conf.researchr.org/track/icsme-2024/icsme-2024-registered-reports-track},
