@article{shafikuzzaman_effectiveness_2025,
	title = {On the {Effectiveness} of {Zero}-{Shot} and {Few}-{Shot} {Pretrained} {Language} {Models} for {Software} {Requirement} {Classification}},
	volume = {13},
	issn = {21693536 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105015477813?origin=resultslist},
	doi = {10.1109/ACCESS.2025.3607813},
	abstract = {Accurate classification of software requirements, particularly distinguishing between fun- ctional and non-functional requirements, is essential for enabling traceability, guiding system design, and ensuring project success. Traditional supervised machine learning methods have shown promise in this domain but suffer from limited generalizability, high labeling costs, and overfitting. Recent advances in pretrained language models (PLMs) offer new opportunities for effective requirement classification through zero-shot (ZS) and few-shot (FS) learning. This study investigates the effectiveness of ZS and FS PLMs, including prompt-based generative large language models (e.g., GPT-4o and Llama3), in classifying functional vs. non-functional requirements and non-functional subtypes, such as usability, security, operational, and performance requirements. We conduct a comprehensive empirical evaluation across five classification tasks using two widely adopted datasets: PROMISE and SecReq. The study compares six PLMs, including two ZS, two FS transformer models, and two generative Large Language Models under both ZS and FS settings. We benchmark these models against state-of-the-art and domain-specific baselines, and complement the quantitative analysis with a detailed qualitative error analysis. FS models, such as All-MPNET, All-DistilRoBERTa, and GPT-4o in the FS setting, consistently outperform ZS models across all tasks, achieving superior performance in multi-class NFR and security requirement classification. While NoRBERT remains superior in binary FR/NFR classification, our FS models outperform or match its performance in other scenarios. ZS models, such as GPT-4o, also demonstrate strong results without requiring training data, highlighting their practical utility. Error analysis reveals that annotation issues and lack of context are major sources of misclassification. Our findings establish that ZS and FS PLMs, especially prompt-based generative large language models, offer viable and scalable alternatives to traditional supervised approaches. This study lays the foundation for the broader adoption of prompt-based PLMs in requirement engineering. {\textcopyright} 2013 IEEE.},
	language = {English},
	journal = {IEEE Access},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Shafikuzzaman, M. and Islam, M.R. and Zaman, S. and Ma, A. and Islam Sifat, A.},
	year = {2025},
	keywords = {software engineering, Language model, Requirements engineering, Systems analysis, Performance, Learning systems, Computer software, Classification (of information), Functionals, Software requirements, Requirements classifications, Supervised learning, few-shot, Few-shot, GPT-4o, Non-functional requirements, Requirement classification, Security requirements, zero-shot, Zero-shot},
	pages = {159439--159453},
	annote = {Export Date: 04 May 2026; Cited By: 1; Correspondence Address: M.R. Islam; Lamar University, Department of Computer Science, Beaumont, 77705, United States; email: mislam108@lamar.edu},
}

@inproceedings{araya_enhancing_2025,
	title = {Enhancing {Contextual} {Memory} in {LLMs} for {Software} {Engineering} via {Ontology}-based {Inference}},
	volume = {4055},
	isbn = {16130073 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105019227362?origin=resultslist},
	abstract = {The application of large language models (LLMs) in software engineering has expanded rapidly, supporting tasks such as code generation, system design, error correction, and documentation. However, LLMs face persistent challenges in multi-step development workflows, where accumulated design decisions, dependencies, and constraints require a structured, persistent memory. Existing approaches, including extended context windows and retrieval-augmented generation, rely on statistical similarity between text fragments and lack explicit, formal representations of the evolving system state, limiting their ability to maintain semantic coherence across development stages. We propose an architecture that integrates a dynamically evolving ontology, represented in OWL (Web Ontology Language), as a structured knowledge base, maintained automatically to reflect changes in the codebase and user interactions. OWL is a standard language for formal knowledge representation, allowing the explicit modeling of entities, relationships, and constraints in a machine-readable way. A secondary LLM (LLM2) functions as a context manager, querying the ontology using OWLready2 to retrieve structured information about entities, classes, methods, and associated constraints. This context is provided to the primary LLM (LLM1), which directly interacts with the user to generate code that adheres to both current requirements and historical design decisions. This hybrid approach combines symbolic knowledge representation with generative capabilities, enabling context-aware, semantically coherent, and explainable code generation. We validated the approach through a proof-of-concept implementation in a multi-stage object-oriented development scenario. Comparative evaluation using the same base model, with and without the ontology layer, showed that the ontology-enhanced configuration improved adherence to prior decisions, maintained semantic consistency across stages, and produced outputs that were more interpretable and reliable. These results demonstrate the potential of ontology-supported LLMs to facilitate long-term, semantically grounded software development. {\textcopyright} 2025 Copyright for this paper by its authors.},
	language = {English},
	booktitle = {{CEUR} {Workshop} {Proc}.},
	publisher = {CEUR-WS},
	author = {Araya, D. and Valle, C. and Astudillo, H. and Orme{\~n}o, P. and Taramasco, C.},
	editor = {{Florez H.} and {Galpin I.} and {Grevisse C.}},
	year = {2025},
	note = {Journal Abbreviation: CEUR Workshop Proc.},
	keywords = {Code generation, Large language models, Software engineering, Semantics, Search engines, User interfaces, Language model, Large language model, Codegeneration, Codes (symbols), Software design, Application programs, Error correction, Modeling languages, Information management, Information use, Ontology, Ontology's, Generation systems, Object oriented programming, Design decisions, Design errors, Error documentation, Knowledge representation, Ontologies, Ontology-based, Semantic retrieval},
	pages = {45--54},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: D. Araya; Universidad Andr{\'e}s Bello, Vi{\~n}a del Mar, Chile; email: david.araya@unab.cl; Conference name: 8th International Conference on Applied Informatics Workshops, ICAIW 2025; Conference date: 8 October 2025 through 11 October 2025; Conference code: 213344},
}

@inproceedings{mao_towards_2025,
	title = {Towards {Engineering} {Multi}-{Agent} {LLMs}: {A} {Protocol}-{Driven} {Approach}},
	isbn = {15301362 (ISSN); 979-833156653-1 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105035214345?origin=resultslist},
	doi = {10.1109/APSEC66846.2025.00100},
	abstract = {The increasing demand for software development has driven interest in automating software engineering (SE) tasks using Large Language Models (LLMs). Recent efforts extend LLMs into multi-agent systems (MAS) that emulate collaborative development workflows, but these systems often fail due to three core deficiencies: under-specification, coordination misalignment, and inappropriate verification, arising from the absence of foundational SE structuring principles. This paper introduces Software Engineering Multi-Agent Protocol (SEMAP), a protocol-layer methodology that instantiates three core SE design principles for multi-agent LLMs: (1) explicit behavioral contract modeling, (2) structured messaging, and (3) lifecycleguided execution with verification, and is implemented atop Google s Agent-to-Agent (A2A) infrastructure. Empirical evaluation using the Multi-Agent System Failure Taxonomy (MAST) framework demonstrates that SEMAP effectively reduces failures across different SE tasks. In code development, it achieves up to a 69.6\% reduction in total failures for function-level development and 56.7\% for deployment-level development. For vulnerability detection, SEMAP reduces failure counts by up to 47.4\% on Python tasks and 28.2\% on C/C++ tasks. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Proc. {Asia} {Pac}. {Softw}. {Eng}. {Conf}. {APSEC}},
	publisher = {IEEE Computer Society},
	author = {Mao, Z. and Keung, J. and Zhang, F. and Liu, S. and Wang, Y. and Li, J.},
	editor = {{Zhang T.} and {Luo X.} and {Keung J.} and {Choi E.}},
	year = {2025},
	note = {Journal Abbreviation: Proc. Asia Pac. Softw. Eng. Conf. APSEC},
	keywords = {Large Language Models, Verification, Language model, Large language model, Multi agent, Multi agent systems, Software design, Systems analysis, AI for SE, Intelligent agents, Engineering tasks, Software Engineering, Modeling languages, C++ (programming language), Development workflow, Multiagent systems (MASs), Safety engineering, Collaborative development, Multi-Agent Systems, AI agent protocol, AI Agent Protocols, AI for software engineering, Failure (mechanical), Underspecification},
	pages = {897--901},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: S. Liu; City University of Hong Kong, Hong Kong, Hong Kong; email: sliu273-c@my.cityu.edu.hk; Conference name: 32nd Asia-Pacific Software Engineering Conference, APSEC 2025; Conference date: 2 December 2025 through 5 December 2025; Conference code: 221031},
