@inproceedings{donvir_role_2024,
	title = {The {Role} of {Generative} {AI} {Tools} in {Application} {Development}: {A} {Comprehensive} {Review} of {Current} {Technologies} and {Practices}},
	isbn = {979-833150790-9 (ISBN)},
