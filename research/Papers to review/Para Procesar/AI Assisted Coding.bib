@article{babiuch_benchmarking_2026,
	title = {Benchmarking {Large} {Language} {Models} for {Embedded} {Systems} {Programming} in {Microcontroller}-{Driven} {IoT} {Applications}},
	volume = {18},
	issn = {19995903 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105031173817?origin=resultslist},
	doi = {10.3390/fi18020094},
	abstract = {Large language models (LLMs) have shown strong potential for automated code generation in software development, yet their effectiveness in embedded systems programming{\textemdash}requiring understanding of software logic and hardware constraints{\textemdash}has not been well studied. Existing evaluation frameworks do not comprehensively cover practical microcontroller development scenarios in real-world Internet of Things (IoT) projects. This study systematically evaluates 27 state-of-the-art LLMs across eight embedded systems scenarios of increasing complexity, from basic sensor reading to complete cloud database integration with visualization dashboards. Using ESP32 microcontrollers with environmental and motion sensors, we employed the Analytic Hierarchy Process with four weighted criteria: functional, instructions, output and creativity, evaluated independently by two expert reviewers. Top-performing models were Claude Sonnet 4.5, Claude Opus 4.1, and Gemini 2.5 Pro, with scores from 0.984 to 0.910. Performance degraded with complexity: 19{\textendash}23 models generated compilable code for simple applications, but only 3{\textendash}5 produced functional solutions for complex scenarios involving Grafana and cloud databases. The most frequent failure was hallucinated non-existent libraries or incorrect API usage, with functional capability as the primary barrier and instruction-following quality the key differentiator among competent models. These findings provide empirical guidance for embedded developers on LLM selection and identify limitations of zero-shot prompting for hardware-dependent IoT development. {\textcopyright} 2026 by the authors.},
	language = {English},
	number = {2},
	journal = {Future Internet},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	author = {Babiuch, M. and Smutn{\'y}, P.},
	year = {2026},
	keywords = {LLM, Embedded systems, Language model, Large language model, Software design, Computer hardware, Evaluation framework, Benchmarking, Automated code generation, Computer systems programming, Embedded software, Embedded-system, Functional programming, Cloud database, Distributed database systems, embedded system, Embedded Systems Programming, ESP32, Hardware constraints, IoT, Logic constraints, Logic programming, microcontroller, Microcontrollers},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: M. Babiuch; Department of Control Systems and Instrumentation, VSB{\textemdash}Technical University of Ostrava, Ostrava, 70800, Czech Republic; email: marek.babiuch@vsb.cz; P. Smutn{\'y}; Department of Control Systems and Instrumentation, VSB{\textemdash}Technical University of Ostrava, Ostrava, 70800, Czech Republic; email: pavel.smutny@vsb.cz},
}

