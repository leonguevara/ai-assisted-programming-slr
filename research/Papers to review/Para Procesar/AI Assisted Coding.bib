	year = {2025},
	note = {Journal Abbreviation: Proc. Workshops Int. Conf. High Perform. Comput., Netw., Storage, Anal., SC Workshops},
	keywords = {Chatbots, Semantics, Knowledge management, Large Language Models, Language model, Large language model, Multi-modal, Software design, Human computer interaction, Human engineering, Interactive computer systems, Information use, Information retrieval, Computer systems programming, Retrieval-augmented generation, Query processing, Program documentation, Knowledge based systems, Retrieval-Augmented Generation, Performance computing, ChatBot, Exascale computing, Exascale Computing, High-performance computing user support, HPC User Support, Multimodal RAG, Multimodal retrieval-augmented generation, User support},
