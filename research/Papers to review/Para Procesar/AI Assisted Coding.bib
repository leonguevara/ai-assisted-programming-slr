@inproceedings{zhong_repofusion--decoder_2025,
	title = {{RepoFusion}-in-{Decoder}: {Efficient} {Cross}-{File} {Code} {Completion} via {Lightweight} {Encoder} {Fusion}},
	isbn = {979-833159736-8 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105031116961?origin=resultslist},
	doi = {10.1109/AANN66429.2025.11257694},
	abstract = {Large language model (LLM) based code completion tools have greatly enhanced software development productivity by providing repository-aware suggestions. However, existing state-of-the-art decoder-only LLMs, such as Qwen2.5-Coder-3B, suffer from high latency, particularly due to expensive prefill computations when leveraging long, repository-scale contexts. This latency limits their practical deployment in highly interactive programming environments. In this work, we propose an efficient Fusion-in-Decoder (FiD) architecture that extends a pre-trained, high-quality decoder-only code LM with a lightweight encoder and trainable cross-attention layers, while keeping the decoder frozen. Our approach enables independent encoding and caching of cross-file code chunks, substantially reducing prefill time. We design a two-stage data preparation pipeline leveraging repository-level chunking and BM25-based retrieval to supply realistic multi-file context. Experiments on the Long Code Arena and RepoEval-Updated benchmarks demonstrate that our model achieves significant reductions in end-to-end latency, particularly with long prompts, while sustaining strong code completion performance. Our results highlight the promise of FiD-augmented decoder-only models for low-latency cross-file code completion at scale. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Int. {Conf}. {Adv}. {Algorithms} {Neural} {Networks}, {AANN}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Zhong, Z. and Liu, W. and Yang, C.},
	year = {2025},
	note = {Journal Abbreviation: Int. Conf. Adv. Algorithms Neural Networks, AANN},
	keywords = {Large Language Models, Language model, Large language model, Software design, Model-based OPC, State of the art, Benchmarking, Development productivity, Code completions, Signal encoding, Completion tools, Programming environment, Decoding, Code Completion, Enhanced software, Fusion-in-decoder, Fusion-in-Decoder},
	pages = {366--369},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: Z. Zhong; Wenzhou-Kean University, Department of Computer Science, Wenzhou, China; email: zhongzh@kean.edu; Conference name: 5th International Conference on Advanced Algorithms and Neural Networks, AANN 2025; Conference date: 15 August 2025 through 17 August 2025; Conference code: 217451},
}

@inproceedings{blefari_secflow_2025,
	title = {{SecFlow}: {An} {Agentic} {LLM}-{Based} {Framework} for {Modular} {Cyberattack} {Analysis} and {Explainability}},
	volume = {4075},
	isbn = {16130073 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105020663652?origin=resultslist},
	abstract = {Large Language Models (LLMs) are rapidly reshaping the software engineering landscape, with applications ranging from code synthesis to intelligent assistance in debugging and testing. In this work, we propose SecFlow, a modular agentic framework designed for intelligent classification and contextual explanation of web-based cyberattacks. Unlike traditional detection pipelines, SecFlow integrates fine-tuned LLM-based classifiers and a Retrieval-Augmented Generation (RAG) component into a cohesive architecture, enabling contextualized reasoning and transparent report generation from raw logs. We focus on a single attack vector, Server-Side Template Injection (SSTI), to illustrate the benefits of a dynamic and explainable security pipeline. The system autonomously identifies malicious payloads, retrieves relevant domain knowledge, and produces human-readable reports detailing the nature of the attack, its potential impact, and recommended mitigation strategies. Extensive evaluations show that our approach outperforms monolithic models in accuracy, robustness, and interpretability. Furthermore, the architecture is fully extensible, allowing integration with existing security infrastructures and future inclusion of additional classifiers or automated defense routines. Our findings highlight that LLMs, even without directly generating code, can serve as reliable reasoning agents in software workflows where transparency, explainability, and modular decision-making are critical. {\textcopyright} 2025 Copyright for this paper by its authors.},
	language = {English},
	booktitle = {{CEUR} {Workshop} {Proc}.},
	publisher = {CEUR-WS},
