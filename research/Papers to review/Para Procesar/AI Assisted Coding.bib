	keywords = {Information systems, Semantics, Large Language Models, Language model, Large language model, Requirement engineering, Requirements engineering, Software design, User stories, Information use, Agile software development, System requirements, Manual methods, Requirements Engineering, Freeforms, Information System, Project outcomes, Quality defects, User Story},
