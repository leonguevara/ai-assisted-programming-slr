	keywords = {Software engineering, ChatGPT, software engineering, Students, Codes (symbols), Work-flows, Behavioral research, thematic analysis, Thematic analysis, Artificial intelligence tools, Professional aspects, Philosophical aspects, Auto completion, Behaviour changes, Psychological Aspects, Psychological effects, psychological well-being, Psychological well-being, Self-determination theories, Self-determination theory},
	pages = {385--390},
	annote = {Export Date: 04 May 2026; Cited By: 21; Correspondence Address: M. Valovy; Prague University of Economics and Business, Department of Information Technologies, Prague, Czech Republic; email: marcel.valovy@vse.cz; Conference name: 39th IEEE International Conference on Software Maintenance and Evolution, ICSME 2023; Conference date: 1 October 2023 through 6 October 2023; Conference code: 195314},
