@inproceedings{alharbi_comparative_2025,
	title = {Comparative {Analysis} of {Code} {Quality} {Generated} by {Large} {Language} {Models}},
	isbn = {979-833153559-9 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105037106433?origin=resultslist},
	doi = {10.1109/ICECET63943.2025.11472555},
	abstract = {Recent developments and widespread adoption of Large Language Models (LLMs) have been driven by their groundbreaking success in generating content from human language across various applications. One prominent application is the generation of code in different programming languages. Nowadays, software developers have access to a range of highly advanced AI tools that assist in writing and debugging code. With the growing adoption of AI tools in software development, considerable attention has been directed toward evaluating their capability to generate correct code. However, studying the quality aspects of AI-generated code remains critically important. This paper presents a comparative study of four AI tools based on LLMs: OpenAI's ChatGPT, Google's Gemini, GitHub's Copilot, and Anthropic's Claude. The study aims to analyze software quality metrics for the code generated by these AI tools, providing insights into their effectiveness and utility in software development. The results show that GitHub Copilot generated code with the lowest complexity according to Halstead and McCabe's metrics. However, it scored the lowest in the maintainability index. A detailed analysis of the comparative study's findings is presented in this paper. {\textcopyright} 2025 IEEE.},
