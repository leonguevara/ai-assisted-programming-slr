@inproceedings{wang_evaluation_2025,
	title = {Evaluation of {Code} {Clone} {Detection} {Using} {Large} {Language} {Models}},
	volume = {2025},
	isbn = {27324494 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105006470217?origin=resultslist},
	doi = {10.1049/icp.2025.1037},
	abstract = {Code clone detection has extensive and critical applications in software metrics, plagiarism detection, aspect mining, code compression, and software supply chain vulnerability detection. Traditional token-based and tree-based clone detection methods are effective for syntactically similar clones. However, they often struggle to detect semantic clones{\textemdash}code segments that are semantically and functionally equivalent but syntactically distinct{\textemdash}since functionality similarity is not immediately apparent from syntax alone. This study explores the potential of large language models (LLMs) for code clone detection. By inputting code pairs into LLMs alongside prompt engineering techniques, we evaluated the capacity of LLMs to identify different types of code clones. Through comparative analyses of accuracy and recall rates between LLM-based methods and traditional token-based and tree-based approaches across various code clone types, we aimed to assess the advantages, limitations, and unique capabilities of LLMs in handling complex code similarity tasks. Experimental results demonstrate that LLMs outperform traditional methods in detecting semantic clones, achieving an accuracy of up to 100\% and a recall rate of up to 92\%, underscoring their value in modern software engineering practices. However, LLMs still face limitations, particularly in detecting semantic clones with significant structural differences, necessitating further improvements in future research. {\textcopyright} The Institution of Engineering \& Technology 2025.},
	language = {English},
	number = {2},
	booktitle = {{IET}. {Conf}. {Proc}.},
	publisher = {Institution of Engineering and Technology},
	author = {Wang, X.},
	year = {2025},
	note = {Journal Abbreviation: IET. Conf. Proc.},
	keywords = {LLM, prompt engineering, Prompt engineering, Language model, Large language model, Computer software selection and evaluation, Code clone, Code clone detection, Enterprise software, Software metrics, code clone, Critical applications, JAVA, Plagiarism detection, Recall rate},
	pages = {212--217},
