	title = {Multi-modal {Summarization} in~{Model}-{Based} {Engineering}: {Automotive} {Software} {Development} {Case} {Study}},
	volume = {1567 LNNS},
	isbn = {23673370 (ISSN); 978-303200070-5 (ISBN)},
