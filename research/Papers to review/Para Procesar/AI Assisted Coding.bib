@misc{huang_economics_2024,
	title = {The {Economics} of {Generative} {AI}},
	shorttitle = {The {Economics} of {Generative} {AI}},
	url = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4611256},
	doi = {10.2139/ssrn.4611256},
	abstract = {Generative AI, advanced from traditional AI that focuses on specific work, has fundamentally altered the economics of AI and data. We{\textquoteright}ve developed a dynamic model to illustrate how two key factors{\textemdash}non-rival data and rival computing power{\textemdash}shape the economics of generative AI and reveal market inefficiencies. The economy faces risks such as excessive investment in computing, limitations in generative AI development, and distorted data sharing.},
