	annote = {Export Date: 04 May 2026; Cited By: 86; Correspondence Address: J. Bernardino; Coimbra Institute of Engineering{\textemdash}ISEC, Polytechnic University of Coimbra, Coimbra, Rua Pedro Nunes, 3030-199, Portugal; email: jorge@isec.pt},
}

