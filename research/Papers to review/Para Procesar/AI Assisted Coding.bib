	keywords = {Natural language, Large language models, Programming languages, Software development, Software engineering, Architecture, Design, Collaboration, large language models (LLMs), Workflow, Documentation, Prompt engineering, Case studies, Claude Code (Opus 4.5), Ecosystems, Electronics, Empirical analysis, human{\textendash}AI collaboration, Interactive control, Libraries, prompt-driven development, Qualitative analysis, ring programming language, Subsystems, terminal user interface (TUI), User interfaces},
	pages = {903},
