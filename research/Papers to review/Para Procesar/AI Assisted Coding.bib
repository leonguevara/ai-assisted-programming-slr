	keywords = {Python, Artificial intelligence, software engineering, software testing, Software testing, prompt engineering, code generation, large language models, Prompt engineering, Specifications, Language model, Large language model, Codegeneration, Codes (symbols), Coding errors, Benchmarking, Problem oriented languages, Program compilers, Programming problem, Python code, Model checking, Software testings, Computer systems programming, Computational efficiency, empirical software engineering, Empirical Software Engineering, Explainable artificial intelligence, Clarification, Evaluation of test, explainable artificial intelligence},
	pages = {22801--22821},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: M. Rizqullah; King Abdulaziz University, Faculty of Computing and Information Technology, Department of Computer Science, Jeddah, 21589, Saudi Arabia; email: mrizqullah@stu.kau.edu.sa},
}

@article{yang_glm-4-based_2025,
	title = {{GLM}-4-{Based} {Method} for {Automatic} {Construction} of {Content} {Graph}},
	volume = {13},
	issn = {21693536 (ISSN)},
