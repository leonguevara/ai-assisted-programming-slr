	abstract = {Commit messages are essential for understanding software evolution and maintaining traceability of projects; however, their quality varies across repositories. Recent Large Language Models provide a promising path to automate this task by generating concise context-sensitive commit messages directly from code diffs. This paper provides a comparative study of three paradigms of large language models: zero-shot prompting, retrieval-augmented generation, and fine-tuning, using the large-scale CommitBench dataset that spans six programming languages. We assess the performance of the models with automatic metrics, namely BLEU, ROUGE-L, METEOR, and Adequacy, and a human assessment of 100 commits. In the latter, experienced developers rated each generated commit message for Adequacy and Fluency on a five-point Likert scale. The results show that fine-tuning and domain adaptation yield models that perform consistently better than general-purpose baselines across all evaluation metrics, thus generating commit messages with higher semantic adequacy and clearer phrasing than zero-shot approaches. The correlation analysis suggests that the Adequacy and BLEU scores are closer to human judgment, while ROUGE-L and METEOR tend to underestimate the quality in cases where the models generate stylistically diverse or paraphrased outputs. Finally, the study outlines a conceptual integration pathway for incorporating such models into software development workflows, emphasizing a human-in-the-loop approach for quality assurance. {\textcopyright} 2026 by the authors.},
	language = {English},
	number = {2},
	journal = {Computers},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	author = {Trigui, M.M. and Al-Khatib, W.G. and Amro, M. and Mallouli, F.},
	year = {2026},
	keywords = {Semantics, large language models, retrieval-augmented generation, Quality control, Language model, Large language model, Fine tuning, Automatic programming, Software design, Transformer-based model, Comparative evaluations, Quality assurance, Retrieval-augmented generation, commit message generation, Commit message generation, automatic and human evaluation, Automatic evaluation, Commitbench, CommitBench, Human evaluation, transformer-based models},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: M.M. Trigui; Information \& Computer Science Department (ICS), King Fahd University of Petroleum \& Minerals (KFUPM), Dhahran, 31261, Saudi Arabia; email: g202318370@kfupm.edu.sa; M. Amro; Information \& Computer Science Department (ICS), King Fahd University of Petroleum \& Minerals (KFUPM), Dhahran, 31261, Saudi Arabia; email: mamro@kfupm.edu.sa},
