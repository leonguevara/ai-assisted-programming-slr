}

@inproceedings{liu_cpls_2024,
	title = {{CPLS}: {Optimizing} the {Assignment} of {LLM} {Queries}},
	isbn = {979-835039568-6 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85215523686?origin=resultslist},
	doi = {10.1109/ICSME58944.2024.00024},
	abstract = {Large Language Models (LLMs) like ChatGPT have gained significant attention because of their impressive capabilities, leading to a dramatic increase in their integration into intelligent software engineering. However, their usage as a service with varying performance and price options presents a challenging trade-off between desired performance and the associated cost. To address this challenge, we propose CPLS, a framework that utilizes transfer learning and local search techniques for assigning intelligent software engineering jobs to LLM-based services. CPLS aims to minimize the total cost of LLM invocations while maximizing the overall accuracy. The framework first leverages knowledge from historical data across different projects to predict the probability of an LLM processing a query correctly. Then, CPLS incorporates problem-specific rules into a local search algorithm to effectively generate Pareto optimal solutions based on the predicted accuracy and cost. To evaluate the proposed approach, we conduct extensive experiments on LLM-based log parsing, a typical software maintenance task. Our experimental results demonstrate that CPLS outperforms the baseline methods, providing solutions with the highest accuracy in 14 out of 16 instances. Compared to the baselines, CPLS achieves an accuracy improvement ranging from 1.24\% to 485.54\%, or reduces costs by 15.21\% to 89.09\% while maintaining the highest accuracy achieved by the baselines.  {\textcopyright} 2024 IEEE.},
	language = {English},
	booktitle = {Proc. - {IEEE} {Int}. {Conf}. {Softw}. {Maint}. {Evol}., {ICSME}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Liu, Y. and Zhang, H. and Li, Z. and Miao, Y.},
	year = {2024},
	note = {Journal Abbreviation: Proc. - IEEE Int. Conf. Softw. Maint. Evol., ICSME},
	keywords = {Search engines, Large Language Models, Language model, Large language model, Computer software selection and evaluation, Performance, Model-based OPC, Computer software maintenance, Structured Query Language, Transfer learning, Query languages, Query processing, Cost engineering, Data accuracy, Log parsing, Log Parsing, Cost reduction, High-accuracy, Intelligent software, Cross-project prediction, Cross-project Prediction, Local search, Local Search, Query assignment, Query Assignment},
	pages = {151--162},
