	keywords = {Coding, Maintainability, Artificial intelligence, Large language models, Artificial Intelligence and Image Processing, Computer Software, Information and Computing Sciences, Productivity, Software development, Software engineering, Software quality, Computers--Software, Literature reviews, Systematic review, Trends, Information Systems, Research \& development--R\&D, Human-computer interaction, Readability, Programming, Software development tools, Human-computer interface, Integrated development environment, Longitudinal studies, Programming environments, User experience, User studies, Verification},
