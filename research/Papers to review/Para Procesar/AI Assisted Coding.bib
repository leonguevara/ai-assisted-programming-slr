	keywords = {Software engineering, Information systems, Data structures, Language model, Computer hardware description languages, Human computer interaction, Information use, Mixture of experts, Barycenters, compression, Compression, Computer graphics, Constant time, mixture-of-experts, Modeling parameters, optimal transport, Optimal transport, Space efficient, Time cost, wasserstein barycenter, Wasserstein barycenter},
