	keywords = {Students, Curricula, Engineering education, large language models, Computational linguistics, Language model, Large language model, Software design, Embeddings, Education computing, Learning outcome, Grading, Software engineering course, Computer science and software engineerings, Architecture designs, automatic grading, Automatic grading, Course assessment, embedding, Short answer, short answers, software engineering courses},
