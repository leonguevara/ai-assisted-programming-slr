	year = {2022},
	keywords = {Codegeneration, Codes (symbols), Software design, Application programs, Code generators, Low-code, Internet of things, IoT, Intelligent systems, Graphical user interfaces, actuator, Application codes, Application Servers, code generator, Device application, Distributed intelligent systems, low-code, Network domains, no-code, No-code, Sensor applications, Wireless sensor networks},
	annote = {Export Date: 04 May 2026; Cited By: 12; Correspondence Address: Y.-B. Lin; Department of Computer Science and Information Engineering, Asia University, Taichung City, 413305, Taiwan; email: liny@nctu.edu.tw},
