	keywords = {Code Generation, Codegeneration, Computer hardware description languages, Program processors, C++ (programming language), Embedded software, Metamodeling, Network coding, Neural-networks, Software codes, Model driven architectures, Source lines of codes, metamodeling, CPU architecture, Embedded programming, Mice (computer peripherals), model-driven architecture, Model-driven architecture approaches, model-of-software, Model-of-software},
	pages = {23--30},
