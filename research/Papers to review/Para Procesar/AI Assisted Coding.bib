	keywords = {Maintainability, Artificial intelligence, Software quality, Language model, Requirements engineering, Computer software selection and evaluation, Life cycle, Model-based OPC, Quality assurance, Autonomous agents, Software quality assurance, Software Quality Assurance, Development process, Non-functional requirements, Agent software, AI agent in software engineering, AI Agents in Software Engineering, Nonfunctional requirement, Nonfunctional Requirements (NFRs), Security compliance, Software intensive systems},
