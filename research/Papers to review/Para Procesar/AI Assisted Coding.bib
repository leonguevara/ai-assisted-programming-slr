	isbn = {10972641 (ISSN); 979-833155286-2 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105032382843?origin=resultslist},
	doi = {10.1109/IPCCC66453.2025.11304661},
	abstract = {Large language models (LLMs) have become powerful tools for automated code generation. Yet, they remain prone to both syntax and logic errors that limit their effectiveness in real-world software development. This paper comprehensively evaluates LLM-generated code utilizing the Codeforces Benchmark, and proposes XML-Structured Prompts (XSP) to improve code quality. Specifically, we present three creative strategies: XSP for improving problem comprehension, Syntax-Aware XSP (SA-XSP) for mitigating syntax errors, and Testcase-Driven Logic Error Debugging (TDLED) for resolving logic errors through test case feedback. Our experiments on 30 LLMs, ranging from 0.5 {\textbackslash}mathrm\{\vphantom{\}}B, 70 {\textbackslash}mathrm\{\vphantom{\}}B, to 671 B parameters and including 5 reasoning models, demonstrate that the proposed methods improve accuracy by up to 27.5 \%, especially in smaller models, with syntax error reductions of up to 60 \% and logic error corrections by up to 30\%. {\textcopyright} 2025 IEEE.},
