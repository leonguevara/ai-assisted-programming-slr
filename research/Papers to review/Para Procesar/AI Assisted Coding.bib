	year = {2025},
	note = {Journal Abbreviation: Lect. Notes Networks Syst.},
	keywords = {Large language models, Machine learning, Natural language processing, Workflow, Methodology, Project management, Computational linguistics, Computer aided software engineering, Language model, Large language model, Natural language processing systems, Natural languages, Machine-learning, Application programs, Work-flows, Human computer interaction, Intelligent agents, Learning systems, Behavioral research, Information retrieval, Software agents, Software-tools, Retrieval-augmented generation, Human resource management, Language processing, Learning algorithms, Virtual reality, Learning projects, Intelligent assistants, Machine learning applications, Machine learning project management, Natural language chat, Software tools},
	pages = {448--469},
