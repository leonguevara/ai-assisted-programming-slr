@inproceedings{trinkenreich_get_2025,
	title = {Get on the {Train} or be {Left} on the {Station}: {Using} {LLMs} for {Software} {Engineering} {Research}},
	isbn = {15397521 (ISSN); 979-840071276-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105013964607?origin=resultslist},
	doi = {10.1145/3696630.3731666},
	abstract = {The adoption of Large Language Models (LLMs) is not only transforming software engineering (SE) practice but is also poised to fundamentally disrupt how research is conducted in the field. While perspectives on this transformation range from viewing LLMs as mere productivity tools to considering them revolutionary forces, we argue that the SE research community must proactively engage with and shape the integration of LLMs into research practices, emphasizing human agency in this transformation. As LLMs rapidly become integral to SE research-both as tools that support investigations and as subjects of study-a human-centric perspective is essential. Ensuring human oversight and interpretability is necessary for upholding scientific rigor, fostering ethical responsibility, and driving advancements in the field. Drawing from discussions at the 2nd Copenhagen Symposium on Human-Centered AI in SE, this position paper employs McLuhan{\textquoteright}s Tetrad of Media Laws to analyze the impact of LLMs on SE research. Through this theoretical lens, we examine how LLMs enhance research capabilities through accelerated ideation and automated processes, make some traditional research practices obsolete, retrieve valuable aspects of historical research approaches, and risk reversal effects when taken to extremes. Our analysis reveals opportunities for innovation and potential pitfalls that require careful consideration. We conclude with a call to action for the SE research community to proactively harness the benefits of LLMs while developing frameworks and guidelines to mitigate their risks, to ensure continued rigor and impact of research in an AI-augmented future. {\textcopyright} 2025 Copyright held by the owner/author(s).},
	language = {English},
	booktitle = {Proc {ACM} {SIGSOFT} {Symp} {Found} {Software} {Eng}},
	publisher = {Association for Computing Machinery},
	author = {Trinkenreich, B. and Calefato, F. and Hanssen, G. and Blincoe, K. and Kalinowski, M. and Pezz{\`e}, M. and Tell, P. and Storey, M.-A.},
	editor = {{Li J.}},
	year = {2025},
	note = {Journal Abbreviation: Proc ACM SIGSOFT Symp Found Software Eng},
	keywords = {Artificial intelligence, LLM, Automation, Generative AI, Information systems, Engineering research, Language model, Large language model, Computer software, Software engineering research, AI4SE, Software engineering practices, Risk assessment, Human agency, Mcluhan{\textquoteright}s tetrad, McLuhan{\textquoteright}s Tetrad, Productivity tools, Research communities},
	pages = {1503--1507},
