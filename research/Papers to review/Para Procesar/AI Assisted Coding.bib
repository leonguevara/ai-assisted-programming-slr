@inproceedings{xu_prompt_2025,
	title = {Prompt {Learning} for {Source} {Code} {Summarization}},
	isbn = {26939177 (ISSN); 978-166547771-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105018801145?origin=resultslist},
	doi = {10.1109/QRS65678.2025.00028},
	abstract = {Source) code summarization is the task of automatically generating natural language summaries (also called comments) for given code snippets. Recently, with the successful application of large language models (LLMs) in numerous fields, software engineering researchers have also attempted to adapt LLMs to solve code summarization tasks. The main adaptation schemes include instruction prompting, taskoriented (full-parameter) fine-tuning, and parameter-efficient fine-tuning (PEFT). However, instruction prompting involves designing crafted prompts and requires users to have professional domain knowledge, while task-oriented fine-tuning requires high training costs, and effective, tailored PEFT methods for code summarization are still lacking. In this paper, we propose an effective prompt learning framework for code summarization called PromptCS. It no longer requires users to rack their brains to design effective prompts. Instead, PromptCS trains a prompt agent that can generate continuous prompts to unleash the potential for LLMs in code summarization. Compared to the human-written discrete prompt, the continuous prompts are produced under the guidance of LLMs and are therefore easier to understand by LLMs. PromptCS is non-invasive to LLMs and freezes the parameters of LLMs when training the prompt agent, which can greatly reduce the requirements for training resources. We evaluate the effectiveness of PromptCS on the CodeSearchNet dataset. Experimental results show that PromptCS significantly outperforms instruction prompting schemes (including zero-shot learning and few-shot learning) on all four widely used metrics, including BLEU, METEOR, ROUGE-L, and SentenceBERT, and is comparable to the task-oriented fine-tuning scheme. In some base LLMs, e.g., CodeGen-Multi-2B and StarCoderBase-1B and -3B, PromptCS even outperforms the task-oriented fine-tuning scheme. More importantly, the training efficiency of PromptCS is faster than the task-oriented fine-tuning scheme, with a more pronounced advantage on larger LLMs. The results of the human evaluation demonstrate that PromptCS can generate more good summaries compared to baselines.  {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {{IEEE} {Int}. {Conf}. {Softw}. {Qual}., {Reliab}. {Secur}., {QRS}},
	publisher = {Institute of Electrical and Electronics Engineers},
	author = {Xu, T. and Fang, C. and Qian, H. and Feng, X. and Sun, W.},
	year = {2025},
	note = {Journal Abbreviation: IEEE Int. Conf. Softw. Qual., Reliab. Secur., QRS},
	keywords = {large language model, Language model, Large language model, Codes (symbols), Tuning, Fine tuning, Natural languages, Source codes, Application programs, Learning systems, Parameter-efficient fine-tuning, Prompt learning, parameter-efficient fine-tuning, Zero-shot learning, Task-oriented, Adaptation scheme, prompt learning, source code summarization, Source code summarization},
	pages = {176--188},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: X. Feng; City University of Macau, Faculty of Data Science, Macao; email: xiafeng@cityu.edu.mo; Conference name: 25th International Conference on Software Quality, Reliability and Security, QRS 2025; Conference date: 16 July 2025 through 20 July 2025; Conference code: 213332},
}

@inproceedings{ramirez_exploring_2025,
	title = {Exploring the {Relationship} {Between} {Code} {Metrics} and the {Ability} of {Large} {Language} {Models} to {Solve} {Code} {Issues}},
	isbn = {979-835035692-2 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105021618967?origin=resultslist},
	doi = {10.1109/CogInfoCom66819.2025.11200869},
	abstract = {Large Language Models (LLMs) are increasingly integrated into software engineering workflows, assisting with tasks such as code generation, unit testing, and bug resolution. Despite their growing use, limited research has examined how code-level metrics such as Halstead complexity, maintainability index, and source lines of code correlate with issue resolution rates for LLM-powered agents when modifying existing codebases. The paper bridges the well established field of code metrics with the emerging domain of AI software engineering agents by exploring correlations between these metrics and the success of LLM driven agents in resolving GitHub issues. The key contribution is a quantitative analysis of the relationship between code metrics and LLM agent issue resolution success. Preliminary results show varying degrees of biserial correlation across models, with coefficients reaching 0. 4 for maintainability index and issue resolution. These findings suggest that code metrics can inform the evaluation of LLM coding agents and offer insights into improving models and finding indicators of issue resolution success. This research underscores the importance of maintainable, high-quality code not only for human developers but also for LLM-driven agents. Our hypothesis is that LLMs can generate correct patches or semi-automated fixes more successfully when the underlying codebase already exhibits strong maintainability and code quality metrics. Furthermore, as LLM-generated code becomes part of long-lived software products-reviewed, integrated, and extended by both humans and potentially future LLM agents-its maintainability and quality remain critical.  {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {{IEEE} {Int}. {Conf}. {Cogn}. {Infocommunications}, {CogInfoCom}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Ramirez, O. and Ekler, P.},
	year = {2025},
	note = {Journal Abbreviation: IEEE Int. Conf. Cogn. Infocommunications, CogInfoCom},
	keywords = {Maintainability, Software quality, Software testing, Language model, Codegeneration, Codes (symbols), Computer programming languages, Model-driven, Software agents, Issue resolutions, Model agents, Unit testing, Engineering workflows, Code metrics, Generation units, Source lines of codes},
	pages = {101--107},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: O. Ramirez; Colorado College, Colorado Springs, United States; email: o\_ramirez@coloradocollege.edu; Conference name: 16th IEEE International Conference on Cognitive Infocommunications, CogInfoCom 2025; Conference date: 8 September 2025 through 9 September 2025; Conference code: 214080},
}

@inproceedings{khan_applying_2025,
	title = {Applying {Just}-{In}-{Time} {Learning} {Strategies} to {Equip} {Students} with {Project} {Management} {Tools} and {Knowledge}},
	isbn = {15394565 (ISSN); 979-833150105-1 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105033064573?origin=resultslist},
	doi = {10.1109/FIE63693.2025.11328146},
	abstract = {This innovative practice full paper explores how just-in-time teaching can improve students' practical skills in Git and project management tools within undergraduate software engineering courses. Many students struggle with applying GitHub workflows confidently, often resorting to self-learning via inconsistent or unreliable sources, including large language models. To address this, we designed and evaluated an instructional model that combines short, instructor-curated video tutorials, guided hands-on exercises, and immediate formative quizzes. These modules cover essential Git commands (git init, branching, merges), collaborative workflows (pull requests, project boards), and best practices. Our findings suggest that this just-in-time approach supports strong short-term knowledge acquisition, with students performing well in topic-aligned quizzes. However, some confidence gaps remain in complex topics, such as GitHub Projects and advanced. gitignore usage. These results highlight the potential of just-in-time, quiz-embedded instruction while suggesting the need for extended team-based practice to support deeper mastery. {\textcopyright} 2025 IEEE.},
