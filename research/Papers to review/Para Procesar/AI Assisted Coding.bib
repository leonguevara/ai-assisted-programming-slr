	keywords = {Language model, Codegeneration, Computer software selection and evaluation, Computer hardware description languages, Hardware-software codesign, Benchmarking, Problem oriented languages, C++ (programming language), Digital storage, Design generation, Code languages, Description languages, Hardware descriptions, Hardware design, High level synthesis, High-level synthesis, Integrated circuit design, Software programming, Synthesis design},
	pages = {988--994},
