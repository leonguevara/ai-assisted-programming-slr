	keywords = {Decision making, Software testing, Large Language Models, Cyber threats, Language model, Large language model, Application programs, Computation theory, Network security, Intelligent agents, Classification (of information), Modulars, Agentic retrieval-augmented generation, Agentic Retrieval-Augmented Generation, Computer crime, Cybe threat detection, Cyber Threat Detection, Cyber-attacks, Fine-tuned security classifier, Fine-tuned Security Classifiers, Intrusion detection, Intrusion Detection Systems, Threat detection},
	annote = {Export Date: 04 May 2026; Cited By: 2; Correspondence Address: C. Cosentino; University of Calabria, Rende, Via Pietro Bucci, 87036, Italy; email: cristian.cosentino@unical.it; Conference name: 2025 Generative Code Intelligence Workshop, GeCoIn 2025; Conference date: 26 October 2025 through 26 October 2025; Conference code: 213915},
