@article{valdivia_generative_2026,
	title = {Generative {Artificial} {Intelligence} for {Software} {Development} {Using} {ISO}/{IEC} 29110 {Basic} {Profile}: {Gaps} and {Opportunities}},
	volume = {14},
	issn = {21693536 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105029599591?origin=resultslist},
	doi = {10.1109/ACCESS.2026.3659713},
	abstract = {This study conducted a PRISMA-based systematic literature review of 52 primary studies published between 2022 and 2024 indexed in Scopus, Web of Science, and Springer. The objective of this study was to examine how generative artificial intelligence can be applied to software development in small and medium-sized software development enterprises adopting the ISO/IEC 29110 Basic Profile. This review identified six predominant generative artificial intelligence methods (e.g., large language models and prompt engineering), 32 key tools (e.g., ChatGPT and GitHub Copilot), five metric categories (efficiency, productivity, quality, precision, and user satisfaction), and 29 emerging roles (e.g., prompt engineering and machine learning engineers). The analysis reveals notable gaps in the application of generative artificial intelligence within specific process groups of the Basic Profile, particularly in Project Management (Project Plan Execution, Project Assessment and Control, and Project Closure) and Software Implementation (Implementation Initiation and Product Assembly). To address these gaps, this study proposes a structured alignment framework that maps the identified generative artificial intelligence methods, tools, metrics, and roles to the requirements of the ISO/IEC 29110 Basic Profile. Derived from a systematic synthesis of the literature, this framework highlights opportunities for generative artificial intelligence that support standard-compliant adoption across the software development lifecycle. This provides actionable guidance to small- and medium-sized software development enterprises. Future research directions include empirical validation through industrial case studies and the integration of software quality assurance mechanisms within generative artificial intelligence-enabled processes.  {\textcopyright} 2013 IEEE.},
	language = {English},
	journal = {IEEE Access},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Valdivia, J. and Mauricio, D. and Guzman-Jimenez, R.},
	year = {2026},
	keywords = {Generative artificial intelligence, Artificial intelligence, Software engineering, Software quality, generative artificial intelligence, Project management, Computer aided software engineering, Language model, Software design, Computer software selection and evaluation, Software development process, Systematic literature review, Learning systems, Quality assurance, Software-tools, Enterprise software, ISO Standards, ISO/IEC, Industrial research, Software metrics, Artificial intelligence methods, Compliant mechanisms, software development processes, Software role, software roles, software tools and metrics, Web of Science},
	pages = {31358--31377},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: R. Guzman-Jimenez; Universidad de Lima, Program Systems Engineering, Department of Engineering, Lima, 15023, Peru; email: rguzman@ulima.edu.pe},
