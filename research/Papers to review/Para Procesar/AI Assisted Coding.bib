	year = {2025},
	note = {Journal Abbreviation: Front. Artif. Intell. Appl.},
	keywords = {Semantics, Data structures, User interfaces, Metamodels, Cost effectiveness, Open source software, Computational linguistics, Language model, Large language model, Syntactics, Natural language processing systems, Software design, Open systems, Open-source, Large Language Models (LLM), Code development, Domains specific languages, Meta model, Model-driven Engineering, Digital subscriber lines, DSL, Language generation, Development platform, Low-code development platform, Low-Code Development Platform, Model Driven Engineering},
