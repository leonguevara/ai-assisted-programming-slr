	keywords = {Large language models, Speech recognition, Computational linguistics, Language model, Large language model, Software design, User stories, Agile manufacturing systems, Requirements elicitation, Requirements gathering, Agile software development, Automatic speech recognition, Manual methods, Requirement elicitation, Speech communication, Speech-to-text, Voice conversation},
