	author = {Vitale, A. and Oliveto, R. and Scalabrino, S.},
	year = {2025},
	keywords = {Software quality, Language model, Software design, Computer software selection and evaluation, Systematic literature review, Software developer, Pre-training, Massive data sets, data quality, Data quality, Systematic Literature Review, Data smell, data smells, Large language model for coding task, LLMs for coding tasks, Root problems, Training and testing},
	annote = {Export Date: 04 May 2026; Cited By: 2; Correspondence Address: A. Vitale; Automatica e Informatica, Politecnico di Torino, Torino, Italy; email: antonio.vitale@polito.it; CODEN: ATSME},
}

@article{zhang_cloud-assisted_2026,
	title = {Cloud-assisted {LLM}-enhanced datasets for {AST} hierarchy-aware code summarization model},
	volume = {15},
	issn = {2192113X (ISSN)},
	url = {https://www.scopus.com/pages/publications/105034486896?origin=resultslist},
	doi = {10.1186/s13677-026-00852-2},
	abstract = {Code summarization is an important task in software engineering that helps developers understand and maintain code by generating natural language summaries. Existing approaches predominantly rely on single models, facing a dilemma: directly deploying large language models (LLMs) incurs high training costs, while lightweight models specialized for summarization are constrained by the quality of training data and their ability to capture the complex structural semantics of code. This highlights the urgent need for synergistic collaboration between large and small models in cloud computing environments. To address these issues, this paper proposes a cloud-assisted code summarization framework. First, we achieve code enhancement by invoking cloud-deployed LLM services. The specific workflow involves using preset prompt templates to guide the model in evaluating code quality and automatically repairing defects based on its feedback, thereby constructing high-quality datasets Java-QE and Python-QE. Second, for efficient edge deployment, we introduce HiSum: AST Hierarchy-Aware Code Summarization model, a lightweight model. HiSum transforms code AST into Directed Syntax Graphs (DSG) to preserve structural semantics, encodes them via a directed graph convolutional network and decode to improve summary quality. Experimental results show that our framework significantly enhances code summarization performance. On the constructed Java-QE and Python-QE datasets, the HiSum model achieves notable improvements over state-of-the-art baselines in BLEU, METEOR, and ROUGE-L metrics (increases of 1.06\%, 1.98\%, 3.12\% for Java-QE, and 1.46\%, 3.24\%, 2.20\% for Python-QE, respectively). This research provides a solution that utilizes cloud LLM-assisted data enhancement to empower a lightweight hierarchical-aware model. {\textcopyright} The Author(s) 2026.},
	language = {English},
	number = {1},
	journal = {Journal of Cloud Computing},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Zhang, J. and Yan, Y. and Han, J. and Lu, A. and Guo, J. and Pourzamani, J.},
	year = {2026},
	keywords = {Python, Large language models, Semantics, Computational linguistics, Language model, Large language model, Large datasets, Natural language processing systems, Natural languages, Training data, High level languages, Java programming language, Computer software, Code summarization, Convolutional codes, Cloud-edge collaboration, Directed graphs, Single models, Structural semantics, Summarization models, Training costs},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: J. Pourzamani; Faculty of Administration and Economics, Department of Management, University of Isfahan, Isfahan, Iran; email: javadpourzamani@mail.ir},
}

