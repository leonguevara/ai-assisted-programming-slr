	keywords = {Syntactics, Codegeneration, Codes (symbols), Software design, Electronics design automation, Performance, Evaluation framework, Computer aided design, Benchmarking, Power, Specific tasks, Comprehensive assessment, Functional areas, Matching performance, RTL codes},
