@inproceedings{zeng_coderujb_2024,
	address = {Vienna Austria},
	title = {{CoderUJB}: {An} {Executable} and {Unified} {Java} {Benchmark} for {Practical} {Programming} {Scenarios}},
	isbn = {979-8-4007-0612-7},
	shorttitle = {{CoderUJB}},
	url = {https://dl.acm.org/doi/10.1145/3650212.3652115},
