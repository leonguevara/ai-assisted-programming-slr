@article{li_transferfuzz-pro_2025,
	title = {{TransferFuzz}-{Pro}: {Large} {Language} {Model} {Driven} {Code} {Debugging} {Technology} for {Verifying} {Propagated} {Vulnerability}},
	volume = {51},
	issn = {00985589 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105009944537?origin=resultslist},
	doi = {10.1109/TSE.2025.3584774},
	abstract = {Code reuse in software development frequently facilitates the spread of vulnerabilities, leading to imprecise scopes of affected software in CVE reports. Traditional methods focus primarily on detecting reused vulnerability code in target software but lack the ability to confirm whether these vulnerabilities can be triggered in new software contexts. In previous work, we introduced the TransferFuzz framework to address this gap by using historical trace-based fuzzing. However, its effectiveness is constrained by the need for manual intervention and reliance on source code instrumentation. To overcome these limitations, we propose TransferFuzz-Pro, a novel framework that integrates Large Language Model (LLM)-driven code debugging technology. By leveraging LLM for automated, human-like debugging and Proof-of-Concept (PoC) generation, combined with binary-level instrumentation, TransferFuzz-Pro extends verification capabilities to a wider range of targets. Our evaluation shows that TransferFuzz-Pro is significantly faster and can automatically validate vulnerabilities that were previously unverifiable using conventional methods. Notably, it expands the number of affected software instances for 15 CVE-listed vulnerabilities from 15 to 53 and successfully generates PoCs for various Linux distributions. These results demonstrate that TransferFuzz-Pro effectively verifies vulnerabilities introduced by code reuse in target software and automatically generation PoCs. {\textcopyright} 1976-2012 IEEE.},
	language = {English},
	number = {8},
	journal = {IEEE Transactions on Software Engineering},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Li, S. and Xie, K. and Li, Y. and Li, H. and Ren, Y. and Sun, L. and Zhu, H.},
	year = {2025},
	keywords = {Code reuse, Verification, large language model, Language model, Large language model, Codes (symbols), Automatic programming, Software design, Program debugging, Model-driven, Computer software reusability, Computer debugging, Manual intervention, Code debugging, Fuzzing, code reuse, fuzzing, Historical trace, Source Code Instrumentation, Vulnerability verification},
	pages = {2396--2411},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: Y. Li; The University of New South Wales, School of Computer Science and Engineering, Sydney, 2052, Australia; email: yuekang.li@unsw.edu.au; Y. Ren; Chinese Academy of Sciences, Institute of Information Engineering, Beijing, 100089, China; email: renyimo@iie.ac.cn; CODEN: IESED},
}

@inproceedings{tunc_leveling_2025,
	title = {Leveling {Up} {Software} {Project} {Management} {Education}: {From} {Manual} {Mastery} to {AI} {Empowerment}},
	isbn = {25211641 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105030827815?origin=resultslist},
	doi = {10.1109/UBMK67458.2025.11206923},
	abstract = {The integration of generative artificial intelligence (AI) tools, particularly large language models, into software engineering education presents both significant opportunities and pedagogical challenges. A central concern lies in achieving an effective balance between leveraging AI-driven efficiencies and maintaining the development of critical thinking and practical skills. This study introduces a two-phase instructional framework. In the initial phase, students undertake core project planning tasks manually to establish foundational competencies. In the subsequent phase, they employ AI tools during a capstone exercise designed to simulate real-world scenarios. The model was implemented within an undergraduate software project management course. Observations from the first phase indicated recurring challenges in visual planning tasks, which informed the selection and application of AI tools in the second phase. Student reflections suggest enhanced proficiency in AI usage and prompt engineering; however, ethical awareness remained limited. The findings underscore the value of a scaffolded pedagogical approach that emphasizes manual mastery prior to AI adoption and provide a replicable framework for cultivating AI literacy aligned with industry expectations in software engineering education.  {\textcopyright} 2025 IEEE.},
	language = {English},
	number = {2025},
