@article{tsai_how_2025,
	title = {How to {Build} an {AI} {Governance} {Framework} with {Data} {Governance}},
	volume = {Part F285},
	issn = {22114548 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105002787218?origin=resultslist},
	doi = {10.1007/978-3-031-85478-1_10},
	abstract = {The rapid proliferation of Generative Artificial Intelligence (GenAI) has fundamentally altered operational paradigms across various industries, enhancing efficiencies in domains such as software development, document summarization, and content creation. While AI-driven automation has been integral to manufacturing and supply chain industries for decades, the advent of large language models has catalyzed the widespread adoption of AI-driven decision-making. This accelerated integration necessitates a critical examination of governance structures to address transparency, accountability, and ethical concerns. Traditional data governance frameworks, designed to ensure data integrity, consistency, and compliance, provide a foundational model for AI governance. Given AI{\textquoteright}s reliance on extensive datasets, expanding governance principles to encompass AI-specific challenges{\textemdash}such as algorithmic bias, ethical oversight, and regulatory compliance{\textemdash}is imperative. A structured AI governance framework should integrate established data governance capabilities, including data lineage documentation, quality monitoring, and role-based accountability structures, while addressing AI-specific risks related to bias mitigation, transparency, and ethical deployment. Furthermore, organizations must adapt risk management frameworks, particularly the {\textquotedblleft}three lines of defense{\textquotedblright} model, to incorporate AI-specific oversight mechanisms. As global regulatory landscapes evolve, proactive governance strategies are essential to ensuring AI systems align with ethical standards and legal requirements. This paper argues that by extending well-established data governance principles to AI, enterprises can enhance trust, mitigate risks, and foster responsible AI adoption. The application of rigorous governance methodologies will be crucial in shaping the future trajectory of AI, ensuring its responsible deployment while safeguarding societal and organizational interests. {\textcopyright} The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	journal = {SpringerBriefs in Philosophy},
	publisher = {Springer Science and Business Media B.V.},
	author = {Tsai, P.},
	year = {2025},
	keywords = {Data governance, Data management, Ethical AI governance, Ethics of AI},
	pages = {171--186},
	annote = {Export Date: 04 May 2026; Cited By: 2; Correspondence Address: P. Tsai; Newyork, United States; email: peggytsai923@gmail.com},
}

@article{alsaedi_leveraging_2024,
	title = {Leveraging {Large} {Language} {Models} for {Automated} {Bug} {Fixing}},
	volume = {15},
	issn = {2158107X (ISSN)},
	url = {https://www.scopus.com/pages/publications/85214023217?origin=resultslist},
	doi = {10.14569/IJACSA.2024.0151247},
	abstract = {Bug fixing, which is known as Automatic Program Repair (APR), is a significant area of research in the software engineering field. It aims to develop techniques and algorithms to automatically fix bugs and generate fixing patches in the source code. Researchers focus on developing many APR algorithms to enhance software reliability and increase the productivity of developers. In this paper, a novel model for automated bug fixing has been developed leveraging large language models. The proposed model accepts the bug type and the buggy method as inputs and outputs the repaired version of the method. The model can localize the buggy lines, debug the source code, generate the correct patches, and insert them in the correct locations. To evaluate the proposed model, a new dataset which contains 53 Java source code files from four bug classes which are Program Anomaly, GUI, Test-Code and Performance has been presented. The proposed model successfully fixed 49 out of 53 codes using gpt-3.5-turbo and all 53 using gpt-4-0125-preview. The results are notable, with the model achieving accuracies of 92.45\% and 100\% with gpt-3.5-turbo and gpt-4-0125-preview, respectively. Additionally, the proposed model outperforms several state-of-the-art APR models as it fixes all 40 buggy programs in QuixBugs benchmark dataset. {\textcopyright} (2024), (Science and Information Organization). All Rights Reserved.},
	language = {English},
	number = {12},
	journal = {International Journal of Advanced Computer Science and Applications},
