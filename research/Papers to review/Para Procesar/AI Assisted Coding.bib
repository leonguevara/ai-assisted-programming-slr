@inproceedings{ananda_ratmayanti_improving_2025,
	title = {Improving {Requirement} {Comprehension} in {GPT} {Models} for {Enhanced} {Consistency} in {Test} {Case} {Generation}},
	isbn = {979-833157571-7 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105031609361?origin=resultslist},
	doi = {10.1109/ICoSEIT67010.2025.11290782},
	abstract = {Test case generation is an essential component in the software testing lifecycle. Despite its importance, generating test cases automatically using Large Language Models such as GPT remains a challenging task. One of the most persistent issues observed is the inconsistency of generated outputs in terms of format, structure, and quantity, even when the input requirements are highly similar. Such inconsistencies reduce reliability, increase the need for human intervention, and limit the applicability of LLMs in real-world Quality Assurance practices. To address this limitation, this paper introduces a method aimed at enhancing the consistency of generated test cases by improving the model's comprehension of requirements through a continual domain-adaptive pretraining approach. In this method, the GPT model is continually trained on functional requirements collected from a hospital management system, which are preprocessed using Natural Language Processing techniques to minimize ambiguity, normalize linguistic variations, and capture domain-specific patterns that reinforce contextual understanding. The performance of the pretrained model is then systematically compared with the baseline ChatGPT model using three evaluation metrics. Experimental results demonstrate that the proposed model achieves 100\% requirement coverage, records a significantly higher Jaccard similarity score of 0.78, and consistently generates executable test cases with a stable structure that aligns with best practices in software testing. These findings highlight the effectiveness of continual pretraining in improving requirement comprehension, reducing variability in generated outputs, and ultimately contributing to the development of more reliable, consistent, and scalable automated software testing workflows.  {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Int. {Conf}. {Softw}. {Eng}. {Inf}. {Technol}., {ICoSEIT}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Ananda Ratmayanti, P.V. and Sulistiyo Kusumo, D. and Riskiana, R.R.},
	year = {2025},
	note = {Journal Abbreviation: Int. Conf. Softw. Eng. Inf. Technol., ICoSEIT},
	keywords = {Automation, Software testing, test case generation, Computer aided software engineering, Medical computing, Natural language processing systems, Life cycle, NLP, Model checking, Software testings, Test case, Test case generation, Automatic test pattern generation, Quality assurance, Pre-training, Software testing automation, Testing automation, Biomedical engineering, continual pretraining, Continual pretraining, hospital information system, Hospital information systems, Hospitals, jaccard similarity, Jaccard similarity, Management information systems, Selenia testing, selenium testing, software testing automation},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: P.V. Ananda Ratmayanti; Telkom University, School of Computing, Bandung, Indonesia; email: vidyaratmayanti@student.telkomuniversity.ac.id; Conference name: 2025 3rd International Conference on Software Engineering and Information Technology, ICoSEIT 2025; Conference date: 8 October 2025 through 9 October 2025; Conference code: 218274},
