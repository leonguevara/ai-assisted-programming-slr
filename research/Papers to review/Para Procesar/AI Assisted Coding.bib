	keywords = {Artificial intelligence, Semantics, Specifications, AI models, Language model, Syntactics, Requirement engineering, Requirements engineering, Software design, WEB application, Web applications, Management systems, AI model, Empirical evaluations, Case-studies, Business rules, empirical evaluation, functional specification, Functional specification, requirement engineering, web application},
