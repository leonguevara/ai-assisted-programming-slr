}

@article{mukherjee_prompt_2026,
	title = {Prompt {Recovery} from {Source} {Code}: {A} {Comparative} {Study} of {Large} {Language} {Models}},
	volume = {14},
	issn = {21693536 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105034814854?origin=resultslist},
	doi = {10.1109/ACCESS.2026.3678864},
	abstract = {This article presents a rigorous empirical study on prompt recovery, the task of inferring the original natural language instruction from a given source code snippet. We evaluate four state-of-the-art Large Language Models (LLMs): OpenAI's GPT-4o-mini, Google's Gemini-2.5-Flash, Meta's llama3.2:3B, and DeepSeek's DeepSeek-R1-Distill-Qwen-1.5B models on their ability to recover prompts from Python code. The analysis also investigates the impact of code degradation (via variable renaming and comment removal), which serves as a proxy for poorly documented legacy systems. Additionally a preliminary study of generative sampling temperature effects was conducted using OpenAI's GPT model. We evaluate performance using a comprehensive suite of metrics, including BLEU, ROUGE, BERTScore, and Levenshtein Distance. Our findings reveal that while code cleaning degrades lexical similarity scores (e.g., average BLEU scores for OpenAI are 20\% lower), it consistently maintains semantic similarity (e.g., average BERT-F1 remains above 0.90). This suggests that in the absence of lexical cues, models are forced to rely on deeper algorithmic reasoning and structural understanding of source code. Comparative analysis shows cloud-hosted models exhibit superior semantic fidelity, while DeepSeek-R1 demonstrates competitive character-level accuracy. These results provide critical insights into the code comprehension capabilities of modern LLMs and have significant implications for their application in reverse engineering, legacy system documentation, and the development of more robust evaluation benchmarks for code intelligence.  {\textcopyright} 2013 IEEE.},
	language = {English},
	journal = {IEEE Access},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Mukherjee, A.},
	year = {2026},
	keywords = {Semantics, software engineering, reverse engineering, Reverse engineering, large language models, Language model, Large language model, Codes (symbols), Model evaluation, Natural language processing systems, Source codes, Benchmarking, Computer software, Code comprehension, Legacy systems, Comparatives studies, code degradation, Code degradation, Large language model evaluation, LLM evaluation, prompt recovery, Prompt recovery, Recovery},
	pages = {49714--49728},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: A. Mukherjee; University of Detroit Mercy, Department of Electrical and Computer Engineering and Computer Science, Detroit, 48221, United States; email: amukher@udmercy.edu},
}

@inproceedings{more_rag-guardrails_2026,
	title = {{RAG}-{Guardrails} {Integration} for {AI} {Content} {Control}},
	isbn = {979-840071858-8 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105035804121?origin=resultslist},
	doi = {10.1145/3783862.3783896},
	abstract = {Generative AI, particularly large language models (LLMs), has shown remarkable potential across domains such as healthcare, legal services, and finance. However, their adoption is hindered by two persistent challenges: hallucination-where models generate factually incorrect information-and the risk of producing biased or unsafe content. This paper proposes a hybrid framework that integrates Retrieval-Augmented Generation (RAG) with NVIDIA NeMo Guardrails to address these concerns. RAG mitigates hallucinations by grounding model outputs in externally retrieved, trusted data sources, while NeMo Guardrails enforce domain-specific safety and compliance constraints through predefined behavioral policies. Empirical evaluations demonstrate that this combined approach reduces hallucinated content by 30-45\% and improves safety and policy adherence across multiple enterprise use cases. The system exhibits strong potential for deployment in regulated, high-stakes environments. Future work will focus on enhancing real-time responsiveness and expanding multilingual and culturally adaptive capabilities. The proposed framework offers a scalable foundation for building trustworthy, domain-aligned generative AI solutions. {\textcopyright} 2025 Copyright held by the owner/author(s).},
