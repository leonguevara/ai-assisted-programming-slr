@article{mao_blueprint2code_2025,
	title = {{Blueprint2Code}: a multi-agent pipeline for reliable code generation via blueprint planning and repair},
	volume = {8},
	issn = {26248212 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105020276760?origin=resultslist},
	doi = {10.3389/frai.2025.1660912},
	abstract = {Automated programming has become a powerful tool for solving real-world problems. Code generation, in particular, plays a key role in improving developer productivity and reducing the entry barrier to software development. Recent advances in large language models (LLMs) have significantly improved program synthesis, enabling high-quality code generation from natural language. However, LLMs still struggle with complex tasks, especially in understanding problem intent, conducting multi-step reasoning, and producing code that passes all test cases. As task difficulty increases, existing models often fail to devise complete and reliable generation strategies, leading to reduced accuracy and robustness. To address these limitations, we propose Blueprint2Code, an innovative multi-agent framework for code generation. It emulates the human programming workflow through the coordinated interaction of four agents{\textemdash}Previewing, Blueprint, Coding, and Debugging{\textemdash}forming a closed-loop system from task comprehension to planning, implementation, and iterative refinement. Compared to existing methods, Blueprint2Code shows superior performance on complex programming tasks. Extensive experiments on benchmark datasets{\textemdash}HumanEval, MBPP, their extended versions (HumanEval-ET, MBPP-ET), and the APPS competition dataset{\textemdash}demonstrated its effectiveness, achieving strong pass@1 results: HumanEval 96.3\%, MBPP 88.4\%, HumanEval-ET 86.5\%, MBPP-ET 59.4\%, and APPS 24.6\%. The related code is available at https://github.com/MKH99918/Blueprint2Code. Copyright {\textcopyright} 2025 Mao, Hu, Lin, Li, Lu and Zhang.},
	language = {English},
	journal = {Frontiers in Artificial Intelligence},
	publisher = {Frontiers Media SA},
	author = {Mao, K. and Hu, B. and Lin, R. and Li, Z. and Lu, G. and Zhang, Z.},
	year = {2025},
	keywords = {automated debugging, code generation, large language models, multi-agent systems, program synthesis, blueprint planning},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: B. Hu; School of Information Science and Technology, Hangzhou Normal University, Hangzhou, China; email: Bourne@hznu.edu.cn},
}

@inproceedings{paul_llms_2025,
