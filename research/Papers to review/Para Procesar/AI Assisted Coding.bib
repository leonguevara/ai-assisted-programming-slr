	keywords = {Python, Language model, Codegeneration, Codes (symbols), Software design, Application programs, Green computing, Performance, Power, Energy utilization, C++ (programming language), Empirical evaluations, Energy efficiency, Mobile applications, Code completions, Energy, Critical software, System applications, System servers},
	pages = {49--60},
