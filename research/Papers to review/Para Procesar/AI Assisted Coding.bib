	address = {Clarion Hotel Trondheim Trondheim Norway},
	title = {{CoSEFA}: {An} {LLM}-{Based} {Programming} {Assistant} for {Secure} {Code} {Generation} via {Supervised} {Co}-{Decoding}},
	isbn = {979-8-4007-1276-0},
