	annote = {Export Date: 04 May 2026; Cited By: 3; Correspondence Address: A. Kudriavtseva; Leiden University, Leiden, Netherlands; email: a.kudriavtseva@liacs.leidenuniv.nl; Conference name: 40th Annual ACM Symposium on Applied Computing, SAC 2025; Conference date: 31 March 2025 through 4 April 2025; Conference code: 208932},
