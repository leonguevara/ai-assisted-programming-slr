@article{johnson_ai_nodate,
	title = {The {AI} {Productivity} {Paradox} in {Software} {Development}: {A} {Meta}-{Analysis} of {Implementation} {Outcomes} and {ROI} {Patterns} (2024{\textendash}2025)},
	abstract = {Background: The software industry has seen substantial investment in artificial intelligence technologies, with enterprise spending increasing from \$600 million to \$13.8 billion between 2023{\textendash}2024. Despite widespread adoption claims, systematic analysis of implementation outcomes remains limited.
Objective: To conduct a meta-analysis of AI implementation patterns, productivity outcomes, and return on investment across software organizations, examining the divergence between perceived benefits and measurable business impact.
Methods: We synthesized data from 47 peer-reviewed studies, industry reports, and controlled trials conducted between January 2024 and September 2025. Our analysis included 12 randomized controlled trials of developer productivity, longitudinal studies of 211 million lines of code, enterprise adoption surveys covering 77,000 organizations, and ROI analyses from 1,247 software companies.
Results: Controlled studies revealed a perception-reality gap: while 90\% of developers reported improved productivity with AI coding assistants, randomized trials showed 19\% slower task completion under specific experimental conditions. Code quality analysis demonstrated a 4x increase in code cloning and 45\% security vulnerability rates in AIgenerated code. Traditional machine learning implementations achieved 100{\textendash}300\% ROI with 42\% enterprise adoption, while generative AI initiatives showed high pilot failure rates despite substantial investment.
Conclusions: The software industry exhibits patterns consistent with misallocation of AI investments, with proven traditional ML technologies underdeployed while generative AI receives disproportionate resources. Organizations achieving positive outcomes follow distinct patterns: executive-level governance, focused use case selection, and vendor partnerships over internal development.},
	language = {en},
	author = {Johnson, Chris and Yenamandra, Teja and Ciskey, Joe and Ambrogi, Tomas and Olmedo, Luciano},
	file = {PDF:/Users/lguevara/Zotero/storage/TT2XPP63/Johnson et al. - The AI Productivity Paradox in Software Development A Meta-Analysis of Implementation Outcomes and.pdf:application/pdf},
}

@misc{lyu_my_2025,
	title = {"{My} productivity is boosted, but ..." {Demystifying} {Users}' {Perception} on {AI} {Coding} {Assistants}},
	url = {http://arxiv.org/abs/2508.12285},
	doi = {10.48550/arXiv.2508.12285},
	abstract = {This paper aims to explore fundamental questions in the era when AI coding assistants like GitHub Copilot are widely adopted: what do developers truly value and criticize in AI coding assistants, and what does this reveal about their needs and expectations in real-world software development? Unlike previous studies that conduct observational research in controlled and simulated environments, we analyze extensive, first-hand user reviews of AI coding assistants, which capture developers{\textquoteright} authentic perspectives and experiences drawn directly from their actual day-to-day work contexts. We identify 1,085 AI coding assistants from the Visual Studio Code Marketplace. Although they only account for 1.64\% of all extensions, we observe a surge in these assistants: over 90\% of them are released within the past two years. We then manually analyze the user reviews sampled from 32 AI coding assistants that have sufficient installations and reviews to construct a comprehensive taxonomy of user concerns and feedback about these assistants. We manually annotate each review{\textquoteright}s attitude when mentioning certain aspects of coding assistants, yielding nuanced insights into user satisfaction and dissatisfaction regarding specific features, concerns, and overall tool performance. Built on top of the findings{\textemdash}including how users demand not just intelligent suggestions but also context-aware, customizable, and resource-efficient interactions{\textemdash}we propose five practical implications and suggestions to guide the enhancement of AI coding assistants that satisfy user needs.},
	language = {en},
	urldate = {2026-04-17},
	publisher = {arXiv},
	author = {Lyu, Yunbo and Yang, Zhou and Shi, Jieke and Chang, Jianming and Liu, Yue and Lo, David},
	month = aug,
	year = {2025},
	note = {arXiv:2508.12285 [cs]},
	keywords = {Computer Science - Software Engineering, Computer Science - Artificial Intelligence, Computer Science - Human-Computer Interaction},
