@inproceedings{qin_let_2025,
	title = {Let the {Code} {Speak}: {Incorporating} {Program} {Dynamic} {State} for {Better} {Method}-{Level} {Fault} {Localization}},
	isbn = {979-835035733-2 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105034671091?origin=resultslist},
	doi = {10.1109/ASE63991.2025.00072},
	abstract = {Fault localization (FL) is a critical but time-consuming part of software debugging. With the improvement of the Large Language Models (LLMs) in their code capabilities, the increasing demand for automated software development has encouraged more research on building LLM-based Fault Localization (LLMFL) systems. However, existing LLMFL techniques are typically restricted to predicting bug locations by analyzing static code, while overlooking crucial dynamic program state of the software. This lack of context makes LLMs prone to generating "hallucinations", incorrectly identifying bug-free code as suspicious. To address this, this paper introduces PingFL, the LLMFL system that incorporates program dynamic information for more accurate automatic fault localization. PingFL comprises a Fault Localization (FL) agent and a Print Debugging (PD) agent. The FL agent is tasked with understanding the root cause through a set of callable tools. When the FL agent nominates a location as suspicious, it would entrust the PD agent to verify the suspected issue through multiple rounds of print debugging. In particular, these two agents communicate efficiently by conveying the textual thought generated by the LLM. The evaluation on 812 real-world bugs from the Defects4J benchmark shows that PingFL can localize 450 bugs within Top-1, which significantly outperforms other LLM-based approaches by 41\% to 122\%. A deeper dive into PingFL's performance reveals that it exhibits specific FL strategies and tool usage patterns even without explicit instructions. Finally, PingFL proves to be cost-effective, spending an average of 0.23 and 104.62 seconds per bug, with the print debugging mechanism accounting for only 0.07 and 48.14 seconds. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Proc. - {IEEE}/{ACM} {Int}. {Conf}. {Autom}. {Softw}. {Eng}., {ASE}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Qin, Y. and Wang, S. and Lin, B. and Peng, X. and Ouyang, S. and Chen, L. and Mao, X.},
	year = {2025},
	note = {Journal Abbreviation: Proc. - IEEE/ACM Int. Conf. Autom. Softw. Eng., ASE},
	keywords = {Language model, Large language model, Codes (symbols), Software design, Model-based OPC, Program debugging, Large Language Model, Dynamics, Fault localization, Fault Localization, Computer debugging, Software debugging, Code capability, Localisation Systems, Localization technique, Print debugging, Print Debugging, Time-consuming parts},
	pages = {804--815},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: S. Wang; National University of Defense Technology, College of Computer Science and Technology, China; email: wangshangwen13@nudt.edu.cn; Conference name: 2025 40th IEEE/ACM International Conference on Automated Software Engineering, ASE 2025; Conference date: 16 November 2025 through 20 November 2025; Conference code: 220073},
}

@inproceedings{gokalp_chatgpt_2025-1,
	title = {{ChatGPT} {Based} {Best} {Practices} for {Pair} {Programming}},
	isbn = {25211641 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105030820822?origin=resultslist},
	doi = {10.1109/UBMK67458.2025.11206910},
	abstract = {The integration of large language models (LLMs) like ChatGPT into software engineering workflows has sparked interest in their capacity to assist with programming tasks. While these models are often praised for enhancing productivity and reducing cognitive effort, their limitations, particularly in handling complex logic, remain underexplored. This study investigates the practical effects of ChatGPT support in a structured programming environment by applying an exploratory case study with two embedded scenarios: one with ChatGPT assistance and one without. The same task was attempted under both conditions, allowing for a direct comparison of solution correctness, efficiency, and error resolution. Results show that ChatGPT can help generate accurate code and reduce completion time for moderately complex tasks. At the same time, its effectiveness may vary based on the nature of the error and the complexity of the problem. This case study contributes to the growing body of empirical evidence on how generative AI tools affect software development processes in real-world conditions.  {\textcopyright} 2025 IEEE.},
	language = {English},
	number = {2025},
