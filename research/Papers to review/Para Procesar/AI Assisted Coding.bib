	abstract = {Recommender systems are essential for information filtering but often suffer from the cold start problem caused by limited interaction data. Recent advances in deep learning (DL) and large language models (LLMs) have shown promise, yet systematic analysis of their effectiveness remains scarce. To address this gap, we introduce a paradigm-driven taxonomy that categorizes solutions by their primary source of information: content, structure, transfer, and generation. Within this framework, DL methods have matured in leveraging content and structural information from interaction logs and multimodal data, while LLMs demonstrate advantages in text-rich and data-sparse environments through transfer-based paradigms that exploit semantic understanding and pre-trained knowledge. Furthermore, emerging generative approaches show potential for synthesizing data or relations to alleviate information scarcity. No universal solution exists; effectiveness depends on the dominant paradigm of a given scenario as well as data availability and computational cost. Combining DL and LLM offers substantial opportunities, including enhanced feature representation, data augmentation, and hybrid pipelines. However, research gaps persist, particularly the lack of standardized evaluation metrics and limited exploration of integration strategies. Addressing these challenges through a paradigm-aware perspective could significantly improve the robustness and adaptability of the cold-start recommendation in diverse contexts. This article is categorized under: Application Areas {\textgreater} Data Mining Software Tools Technologies {\textgreater} Machine Learning Technologies {\textgreater} Artificial Intelligence. {\textcopyright} 2026 Wiley Periodicals LLC.},
	language = {English},
	number = {1},
	journal = {Wiley Interdisciplinary Reviews: Data Mining and Knowledge Discovery},
	publisher = {John Wiley and Sons Inc},
	author = {Liu, C. and Jiang, D. and Cai, Y. and Li, H.},
	year = {2026},
	keywords = {Semantics, Deep learning, deep learning, recommender systems, Recommender systems, large language models, Computer aided software engineering, Language model, Large language model, Application programs, Learning systems, Data mining, cold start problem, Cold start problems, Information contents, Information filtering, Information generation, Information paradigm, information paradigms, Primary sources, Sources of informations, Starting, Systematic analysis},
	annote = {Export Date: 04 May 2026; Cited By: 1; Correspondence Address: D. Jiang; College of Information Science and Technology, Beijing University of Chemical Technology, Beijing, China; email: jdg@mail.buct.edu.cn; H. Li; College of Information Science and Technology, Beijing University of Chemical Technology, Beijing, China; email: ray@mail.buct.edu.cn},
}

