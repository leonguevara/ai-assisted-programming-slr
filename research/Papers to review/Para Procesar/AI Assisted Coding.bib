@inproceedings{li_defending_2025,
	title = {Defending {Llms} {Against} {Jailbreak} {Prompts} {Through} {Key} {Information} {Protection} and {Selective} {Compression}},
	isbn = {26939177 (ISSN); 978-166547771-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105018799181?origin=resultslist},
	doi = {10.1109/QRS65678.2025.00017},
	abstract = {With the widespread application of Large Language Models (LLMs) in the field of natural language processing and software engineering, security vulnerabilities have emerged as a critical concern. Among these, jailbreak attacks represent a prevalent security threat, as they bypass the internal security checks of the model through carefully designed input perturbations, generating malicious outputs which severely may compromise the reliability and security of the LLM-based software tools. Existing defense methods based on reinforcement learning and fine-tuning often suffer from limited generalization, low interpretability, and high computational overhead. To address these limitations, we propose MaskedDefender, a novel defense approach that detects potential attack features by analyzing model's response differences to various inputs. Guided by the principle of key information protection and selective compression, MaskedDefender identifies critical tokens associated with jailbreak attacks by optimizing the gradient of a multi-objective loss function. It then applies soft guidance to steer the model's attention toward these critical tokens. Our approach highlights jailbreak intentions and reduces the model's confusion in identifying such attacks without modifying model parameters. Experimental results show that MaskedDefender outperforms existing defense methods in enabling the model to detect and resist jailbreak attacks, while maintaining both efficiency and effectiveness.  {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {{IEEE} {Int}. {Conf}. {Softw}. {Qual}., {Reliab}. {Secur}., {QRS}},
	publisher = {Institute of Electrical and Electronics Engineers},
	author = {Li, S. and Zhou, Y. and Zhang, X. and Han, T.},
	year = {2025},
	note = {Journal Abbreviation: IEEE Int. Conf. Softw. Qual., Reliab. Secur., QRS},
	keywords = {Artificial intelligence, Software reliability, Security systems, Computer aided software engineering, Language model, Natural languages, Application programs, Network security, Learning systems, Security vulnerabilities, Language processing, Multi-objectives optimization, Multiobjective optimization, Information protection, Jailbreak attack, Mask generation, Multi-objective optimization, Security defense, Selective compression},
	pages = {58--67},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: Y. Zhou; College of Computer Science and Technology, Nanjing University of Aeronautics and Astronautics, Nanjing, Jiangsu, China; email: zhouyu@nuaa.edu.cn; Conference name: 25th International Conference on Software Quality, Reliability and Security, QRS 2025; Conference date: 16 July 2025 through 20 July 2025; Conference code: 213332},
}

