	keywords = {Software quality, Verification, Computer aided software engineering, Software design, Computer operating systems, Software packages, Software prototyping, Computer software maintenance, Reusability, Automated generation, Circuit components, Circuit synthesis, Quantum channel, Quantum circuit, quantum circuit synthesis, Quantum circuit synthesis, quantum computing, Quantum Computing, quantum software automatic generation, Quantum software automatic generation, quantum software engineering, Quantum software engineering, Qubits, Software automatic generations, Truth tables},
	pages = {1389--1407},
	annote = {Export Date: 04 May 2026; Cited By: 1; Correspondence Address: I. Garc{\'i}a-Rodr{\'i}guez; Institute of Technologies and Information Systems, University of Castilla-La Mancha, Ciudad Real, Spain; email: ignacio.grodriguez@uclm.es; CODEN: SPEXB},
