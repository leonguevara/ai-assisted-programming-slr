	year = {2025},
	keywords = {LLM, Open source software, Language model, Software design, Open systems, Human computer interaction, Application programming interfaces (API), Static analysis, Data flow analysis, Software development kit, API, Component based, Digital devices, Digital representations, End-user programming, End-user Programming, End-users, Internet protocols, IoT device component, IoT Device Component, Physical devices, SDK, Static Analysis},
	annote = {Export Date: 04 May 2026; Cited By: 1; Correspondence Address: W. Chen; Institute of Software, Chinese Academy of Sciences, University of Chinese Academy of Sciences, Nanjing Institute of Software Technology, China; email: wchen@otcaix.iscas.ac.cn},
