	note = {arXiv:2403.03344 [cs]},
	keywords = {Computer Science - Software Engineering, Computer Science - Artificial Intelligence},
	file = {PDF:/Users/lguevara/Zotero/storage/ZKCJUAQ8/Vartziotis et al. - 2024 - Learn to Code Sustainably An Empirical Study on LLM-based Green Code Generation.pdf:application/pdf},
}

