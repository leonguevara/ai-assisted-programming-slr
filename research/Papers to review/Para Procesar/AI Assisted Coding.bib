	note = {Journal Abbreviation: Proc. - IEEE/ACM Int. Workshop Responsible AI Engineering, RAIE},
	keywords = {Software quality, Feedback, Large Language Models, Formal verification, Quality control, Language model, Large language model, Software design, Model-driven-development, Computer software selection and evaluation, Quality assurance, Formal specification, Software quality assurance, Software Quality Assurance, Compliance control, Formal Method, Large language model-driven development, LLM-Driven Development, Software compliance, Software failure, Software verification, Stakeholder engagement},
