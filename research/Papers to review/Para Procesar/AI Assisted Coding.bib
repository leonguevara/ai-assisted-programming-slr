	doi = {10.1109/ACCESS.2026.3661069},
	abstract = {In modern software development, developers frequently introduce comments that describe temporary solutions, incomplete implementations, or deferred improvements. These comments, commonly referred to as Self-Admitted Technical Debt (SATD), may provide short-term flexibility but can accumulate into long-term maintenance challenges and quality degradation. This paper presents a systematic literature review of automated SATD detection research published between 2015 and 2025. Following established systematic review guidelines, we analyzed 46 primary studies selected from an initial pool of 1,537 publications. The review provides a structured synthesis of the field by: 1) identifying and categorizing the main SATD detection objectives; 2) analyzing representation techniques for textual, structural, and hybrid inputs; 3) comparing learning approaches ranging from traditional machine learning to transformer-based and large language models; and 4) summarizing evaluation practices and performance trends. Our findings reveal a clear methodological evolution from keyword-based and feature-engineered models toward context-aware and multi-modal architectures. While transformer-based approaches such as BERT and CodeBERT demonstrate strong potential, their adoption is constrained by limited benchmark datasets, inconsistent evaluation protocols, and a lack of explainability. To address these challenges, the review highlights key research gaps and outlines future directions, including standardized benchmarks, explainable SATD detection, and cross-project generalization. Overall, this study consolidates a decade of SATD research into a unified perspective and provides actionable guidance for developing more robust, interpretable, and scalable SATD detection techniques to support sustainable software maintenance. {\textcopyright} 2013 IEEE.},
	language = {English},
	journal = {IEEE Access},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Abdulaziz, A. and Sonbol, R. and Alnoukari, M.},
	year = {2026},
	keywords = {Natural language processing, Software quality, Deep learning, deep learning, Sustainable development, systematic literature review, machine learning, Natural language processing systems, Natural languages, Software design, Machine-learning, Computer software selection and evaluation, Systematic literature review, Learning systems, Computer software maintenance, Software Quality, Reviews, Technical debt detection, Technical debts, Language processing, Learning algorithms, Transformer modeling, Self-admitted technical debt, natural language processing, Modal analysis, software quality, technical debt detection, transformer models},
	pages = {20803--20825},
	annote = {Export Date: 04 May 2026; Cited By: 1; Correspondence Address: A. Abdulaziz; Higher Institute for Applied Sciences and Technology (HIAST), Damascus, Syrian Arab Republic; email: anas.abdulaziz@hiast.edu.sy},
}

@inproceedings{cui_comprehensive_2025,
	title = {Comprehensive {Evaluation} of {LLMs} in {HPC} {Code} {Performance} {Optimization}},
	isbn = {979-840072109-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105026447404?origin=resultslist},
	doi = {10.1145/3750720.3757280},
	abstract = {Large Language Models (LLMs) have emerged as powerful tools for software development tasks such as code completion, translation, and optimization. However, their ability to generate efficient and correct code, particularly in complex High-Performance Computing (HPC) contexts, has remained underexplored. To address this gap, this paper presents a comprehensive benchmark suite encompassing multiple critical HPC computational motifs to evaluate the performance of code optimized by state-of-the-art LLMs, including OpenAI o1, Claude-3.5, and Llama-3.2, as well as HPC-Coder, a model tuned specifically for HPC tasks. In addition to analyzing basic computational kernels, we developed a workflow that integrates LLMs to assess their effectiveness in real HPC applications. Our evaluation focused on key criteria such as execution time, correctness, and understanding of HPC-specific concepts. We also compared the results with those achieved using traditional HPC optimization tools. Based on the findings, we recognized the strengths of LLMs in understanding human instructions and performing automated code transformations. However, we also identified significant limitations, including their tendency to generate incorrect code and their challenges in comprehending complex control and data flows in sophisticated HPC code.  {\textcopyright} 2025 Copyright held by the owner/author(s).},
