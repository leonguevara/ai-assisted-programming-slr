@inproceedings{vragard_generative_2024,
	title = {Generative {AI} in {Higher} {Education}: {Educators}' {Perspectives} on {Academic} {Learning} and {Integrity}},
	volume = {23},
	isbn = {20488637 (ISSN)},
	url = {https://www.scopus.com/pages/publications/85215681176?origin=resultslist},
	abstract = {Generative Artificial Intelligence (Gen AI), exemplified by models such as ChatGPT, has rapidly advanced, becoming a significant force in various sectors, including higher education. ChatGPT, a leading application of Gen AI, utilizes large language models (LLMs) to generate human-like text, providing capabilities that range from answering complex questions to facilitating software development. As these tools become increasingly integrated into academic environments, their impact on teaching and learning processes has become more under focus. However, there are not many studies focusing on the impact of such systems on students{\textquoteright} performance and the use of such systems. This study therefore examines the impact of GPT tools on higher education, aiming to address the following research questions: How does the use of GPTs influence the teaching and learning process in higher education? What are the perceived impacts of GPTs on educational practices from university educators{\textquoteright} perspective? The research employs a qualitative methodology, incorporating semi-structured interviews with educators from Swedish universities who have integrated GPT into their curricula. Data were transcribed and analysed using OpenAI's Whisper to extract key themes and insights. Data analysis was done through thematic analysis and categorizing the data using codes. The study uncovers a dual impact of GPT on education, while it offers substantial opportunities for enhancing productivity and personalized learning, it also raises significant concerns about academic integrity, over-reliance on AI, and the potential influences on students{\textquoteright} soft skills. These findings contribute to the discourse on digital learning by highlighting the need for instructional and constructive integration of AI technologies such as GenAI, in educational settings. In addition, the rise and integration of GPT technology is irreversible, and we must adapt to it rather than return to old ways. Embracing AI's potential while addressing its challenges is essential for progress and innovation in this new era. The study emphasizes the importance of developing clear policies and guidelines to ensure that the benefits of GPT are realized without compromising the integrity of the educational process. As such, this research provides valuable insights for educators, policymakers, and scholars interested in the ethical and effective implementation of AI in higher education. {\textcopyright} 2024 Academic Conferences Limited. All rights reserved.},
	language = {English},
	number = {1},
	booktitle = {Proc. {Eur}. {Conf}. e-{Learn}., {ECEL}},
	publisher = {Academic Conferences and Publishing International Limited},
	author = {Vr{\r a}g{\r a}rd, J. and Brorsson, F. and Aghaee, N.},
	editor = {{Moriera F.}},
	year = {2024},
	note = {Journal Abbreviation: Proc. Eur. Conf. e-Learn., ECEL},
	keywords = {ChatGPT, Generative AI, Academic integrity, Higher education, Students, Generative adversarial networks, Language model, Adversarial machine learning, Contrastive Learning, Application programs, Federated learning, Ethical technology, Human like, High educations, Learning process, Teaching and learning, Digital learning, Digital-learning, Teaching process},
	pages = {406--414},
	annote = {Export Date: 04 May 2026; Cited By: 11; Conference name: 23rd European Conference on e-Learning, ECEL 2024; Conference date: 24 October 2024 through 25 October 2024; Conference code: 205752},
}

@article{subahi_bert-based_2023,
	title = {{BERT}-{Based} {Approach} for {Greening} {Software} {Requirements} {Engineering} {Through} {Non}-{Functional} {Requirements}},
	volume = {11},
	issn = {21693536 (ISSN)},
	url = {https://www.scopus.com/pages/publications/85173002983?origin=resultslist},
	doi = {10.1109/ACCESS.2023.3317798},
	abstract = {The incorporation of sustainability principles during the requirements engineering phase of the development life cycle constitutes greening software requirements. This incorporation can have a variety of effects on the software design employed in modern and cutting-edge information technology (IT) systems. When sustainability principles are incorporated into requirements engineering, software design priorities can change and address current design issues such as energy and resource consumption, modularity, maintainability, and adaptability. In contrast to other green approaches that consider sustainable development, there is a further need to investigate the relationship between software development and the relevant green principles of sustainability during the requirements engineering phase. We present a new mechanism for mapping software nonfunctional requirements (NFRs) to defined dimensions of green software sustainability, consisting of two mapping steps: 1) between NFRs and sustainability dimensions; and 2) between sustainability dimensions and two clusters of green IT aspects defined in this work. The overall architecture of the promising approach is based on the use of the Bidirectional Encoder Representations from Transformers (BERT) language model with an expanded dataset. We consider transfer learning and domain-specific fine-tuning capabilities for constructing and evaluating a model specifically tailored for developing a proof of concept of the greening software requirements engineering task, as language models have recently emerged as a potent technique in the field of software engineering, with numerous applications in code analysis, automated documentation, and code generation. In addition, we test the model's performance using an extended version of the PROMISE\_exp dataset after adding a new binary classification column for categorizing sustainability dimensions into two defined clusters: Eco-technical and Socioeconomic, and having a selected domain expert label the raw data. The model's efficiency is evaluated using four matrices - 1) accuracy; 2) precision; 3) recall; and 4) F1 score - across a variety of epoch and batch sizes. Our numerical results demonstrate the viability of the approach in text classification tasks via performing well in mapping NFRs to software sustainability dimensions. This acts as a proof of concept for automating the sustainability measurement of software awareness at the early development stage. In addition, the results emphasize the importance of domain-specific fine-tuning and transfer learning for obtaining high performance in classification tasks in requirements engineering.  {\textcopyright} 2013 IEEE.},
	language = {English},
	journal = {IEEE Access},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Subahi, A.F.},
	year = {2023},
	keywords = {Software, Sustainable development, Engineering education, BERT, Computational linguistics, Language model, Requirement engineering, Requirements engineering, Software design, Application programs, Statistical tests, Software-systems, Mapping, Classification (of information), Text processing, requirements engineering, Sustainable softwares, Professional aspects, Green software engineering, Requirements classifications, Non-functional requirements, Bidirectional encoder representation from transformer, Task analysis, language model, Green information technology, green IT, Green products, Non-functional requirement classification, non-functional requirements classification, sustainable software system, Sustainable software system},
	pages = {103001--103013},
	annote = {Export Date: 04 May 2026; Cited By: 23; Correspondence Address: A.F. Subahi; University College of Al Jamoum, Umm Al-Qura University, Department of Computer Science, Makkah, 21421, Saudi Arabia; email: afsubahi@uqu.edu.sa},
}

@inproceedings{jobst_delphi_2025,
	title = {Delphi: {A} {Natural} {Language} {Interface} for 2.{5D} {Treemap} {Visualization} of {Source} {Code}},
