	note = {Journal Abbreviation: Lect. Notes Networks Syst.},
	keywords = {Semantics, Language model, Large language model, Syntactics, Codes (symbols), Computer programming languages, Software design, Large Language Model, Integration testing, Model checking, Software testings, Test scripts, Information retrieval, Software Testing, Test Automation, Contextual information, Continuous integrations, Test code, Robots, Human intervention, Robot framework, Robot Framework},
