@inproceedings{velasco_how_2025,
	title = {How {Propense} {Are} {Large} {Language} {Models} at {Producing} {Code} {Smells}? {A} {Benchmarking} {Study}},
	isbn = {02705257 (ISSN); 979-833153711-1 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105008497880?origin=resultslist},
	doi = {10.1109/ICSE-NIER66352.2025.00025},
	abstract = {Large Language Models (LLMs) have shown significant potential in automating software engineering tasks, particularly in code generation. However, current evaluation benchmarks, which primarily focus on accuracy, fall short in assessing the quality of the code generated by these models, specifically their tendency to produce code smells. To address this limitation, we introduce CodeSmellEval, a benchmark designed to evaluate the propensity of LLMs for generating code smells. Our benchmark includes a novel metric: Propensity Smelly Score (PSC), and a curated dataset of method-level code smells: CodeSmellData. To demonstrate the use of CodeSmellEval, we conducted a case study with two state-of-the-art LLMs, CodeLlama and Mistral. The results reveal that both models tend to generate code smells, such as simplifiable-condition and consider-merging-isinstance. These findings highlight the effectiveness of our benchmark in evaluating LLMs, providing valuable insights into their reliability and their propensity to introduce code smells in code generation tasks.  {\textcopyright} 2025 IEEE.},
