	keywords = {large language models, Language model, Large language model, Computer software selection and evaluation, empirical software engineering, Empirical Software Engineering, Enterprise software, Taxonomies, Software supply chains, Software failure, Engineering works, news analysis, News analyze, News articles, software failure analysis, Software failure analyze, Work standards},
