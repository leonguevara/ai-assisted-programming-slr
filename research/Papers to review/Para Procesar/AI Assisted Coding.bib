	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: J.C. Sep{\'u}lveda Montoya; Universidad Tecnol{\'o}gica de Pereira, Facultad de Ingenier{\'i}as, Pereira, 660003, Colombia; email: camilo.sepulveda@utp.edu.co},
