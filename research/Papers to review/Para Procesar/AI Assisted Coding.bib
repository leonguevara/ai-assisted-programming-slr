	keywords = {Requirements engineering, Natural language processing systems, Software design, Domain model, Software modeling, Natural languages texts, Software requirements, Benchmark datasets, Model transformation, Requirements document, Software functional requirement, Benchmark dataset, Software analysis, Software functional requirements, Software models, Text-to-model transformation},
