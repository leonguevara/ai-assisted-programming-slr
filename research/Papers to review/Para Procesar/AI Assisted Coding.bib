@inproceedings{silva_evaluating_2026,
	title = {Evaluating the~{Quality} of~{User} {Stories}: {An} {Extended} {Comparative} {Study} of~{Multiple} {LLMs} and~{Rule}-{Based} {Tools}},
	volume = {578 LNBIP},
	isbn = {18651348 (ISSN); 978-303222374-6 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105035619701?origin=resultslist},
	doi = {10.1007/978-3-032-22375-3_10},
	abstract = {Background: Ensuring the quality of user stories is vital to Agile Software Development. Rule-based tools like AQUSA, based on the Quality User Story (QUS) framework, offer reliable structural checks but struggle with context-sensitive or pragmatic issues. Large Language Models (LLMs) have emerged as potential alternatives, yet prior studies often rely on small datasets, older models, or lack direct comparison with rule-based baselines. Objective: This study aims to assess the effectiveness of modern LLMs relative to a rule-based tool (AQUSA) for detecting defects in user stories, considering both structural and contextual dimensions. Method: We conduct a large-scale comparative evaluation involving AQUSA and three GPT-family LLMs (GPT-5, GPT-5-mini, and GPT-4), using 182 user stories drawn from three industrial datasets. We apply both quantitative metrics (precision, recall, F1-score) and qualitative analysis of feedback clarity and defect relevance. Results: GPT-5-mini achieved the highest recall (0.81) and overall F1-score (0.62), while AQUSA attained the highest precision (0.61) with significantly fewer false positives. GPT-5 showed high hallucination rates and instability; GPT-4 was overly conservative, leading to under-detection of defects. Conclusion: Neither rule-based nor GPT-family LLM-based approaches suffice in isolation. Rule-based tools enforce structural rigor, while LLMs capture nuanced linguistic and pragmatic flaws. We advocate a hybrid {\textquotedblleft}Dual-gate{\textquotedblright} strategy{\textemdash}using AQUSA for structural validation followed by lightweight LLMs for contextual refinement{\textemdash}to improve the reliability and scalability of user story quality assessment in agile environments. {\textcopyright} The Author(s) 2026.},
	language = {English},
	booktitle = {Lect. {Notes} {Bus}. {Inf}. {Process}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Silva, I. and Paiva, J. and Perkusich, M. and Albuquerque, D. and Dantas, E. and Gorg{\^o}nio, K. and Perkusich, A.},
	editor = {{Goldman A.} and {Marczak S.} and {Tonin G.S.} and {Bassi D.} and {Silva da Silva T.} and {Sch{\"o}n E.-M.} and {Neumann M.} and {Pinna A.}},
	year = {2026},
	note = {Journal Abbreviation: Lect. Notes Bus. Inf. Process.},
	keywords = {Defects, Large Language Models, Prompt engineering, Language model, Large language model, Large datasets, Requirement engineering, Requirements engineering, Software design, User stories, Agile manufacturing systems, Agile requirement engineering, Agile requirements, Agile Requirements Engineering, AQUSA tool, AQUSA Tool, Prompt Engineering, Quality assessment, Quality Assessment, Quality user story framework, QUS Framework, User Stories},
	pages = {155--174},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: I. Silva; VIRTUS Research, Development and Innovation Center, Federal University of Campina Grande, Campina Grande, PB, 58429-900, Brazil; email: izabella.silva@virtus.ufcg.edu.br; Conference name: 27th International Conference on Agile Software Development, XP 2026; Conference date: 8 April 2026 through 11 April 2026; Conference code: 349819},
