@inproceedings{espinoza_novel_2025,
	title = {A {Novel} {Framework} for {Intuitive} {E}-commerce {Design}: {Leveraging} {Large} {Language} {Models} to {Translate} {User} {Commands} into {Functional} {Code}},
	isbn = {26400154 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105033212559?origin=resultslist},
	doi = {10.1109/ISCMI67495.2025.11358555},
	abstract = {This study evaluates the performance of leading Large Language Models for generating front-end code for e-commerce applications from natural language commands, aiming to lower technical barriers for entrepreneurs. The models analyzed include GPT-4.5, Llama 4 Maverick, Claude 4 Sonnet, and Mistral Medium 3. These models were benchmarked on a standardized set of 10 front-end generation tasks under controlled conditions, with fixed system prompts and generation parameters. The evaluation employed a multi-faceted suite of metrics including Functional Success Rate, Structural Adherence Score, Code Quality Score, and a Time-Cost analysis. While proprietary models achieved the highest quality scores, Llama 4 Maverick emerged as the most suitable model, providing the best balance between robust performance and operational efficiency. Based on these findings, this study proposes the integration of the mentioned model into a no-code web application, offering a practical and accessible tool for startups to build digital stores. {\textcopyright} 2025 IEEE.},
