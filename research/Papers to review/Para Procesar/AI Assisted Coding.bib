@article{sirigiri_ai_2025,
	title = {{AI} {IN} {DEVOPS}: {A} {FRAMEWORK} {FOR} {PREDICTIVE} {MAINTENANCE} {AND} {AUTOMATED} {ISSUE} {RESOLUTION}},
	volume = {38},
