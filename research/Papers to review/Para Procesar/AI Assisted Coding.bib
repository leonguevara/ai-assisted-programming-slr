	pages = {393--399},
	annote = {Export Date: 04 May 2026; Cited By: 25; Conference name: 18th ACM/IEEE International Symposium on Empirical Software Engineering and Measurement, ESEM 2024; Conference date: 24 October 2024 through 25 October 2024; Conference code: 204097},
