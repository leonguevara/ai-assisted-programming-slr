	annote = {Snippet: {\textellipsis} threat, we collect 76 LLM-based code generation papers {\textellipsis} ofcoding tasks (eg, the length of code generation instructions, the code problem difficulty, and labels) and the similarity metrics {\textellipsis}},
	file = {PDF:/Users/lguevara/Zotero/storage/Y7HS6ZRW/Ouyang et al. - 2024 - An Empirical Study of the Non-Determinism of ChatCPT in Code Generation.pdf:application/pdf},
