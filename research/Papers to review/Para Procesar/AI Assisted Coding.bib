	pages = {2240--2253},
	annote = {Export Date: 04 May 2026; Cited By: 15; Correspondence Address: M. Nashaat; Port Said University, Department of Electrical Engineering, Port Said, 42526, Egypt; email: MonaNashaat@eng.psu.edu.eg; CODEN: IESED},
