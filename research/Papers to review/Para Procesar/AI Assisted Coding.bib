	keywords = {Automation, Large Language Models (LLMs), Software testing, Prompt engineering, Language model, Large language model, Natural language processing systems, Software testings, Test case, Test case generation, Automatic test pattern generation, Software-systems, Economic and social effects, Automated test-case generations, Natural language requirements, System functions},
	pages = {260--281},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: O. Karmouda; SogetiLabs part of Capgemini, Issy-les-Moulineaux, France; email: ouafae.karmouda@sogeti.com; Conference name: Future Technologies Conference, FTC 2025; Conference date: 6 November 2025 through 7 November 2025; Conference code: 341289},
