@inproceedings{mosquera_assisted-modeling_2022,
	title = {Assisted-{Modeling} {Requirements} for {Model}-{Driven} {Development} {Tools}},
	volume = {446 LNBIP},
	isbn = {18651348 (ISSN); 978-303105759-5 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85130923359?origin=resultslist},
	doi = {10.1007/978-3-031-05760-1_27},
	abstract = {Model-driven development (MDD) tools allow software development teams to increase productivity and decrease software time-to-market. Although several MDD tools have been proposed, they are not commonly adopted by software development practitioners. Some authors have noted MDD tools are poorly adopted due to a lack of user assistance during modeling-related tasks. This has led model-driven engineers{\textemdash}i.e., engineers who create MDD tools{\textemdash}to equip MDD tools with intelligent assistants, wizards for creating models, consistency checkers, and other modeling assistants to address such assist-modeling-related issues. However, is this the way MDD users expect to be assisted during modeling in MDD tools? Therefore, we plan and conduct two focus groups with MDD users. We extract data around three main research questions: i) what are the challenges perceived by MDD users during modeling for later code generation? ii) what are the features of the current modeling assistants that users like/dislike? and iii) what are the user{\textquoteright}s needs that are not yet satisfied by the current modeling assistants? As a result, we gather requirements from the MDD users{\textquoteright} perspective on how they would like to be assisted while using MDD tools. We propose an emerging framework for assisting MDD users during modeling based on such requirements. In addition, we outline future challenges and research efforts for next-generation MDD tools. {\textcopyright} 2022, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
	language = {English},
	booktitle = {Lect. {Notes} {Bus}. {Inf}. {Process}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Mosquera, D. and Ruiz, M. and Pastor, O. and Spielberger, J.},
	editor = {{Guizzardi R.} and {Ralyt{\'e} J.} and {Franch X.}},
	year = {2022},
	note = {Journal Abbreviation: Lect. Notes Bus. Inf. Process.},
	keywords = {Artificial intelligence, Computers, Software design, Model-driven-development, Software development teams, Development tools, Framework, Model-driven development, Current modeling, Assisted-modeling, Focus group method, Model requirements, Modeling assistant, Modeling assistants, Time to market},
	pages = {458--474},
	annote = {Export Date: 04 May 2026; Cited By: 2; Correspondence Address: D. Mosquera; Z{\"u}rich University of Applied Sciences, Winterthur, Gertrudstrasse 15, 8400, Switzerland; email: mosq@zhaw.ch; Conference name: 16th International Conference on Research Challenges in Information Science, RCIS 2022; Conference date: 17 May 2022 through 20 May 2022; Conference code: 277829},
