	keywords = {secure software development, Software security, Open source software, Codegeneration, Software design, Computer operating systems, Computer software selection and evaluation, Code security, Report generators, Software developer, Code generation tools, System program documentation, Secure coding, developer study, Developer study, generated code security, Generated code security, Open source repositories, Secure software development},
	pages = {1637--1646},
