},
	file = {PDF:/Users/lguevara/Zotero/storage/4S4S8UIG/Fang et al. - 2025 - EVALOOOP A Self-Consistency-Centered Framework for Assessing Large Language Model Robustness in Pro.pdf:application/pdf},
