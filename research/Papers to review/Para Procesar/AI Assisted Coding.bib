@inproceedings{ivanovici_integrating_2026,
	title = {Integrating {Model}-{Driven} {Development} {Within} {Agile} {Methods}: {Insights} from~a~{Systematic} {Literature} {Review}},
	isbn = {22138684 (ISSN); 978-303209065-2 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105028998463?origin=resultslist},
	doi = {10.1007/978-3-032-09066-9_5},
	abstract = {The integration of Model-Driven Development (MDD) within Agile Methods has emerged as a promising approach to combine the strengths of both approaches in software development. MDD furnishes abstraction and automation through model-based system specification and code generation, while agile development emphasizes flexibility, iterative cycles, and stakeholder collaboration. Despite their complementary advantages, their integration presents challenges such as steep learning curves, tool dependencies, and difficulties in generalization. This study conducts a systematic literature review to explore current implementations, benefits, challenges, and implications of using MDD within Agile methods. The findings highlight substantial benefits, including enhanced software quality, improved development efficiency, and strengthened stakeholder collaboration, alongside persistent barriers requiring tailored strategies. Recommendations for effective integration include targeted training, strategic tool selection, and project-specific customization of methodologies. This research offers insights for academics and practitioners aiming to optimize the use of MDD within Agile frameworks in evolving software development environments. {\textcopyright} The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
