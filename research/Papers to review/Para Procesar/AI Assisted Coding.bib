@inproceedings{nimraka_agentic-ai_2025,
	title = {An {Agentic}-{AI} {Solution} for {Intelligent} {Code} {Review}},
	isbn = {979-833156123-9 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105032737790?origin=resultslist},
	doi = {10.1109/SLAAI-ICAI68534.2025.11318443},
	abstract = {Manual pull request (PR) reviews are a critical but notoriously time-consuming and inconsistent part of modern software development, creating significant bottlenecks. This paper introduces the Intelligent Code Reviewer (ICR), an agentic AI system designed to automate and enhance this process. ICR accepts GitHub pull requests as input and generates comprehensive, structured reviews as output, seamlessly integrating into developer workflows via a VS Code extension and GitHub App. The system's core is a multi-agent architecture where specialist Large Language Model (LLM) agents analyze code for different classes of issues-including bugs, security vulnerabilities, and performance inefficiencies-in parallel. This is augmented by semantic duplication detection using Graph Neural Networks (GNNs), graph-based dependency impact analysis, and dynamic PR title validation against custom company rules. Evaluation through extensive unit and integration testing confirms that ICR successfully automates complex review tasks, substantially improving review thoroughness and consistency. This work demonstrates a significant advancement in automated software quality assurance, providing development teams with a unified tool that enhances both productivity and code reliability.  {\textcopyright} 2025 IEEE.},
