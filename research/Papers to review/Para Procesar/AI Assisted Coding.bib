	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: A. Truong; Ho Chi Minh City University of Technology (HCMUT), Ho Chi Minh City, 268 Ly Thuong Kiet Street, Dien Hong Ward, Viet Nam; email: anhtt@hcmut.edu.vn; CODEN: ISEKE},
