@inproceedings{rico_challenges_2025,
	title = {Challenges and {Opportunities} for {Generative} {AI} in {Software} {Engineering}: {A} {Managerial} {View}},
	isbn = {15397521 (ISSN); 979-840071276-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105013961188?origin=resultslist},
