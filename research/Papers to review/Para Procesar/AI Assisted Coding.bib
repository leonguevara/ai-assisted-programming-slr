	keywords = {Large language models, Software engineering, Language model, Large language model, Codegeneration, Codes (symbols), Computer programming languages, Source codes, Engineering tasks, Behavioral research, Code analysis, Code comprehension, Adversarial attack, Character level, Comprehension tasks, Modeling behaviour},
	pages = {383--394},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: J. Wen; The University of Sydney, Sydney, Australia; email: jwen8784@uni.sydney.edu.au; Conference name: 32nd Asia-Pacific Software Engineering Conference, APSEC 2025; Conference date: 2 December 2025 through 5 December 2025; Conference code: 221031},
