@inproceedings{yang_integrating_2025,
	title = {Integrating {RAG} and {LLM} for {Automated} {Code} {Review} in {Practice}},
	isbn = {979-833159590-6 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105030461711?origin=resultslist},
	doi = {10.1109/ISCIPT67144.2025.11265531},
	abstract = {With the rapid development of the digital economy, software development capability has become a key element of corporate core competitiveness. When facing urgent projects or short-term manpower shortages, companies often resort to temporary outsourcing solutions, leading to significant code quality issues in outsourced projects. Traditional static code analysis tools suffer from limitations such as delayed rule updates, insufficient cross-module analysis capabilities, and weak interpretability of results, making them inadequate to meet current demands. Advances in large language models (LLM) and retrieval-augmented generation (RAG) offer new possibilities for code quality management. However, current LLM-based solutions still face challenges including insufficient comment accuracy, low practicality, and a lack of targeted systematic improvement mechanisms. To address these issues, this study constructs a code graph knowledge base to provide effective contextual information and proposes a novel AI Code Review (AI-CR) framework. Experimental results demonstrate that the framework significantly improves adoption rate and developer trust. In comparative experiments, the adoption rate increased by 18.5\%, surpassing that of contemporaneous manual reviews.  {\textcopyright} 2025 IEEE.},
