	year = {2024},
	note = {Journal Abbreviation: Proc. - Int. Conf. Commun., Image Signal Process., CCISP},
	keywords = {code generation, Codegeneration, Software design, Code development, Model checking, Computer software reusability, Enterprise software, Development platform, Front end, System integration, Business systems, low code, Low code, micro front-end, Micro front-end, Micro services, micro-service, system integration, technical decouple, Technical decouple},
