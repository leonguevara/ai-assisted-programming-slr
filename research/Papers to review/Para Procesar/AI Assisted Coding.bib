@inproceedings{jayasingha_automating_2026,
	title = {Automating {Voice}-based {Conversations} into {Formal} {User} {Stories} using {LLM} and {Speech} {Recognition}},
	isbn = {979-833155723-2 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105036817231?origin=resultslist},
	doi = {10.1109/ICARC68737.2026.11453865},
	abstract = {Agile software development relies heavily on informal verbal discussions for requirements gathering, leading to documentation gaps, inconsistencies, and scalability challenges. This paper proposes an automated pipeline that combines Automatic Speech Recognition (ASR) with fine-tuned Large Language Models (LLMs) to convert Agile voice conversations directly into formal user stories. We employ OpenAI's Whisper model for accurate transcription of multi-speaker Agile meetings and fine-tune a GPT-2 model (ReqWeaver-GPT2) to extract and structure requirements into "As a [role], I want [feature], so that [benefit]" templates. Evaluation on a custom dataset of Agile conversations shows the pipeline achieves BLEU scores of 0.68, ROUGE-L of 0.72, and reduces documentation time by approximately 50\% compared to manual methods. While the system demonstrates strong performance in controlled settings, we acknowledge limitations in handling extreme speaker overlaps and domain-specific jargon without further tuning. The proposed approach significantly enhances documentation consistency, traceability, and team productivity in Agile workflows. {\textcopyright} 2026 IEEE.},
	language = {English},
	booktitle = {Int. {Conf}. {Adv}. {Res}. {Comput}.: {Responsible} {AGI}: {Balanc}. {Intell}., {Responsib}. {Sustain}., {ICARC} - {Conf}. {Proc}.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
