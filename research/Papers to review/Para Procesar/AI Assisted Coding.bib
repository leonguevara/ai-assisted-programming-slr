@inproceedings{alsayed_microrec_2024,
	title = {{MicroRec}: {Leveraging} {Large} {Language} {Models} for {Microservice} {Recommendation}},
	isbn = {979-840070587-8 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85197413585?origin=resultslist},
	doi = {10.1145/3643991.3644916},
	abstract = {The increasing adoption of microservices in software development requires effective recommendation systems that guide developers to relevant microservices. In this paper, we introduce MicroRec, a novel microservice recommender framework which leverages insights from Stack Overflow posts and the power of Large Language Models (LLMs). MicroRec utilizes a dual-encoder architecture that combines contrastive learning and semantic similarity learning, allowing us to achieve robust and accurate retrieval and ranking of relevant posts based on user queries. Using LLMs, MicroRec builds up a deep understanding of both user queries and microservices through the information they provide (e.g., README files and Dockerfiles). Our empirical evaluations demonstrate significant improvements brought by MicroRec over the existing methods across a variety of performance metrics including MRR, MAP, and precision@k. In addition, the results returned by MicroRec were fourteen times more accurate than those provided by the existing recommendation tool on the widely-used Docker Hub platform.CCS CONCEPTS{\textbullet} Computing methodologies {\textrightarrow} Semantic networks; Natural language processing; {\textbullet} Applied computing {\textrightarrow} Document searching; {\textbullet} Information systems {\textrightarrow} Recommender systems.  {\textcopyright} 2024 ACM.},
