@inproceedings{wang_shadows_2026,
	title = {Shadows in the {Code}: {Exploring} the {Risks} and {Defenses} of {LLM}-based {Multi}-{Agent} {Software} {Development} {Systems}},
	volume = {40},
	isbn = {21595399 (ISSN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN); 978-157735906-7 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105034967955?origin=resultslist},
	doi = {10.1609/aaai.v40i44.41134},
	abstract = {The rapid advancement of Large Language Model (LLM)-driven multi-agent systems has significantly streamlined software developing tasks, enabling users with little technical expertise to develop executable applications. While these systems democratize software creation through natural language requirements, they introduce significant security risks that remain largely unexplored. We identify two risky scenarios: Malicious User with Benign Agents (MU-BA) and Benign User with Malicious Agents (BU-MA). We introduce the Implicit Malicious Behavior Injection Attack (IMBIA), demonstrating how multi-agent systems can be manipulated to generate software with concealed malicious capabilities beneath seemingly benign applications, and propose Adv-IMBIA as a defense mechanism. Evaluations across ChatDev, MetaGPT, and AgentVerse frameworks reveal varying vulnerability patterns, with IMBIA achieving attack success rates of 93\%, 45\%, and 71\% in MU-BA scenarios, and 71\%, 84\%, and 45\% in BU-MA scenarios. Our defense mechanism reduced attack success rates significantly, particularly in the MU-BA scenario. Further analysis reveals that compromised agents in the coding and testing phases pose significantly greater security risks, while also identifying critical agents that require protection against malicious user exploitation. Our findings highlight the urgent need for robust security measures in multi-agent software development systems and provide practical guidelines for implementing targeted, resource-efficient defensive strategies. {\textcopyright} 2026, Association for the Advancement of Artificial Intelligence (www.aaai.org). All rights reserved.},
	language = {English},
	number = {44},
	booktitle = {Proc. {AAAI} {Conf}. {Artif}. {Intell}.},
	publisher = {Association for the Advancement of Artificial Intelligence},
	author = {Wang, X. and Huang, K. and Liang, B. and Li, H. and Du, X.},
	editor = {{Koenig S.} and {Jenkins C.} and {Taylor M.E.}},
	year = {2026},
	note = {Journal Abbreviation: Proc. AAAI Conf. Artif. Intell.},
	keywords = {Language model, Multi agent systems, Software design, Application programs, Network security, Model-based OPC, Intelligent agents, Multiagent systems (MASs), Defence mechanisms, Risk assessment, Security risks, Agent software development, Malicious agent, Malicious behavior, Multi-agent softwares, Software development systems},
	pages = {37970--37978},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: K. Huang; Renmin University of China, China; email: keman@ruc.edu.cn; Conference name: 40th AAAI Conference on Artificial Intelligence, AAAI 2026; Conference date: 20 January 2026 through 27 January 2026; Conference code: 349419},
}

@article{alami_accountability_2025,
	title = {Accountability in {Code} {Review}: {The} {Role} of {Intrinsic} {Drivers} and the {Impact} of {LLMs}},
	volume = {34},
	issn = {1049331X (ISSN)},
	url = {https://www.scopus.com/pages/publications/105019645084?origin=resultslist},
	doi = {10.1145/3721127},
	abstract = {Accountability is an innate part of social systems. It maintains stability and ensures positive pressure on individuals{\textquoteright} decision-making. As actors in a social system, software developers are accountable to their team and organization for their decisions. However, the drivers of accountability and how it changes behavior in software development are less understood. In this study, we look at how the social aspects of code review affect software engineers{\textquoteright} sense of accountability for code quality. Since Software Engineering (SE) is increasingly involving Large Language Models (LLM) assistance, we also evaluate the impact on accountability when introducing LLM-assisted code reviews. We carried out a two-phased sequential qualitative study (interviews {\textrightarrow} focus groups). In Phase I (16 interviews), we sought to investigate the intrinsic drivers of software engineers influencing their sense of accountability for code quality, relying on self-reported claims. In Phase II, we tested these traits in a more natural setting by simulating traditional peer-led reviews with focus groups and then LLM-assisted review sessions. We found that there are four key intrinsic drivers of accountability for code quality: personal standards, professional integrity, pride in code quality, and maintaining one{\textquoteright}s reputation. In a traditional peer-led review, we observed a transition from individual to collective accountability when code reviews are initiated. We also found that the introduction of LLM-assisted reviews disrupts this accountability process, challenging the reciprocity of accountability taking place in peer-led evaluations, i.e., one cannot be accountable to an LLM. Our findings imply that the introduction of AI into SE must preserve social integrity and collective accountability mechanisms. {\textcopyright} 2025 Copyright held by the owner/author(s).},
	language = {English},
	number = {8},
	journal = {ACM Transactions on Software Engineering and Methodology},
	publisher = {Association for Computing Machinery},
	author = {Alami, A. and Jensen, V. and Ernst, N.},
	year = {2025},
	keywords = {Artificial intelligence, LLM, Decision making, Software quality, Artificial Intelligence, Large Language Models, Code quality, Engineers, Computer aided software engineering, Language model, Large language model, Codes (symbols), Computer programming languages, Software design, Computer software selection and evaluation, Code review, Code Review, Human engineering, Behavioral research, Social software, Distributed computer systems, Professional aspects, Accountability, Human, Social aspect of software engineering, Social aspects, Social Aspects of Software Engineering, Social systems},
	annote = {Export Date: 04 May 2026; Cited By: 3; Correspondence Address: N. Ernst; Department of Computer Science, University of Victoria, Victoria, Canada; email: nernst@uvic.ca; CODEN: ATSME},
}

@article{shi_efficient_2025,
	title = {Efficient and {Green} {Large} {Language} {Models} for {Software} {Engineering}: {Literature} {Review}, {Vision}, and the {Road} {Ahead}},
	volume = {34},
	issn = {1049331X (ISSN)},
	url = {https://www.scopus.com/pages/publications/105007514044?origin=resultslist},
	doi = {10.1145/3708525},
	abstract = {Large Language Models (LLMs) have recently shown remarkable capabilities in various software engineering tasks, spurring the rapid growth of the Large Language Models for Software Engineering (LLM4SE) area. However, limited attention has been paid to developing efficient LLM4SE techniques that demand minimal computational cost, time, and memory resources, as well as green LLM4SE solutions that reduce energy consumption, water usage, and carbon emissions. This article aims to redirect the focus of the research community toward the efficiency and greenness of LLM4SE, while also sharing potential research directions to achieve this goal. It commences with a brief overview of the significance of LLM4SE and highlights the need for efficient and green LLM4SE solutions. Subsequently, the article presents a vision for a future where efficient and green LLM4SE revolutionizes the LLM-based software engineering tool landscape, benefiting various stakeholders, including industry, individual practitioners, and society. The article then delineates a roadmap for future research, outlining specific research paths and potential solutions for the research community to pursue. While not intended to be a definitive guide, the article aims to inspire further progress, with the ultimate goal of establishing efficient and green LLM4SE as a central element in the future of software engineering. {\textcopyright} 2025 Copyright held by the owner/author(s).},
	language = {English},
	number = {5},
	journal = {ACM Transactions on Software Engineering and Methodology},
	publisher = {Association for Computing Machinery},
	author = {Shi, J. and Yang, Z. and Lo, D.},
	year = {2025},
	keywords = {Efficiency, Software quality, Literature reviews, Software testing, Search engines, Engineering research, Large Language Models, Verification, Computer aided software engineering, Language model, Large language model, Software design, Application programs, Computer operating systems, Software packages, Software prototyping, Computer software maintenance, Engineering tasks, Software Engineering, Rapid growth, Groupware, Research communities, Computational costs, Computational time, Greenness, Limited attentions},
	annote = {Export Date: 04 May 2026; Cited By: 9; Correspondence Address: Z. Yang; School of Computing and Information Systems, Singapore Management University, Singapore, Singapore; email: zyang@smu.edu.sg; CODEN: ATSME},
}

@article{shi_hafix_2026,
	title = {{HAFix}: history-augmented large language models for bug fixing},
	volume = {31},
	issn = {13823256 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105035053547?origin=resultslist},
	doi = {10.1007/s10664-026-10833-3},
	abstract = {Recent studies have explored the performance of Large Language Models (LLMs) on various Software Engineering (SE) tasks, such as code generation and bug fixing. However, these approaches typically rely on the context data from the current snapshot of the project, overlooking the potential of rich historical data residing in real-world software repositories. Additionally, the impact of prompt styles on LLM performance for SE tasks within a historical context remains underexplored. To address these gaps, we propose HAFix, which stands for History-Augmented LLMs on Bug Fixing, a novel approach that leverages seven individual historical heuristics associated with bugs and aggregates the results of these heuristics (HAFix-Agg) to enhance LLMs{\textquoteright} bug-fixing capabilities. To empirically evaluate HAFix, we employ three Code LLMs (i.e., Code Llama, DeepSeek-Coder and DeepSeek-Coder-V2-Lite models) on 51 single-line Python bugs from BugsInPy and 116 single-line Java bugs from Defects4J. Our evaluation demonstrates that multiple HAFix heuristics (e.g., FN-modified and FN-all on Defects4J) achieve statistically significant improvements with large effect sizes compared to a non-historical baseline inspired by GitHub Copilot. Furthermore, the aggregated HAFix variant HAFix-Agg achieves substantial improvements with large effect sizes by combining the complementary strengths of individual heuristics, increasing bug-fixing rates relatively by an average of 45.05\% on BugsInPy and 49.92\% on Defects4J relative to the corresponding baseline. Moreover, within the context of historical heuristics, we identify the Instruction prompt style as the most effective template compared to the InstructionLabel and InstructionMask for LLMs in bug fixing. Finally, we evaluate the cost of HAFix in terms of inference time and token usage, and provide a pragmatic trade-off analysis of the cost and bug-fixing performance, offering valuable insights for the practical deployment of our approach in real-world scenarios. {\textcopyright} The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2026.},
	language = {English},
	number = {4},
	journal = {Empirical Software Engineering},
	publisher = {Springer},
	author = {Shi, Y. and Bangash, A.A. and Fallahzadeh, E. and Adams, B. and Hassan, A.E.},
	year = {2026},
	keywords = {Language model, Large language model, Codes (symbols), Software design, Performance, Cost benefit analysis, Program debugging, Large Language Model, Engineering tasks, Economic and social effects, Bug-fixing, Aggregates, Bug fixing, Cost analysis, Development history, History, Large language model cost analyze, LLM cost analysis, Software development history},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: Y. Shi; School of Computing, Queen{\textquoteright}s University, Kingston, Canada; email: y.shi@queensu.ca; CODEN: ESENF},
}

@article{otoum_methods_2026,
	title = {Methods and {Techniques} of {Agentic} {Software} {Engineering}: {A} {Systematic} {Literature} {Review}},
	volume = {14},
	issn = {21693536 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105027933957?origin=resultslist},
	doi = {10.1109/ACCESS.2026.3652325},
	abstract = {The development of agentic software engineering (ASE) is shifting the software development process, specifically by adopting autonomous agents into the fundamental software development process, where autonomous agents using large language models (LLMs) and artificial intelligence (AI) make decisions, write code, and collaborate across the entire software development lifecycle. The systematic review is a summary of literature on the agentic software engineering methodologies, frameworks, and techniques published in 2022-2025. We identify and compare methods based on autonomous coding, multi-agent systems, iterative refinement, and human-agent collaboration, drawing on 61 high-quality studies. We find that LLM-based agents show substantial potential in automated software engineering and that recent work is exploring new trends in agent cooperation, reasoning systems, and tool integration. We recognize such key challenges as the coordination procedures, reliability, explainability, and the ethical issues. This review characterizes the emerging role of agentic software engineering in improving the productivity of developers, the quality of their code, and the automation of their processes, and it offers a structured roadmap for future research. With the rapid evolution of the field, agentic approaches will tend to transform the conception, creation, and maintenance of software and provide more autonomous, adaptive, and intelligent systems. {\textcopyright} 2013 IEEE.},
	language = {English},
