	note = {Journal Abbreviation: Proc. Int. Conf. Eval. Assess. Softw. Eng. EASE, ed., EASE},
	keywords = {Automation, Semantics, Software testing, large language models, Language model, Large language model, Codes (symbols), Software design, Life cycle, Statistical tests, Test case, Automatic test pattern generation, Code coverage, Context level, context levels, CWE, Development testing, Manual process, Quality assurance, unit test generation, Unit test generations, Vulnerability-witnessing test, vulnerability-witnessing tests},
