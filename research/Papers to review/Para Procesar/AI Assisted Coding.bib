@inproceedings{kumar_model_2024,
	title = {Model {Based} {Design} {Approach} for {ePWT} {Software} \& {System} - {Battery} {Management} {System} for {xEVs}},
	isbn = {979-835037397-4 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85208251776?origin=resultslist},
	doi = {10.1109/CoDIT62066.2024.10708319},
	abstract = {Electric vehicles (EVs) are becoming the promising technology for achieving a sustainable transport sector, because of their ability to zero carbon emissions, high efficiency, and flexibility in grid operation \& integration. The e-Powertrain (ePWT) powers EVs and eliminates need for an internal combustion engine from vehicles due to its lightweight \& compactness that produces extremely low vibrations and generates instant torque for e-mobility. The e-Powertrain consists of the main units: power delivery module (battery pack \& Battery Management System (BMS), charger, DC-DC converters), high-power electric motor, inverter, and reduction drive. BMS is well known as the brain of all ePWT systems.Model-based design (MBD) approach adopted in development of e-powertrain software is presented in this research paper. MBD approach is preferred here for automotive software development to save time, to ensure reliability and cost saving. The MBD process shifts the emphasis on functions development from requirements rather than the manual code for automotive software development. A model, a diagrammatic representation of requirements, is created and tested at multiple stages using component testing \& integration testing strategies before the code generation using tools like MATLAB \& Simulink which minimizes the chances of errors in software implementation. This paper demonstrates the features and benefits of system design using MBD including testing/evaluation and documentation which result in reduced time and cost for development. In this paper, a specific MBD process is used and demonstrated for BMS software development for xEVs (EVs \& HEVs) which manages EV battery, by protecting it to operate beyond its safe limits and provides safety to the system and user with run time monitoring of battery status for any critical hazarder conditions. Further, it illustrates main steps of the modeling process \& show its implementation, functional simulation results and reliability. State-off-the-art algorithms are used for computation in BMS for sake of simplicity which can easily be updated for other empirical \& machine learning algorithms. {\textcopyright} 2024 IEEE.},
