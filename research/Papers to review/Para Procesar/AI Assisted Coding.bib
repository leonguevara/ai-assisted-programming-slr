@inproceedings{mousavi_investigation_2024,
	title = {An {Investigation} into {Misuse} of {Java} {Security} {APIs} by {Large} {Language} {Models}},
	isbn = {979-840070482-6 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85199260629?origin=resultslist},
	doi = {10.1145/3634737.3661134},
	abstract = {The increasing trend of using Large Language Models (LLMs) for code generation raises the question of their capability to generate trustworthy code. While many researchers are exploring the utility of code generation for uncovering software vulnerabilities, one crucial but often overlooked aspect is the security Application Programming Interfaces (APIs). APIs play an integral role in upholding software security, yet effectively integrating security APIs presents substantial challenges. This leads to inadvertent misuse by developers, thereby exposing software to vulnerabilities. To overcome these challenges, developers may seek assistance from LLMs. In this paper, we systematically assess ChatGPT{\textquoteright}s trustworthiness in code generation for security API use cases in Java. To conduct a thorough evaluation, we compile an extensive collection of 48 programming tasks for 5 widely used security APIs. We employ both automated and manual approaches to effectively detect security API misuse in the code generated by ChatGPT for these tasks. Our findings are concerning: around 70\% of the code instances across 30 attempts per task contain security API misuse, with 20 distinct misuse types identified. Moreover, for roughly half of the tasks, this rate reaches 100\%, indicating that there is a long way to go before developers can rely on ChatGPT to securely implement security API code. {\textcopyright} 2024 Copyright held by the owner/author(s).},
	language = {English},
	booktitle = {{ACM} {AsiaCCS} - {Proc}. {ACM} {Asia} {Conf}. {Comput}. {Commun}. {Secur}.},
	publisher = {Association for Computing Machinery, Inc},
	author = {Mousavi, Z. and Islam, C. and Moore, K. and Abuadbba, A. and Babar, M.A.},
	year = {2024},
	note = {Journal Abbreviation: ACM AsiaCCS - Proc. ACM Asia Conf. Comput. Commun. Secur.},
	keywords = {ChatGPT, Software security, Language model, Codegeneration, Codes (symbols), Software design, Application programs, Network security, Application programming interfaces (API), Java programming language, Applications programming interfaces, Software Security, Large language model-generated code, Secure software development, LLM-generated Code, Misuse, Secure Software Development, Security API, Security application, Security application programming interface},
	pages = {1299--1315},
	annote = {Export Date: 04 May 2026; Cited By: 14; Conference name: 19th ACM Asia Conference on Computer and Communications Security, AsiaCCS 2024; Conference date: 1 July 2024 through 5 July 2024; Conference code: 200971},
}

@inproceedings{hanifi_chatgpt_2023,
	title = {On {ChatGPT}: {Perspectives} from {Software} {Engineering} {Students}},
	isbn = {26939177 (ISSN); 979-835031958-3 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85182504562?origin=resultslist},
	doi = {10.1109/QRS60937.2023.00028},
	abstract = {ChatGPT, an increasingly popular Large Language Model (LLM), has found widespread acceptance, especially among the younger generation, who rely on it for various tasks, such as comprehending complex course materials and tackling homework assignments. This surge in interest has drawn the attention of researchers, leading to numerous studies that delve into the advantages and disadvantages of the upcoming LLM dominant era. In our research, we explore the influence of ChatGPT and similar models on the field of software engineering, specifically from the perspective of software engineering students. Our main objective is to gain valuable insights into their usage habits and opinions through a comprehensive survey. The survey encompassed diverse questions, addressing the specific areas where ChatGPT was utilized for assistance and gathering students' reflections on each aspect. We found that ChatGPT has garnered widespread acceptance among software engineering students, with 93\% of them utilizing it for their projects. These students expressed satisfaction with the level of assistance provided, and most intend to continue using it as a valuable tool in their work. During our investigation, we also assessed the students' awareness of the underlying technologies behind ChatGPT. Approximately half of the students demonstrated awareness of these technologies, while 38.7\% had made extra efforts to explore prompt engineering to enhance ChatGPT's productivity. However, an important finding was that 90.6\% of the students reported experiencing hallucinations during their interactions with ChatGPT. These hallucinations were shared as examples, raising significant concerns that warrant further exploration and mitigation. Moreover, we delved into potential improvements and gathered valuable recommendations, which could help ChatGPT to become even more effective and dependable in its applications.  {\textcopyright} 2023 IEEE.},
	language = {English},
	booktitle = {{IEEE} {Int}. {Conf}. {Softw}. {Qual}., {Reliab}. {Secur}., {QRS}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Hanifi, K. and Cetin, O. and Yilmaz, C.},
	year = {2023},
	note = {Journal Abbreviation: IEEE Int. Conf. Softw. Qual., Reliab. Secur., QRS},
	keywords = {generative AI, Software engineering, ChatGPT, Generative AI, software engineering, Students, Engineering education, Large Language Models, Computational linguistics, Language model, Large language model, Education computing, academic education, Academic education, Course material, Homework assignments, Similar models, Software engineering students, Younger generations},
	pages = {196--205},
	annote = {Export Date: 04 May 2026; Cited By: 21; Correspondence Address: K. Hanifi; Ericsson Research Turkey, Istanbul, Turkey; email: khadija.hanifi@ericsson.com; Conference name: 23rd IEEE International Conference on Software Quality, Reliability, and Security, QRS 2023; Conference date: 22 October 2023 through 26 October 2023; Conference code: 195900},
