	pages = {211605--211619},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: M.G. Thushara; Amrita School of Computing, Amrita Vishwa Vidyapeetham, Department of Computer Science and Applications, Kollam, Amritapuri, 690525, India; email: thusharamg@am.amrita.edu},
