	author = {Zheng, T. and Zhao, Y. and Guo, J. and Nie, L. and Jiang, M. and Zhou, Y.},
	year = {2026},
	keywords = {Artificial intelligence, Large language models, Software engineering, Semantics, Computational linguistics, Language model, Large language model, Data mining, Defect prediction, Down-stream, Forecasting, Recovery, Bug localizations, Issue{\textendash}commit link recovery, Link recoveries, Modular framework, Re-ranking, Software traceability},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: Y. Zhao; School of Computer Science and Technology, Zhejiang Sci-Tech University, Hangzhou, China; email: yangyangzhao@zstu.edu.cn; CODEN: ISOTE},
