	year = {2024},
	note = {Journal Abbreviation: Adv. neural inf. proces. syst.},
	keywords = {Language model, Large datasets, Application programs, Program debugging, C (programming language), Real-world, Engineering tasks, Machine learning models, Large scale systems, Application level, Large-scale systems, Linux, Linux kernel, Multi-threading, Software stacks, System softwares},
