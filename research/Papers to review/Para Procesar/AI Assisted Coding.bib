	keywords = {Artificial intelligence, Ethics, Software quality, Software, Software testing, Iterative methods, Automatic programming, Software design, Computer software selection and evaluation, Data privacy, Behavioral research, Ethical technology, Agile development, Artificial intelligence tools, Ethical perspectives, Iterative cycles, Social perspective, Social software, Software development models, Traditional approaches, Traditional approachs, Waterfall model},
