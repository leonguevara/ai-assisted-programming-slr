@inproceedings{yang_multi-step_2024,
	title = {Multi-step {Iterative} {Automated} {Domain} {Modeling} with {Large} {Language} {Models}},
	isbn = {979-840070622-6 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85211809778?origin=resultslist},
	doi = {10.1145/3652620.3687807},
	abstract = {Domain modeling, which represents the concepts and relationships in a problem domain, is an essential part of software engineering. As large language models (LLMs) have recently exhibited remarkable ability in language understanding and generation, many approaches are designed to automate domain modeling with LLMs. However, these approaches usually formulate all input information to the LLM in a single step. Our previous single-step approach resulted in many missing modeling elements and advanced patterns. This paper introduces a novel framework designed to enhance fully automated domain model generation. The proposed multi-step automated domain modeling approach extracts model elements (e.g., classes, attributes, and relationships) from problem descriptions. The approach includes instructions and human knowledge in each step and uses an iterative process to identify complex patterns, repeatedly extracting the pattern from various instances and then synthesizing these extractions into a summarized overview. Furthermore, the framework incorporates a self-reflection mechanism. This mechanism assesses each generated model element, offering self-feedback for necessary modifications or removals, and integrates the domain model with the generated self-feedback. The proposed approach is assessed in experiments, comparing it with a baseline single-step approach from our earlier work. Experiments demonstrate a significant improvement over our earlier work, with a 22.71\% increase in the F1-score for identifying classes, 75.18\% for relationships, and a 10.39\% improvement for identifying the player-role pattern, with comparable performance for attributes. Our approach, dataset, and evaluation provide valuable insight for future research in automated LLM-based domain modeling. {\textcopyright} 2024 Copyright held by the owner/author(s).},
	language = {English},
	booktitle = {Proceedings: {MODELS} - {ACM}/{IEEE} {Int}. {Conf}. {Model} {Driven} {Eng}. {Lang}. {Syst}.: {Companion} {Proc}.},
	publisher = {Association for Computing Machinery, Inc},
	author = {Yang, Y. and Chen, B. and Chen, K. and Mussbacher, G. and Varr{\'o}, D.},
	year = {2024},
	note = {Journal Abbreviation: Proceedings: MODELS - ACM/IEEE Int. Conf. Model Driven Eng. Lang. Syst.: Companion Proc.},
	keywords = {prompt engineering, large language models, Prompt engineering, Language model, Large language model, Contrastive Learning, Domain model, Problem oriented languages, few-shot learning, Few-shot learning, Domain Knowledge, Zero-shot learning, Multisteps, domain modeling, Model elements, Problem domain, Self-feedback, Single-step},
