	keywords = {software metrics, Verification, large language models, Language model, Large language model, Codegeneration, Codes (symbols), Natural language processing systems, Natural languages, Software design, Modeling languages, Formal specification, Compliance control, Software metrics, Smart contract, smart contracts, Legal compliance, Correct code, Compliance evaluations, legal compliance, Legal contracts, measurement, Model based development},
