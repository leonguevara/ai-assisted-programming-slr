@inproceedings{vethika_llm-powered_2025,
	title = {{LLM}-{Powered} {Code} {Generation} {Using} {RAG} {Framework} with {LLaMA} 3},
	isbn = {979-833158894-6 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105031384001?origin=resultslist},
	doi = {10.1109/CSITSS67709.2025.11294234},
	abstract = {As the need for rapid and efficient software development increases, developers often encounter difficulties in creating code that is both accurate and suited to its context. Conventional code generation tools tend to fall short in integrating specialized expertise from specific fields or in handling intricate programming requirements. To address this issue, we introduce a cutting-edge code generation system that employs Retrieval-Augmented Generation (RAG). This method effectively connects natural language inputs to high-quality code outputs by merging the capabilities of large language models with a document retrieval framework based on vectors. Prior to code generation, the system collects relevant documents, templates, or code samples, ensuring that the output is technically sound and contextually fitting. The architecture of the system is modular, incorporating components for data ingestion, embedding, retrieval, and code generation. This allows for versatility across various programming languages and applications. This intelligent assistant significantly cuts down development time, enhances code quality, and easily adapts to meet developers' needs. Planned future improvements will include features such as interactive debugging, advanced code completion, and integration with popular Integrated Development Environments (IDEs) to further streamline and enhance the development workflow.  {\textcopyright} 2025 IEEE.},
