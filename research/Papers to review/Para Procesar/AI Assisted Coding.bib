@inproceedings{yu_efficient_2024,
	title = {Efficient {Code} {Generation} for {Data}-{Intensive} {Simulink} {Models} via {Redundancy} {Elimination}},
	isbn = {0738100X (ISSN); 979-840070601-1 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85211094599?origin=resultslist},
	doi = {10.1145/3649329.3656217},
	abstract = {Simulink has emerged as the fundamental infrastructure that supports modeling, simulation, verification, and code generation for embedded software development. To improve the performance of the code generated from Simulink models, state-of-the-art code generators employ various optimization techniques, such as expression folding, variable reuse, and parallelism. However, they overlook the presence of redundant calculations within data-intensive models widely used to perform substantial data processing in embedded scenarios, which can significantly undermine the efficiency and performance of the generated code.This paper proposes Frodo, an efficient code generator for data-intensive Simulink models via redundancy elimination. Frodo first conducts model analysis to construct the dataflow graph and derive the I/O mapping of each block. Then, for each block within the dataflow graph, Frodo recursively determines its calculation range by leveraging the I/O mapping of its subsequent blocks. After that, Frodo generates concise code for optimizable blocks in accordance with the precise calculation range. We implemented and evaluated Frodo on benchmark Simulink models. Compared with the state-of-the-art code generators Simulink Embedded Coder, DFSynth, and HCG, the code generated by Frodo is 1.17{\texttimes} - 8.55{\texttimes} faster in terms of execution duration across different compilers and architectures, without incurring additional overhead of memory usage. {\textcopyright} 2024 Copyright is held by the owner/author(s). Publication rights licensed to ACM.},
	language = {English},
	booktitle = {Proc {Des} {Autom} {Conf}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Yu, Z. and Su, Z. and Jiang, Y. and Cui, A. and Wang, R.},
	year = {2024},
	note = {Journal Abbreviation: Proc Des Autom Conf},
	keywords = {Code Generation, Codegeneration, Software design, State of the art, Program compilers, Embedded software, Data flow analysis, Modeling simulation, Simulink, Simulink models, Code generators, Redundancy, Data flow graphs, Data intensive, Data-Intensive, Dataflow graphs, Model verification, Redundancy elimination, Simulink Models},
