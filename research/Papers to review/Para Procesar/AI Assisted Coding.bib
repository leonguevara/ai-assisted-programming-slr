	author = {Lu, J. and Sun, P. and Chen, Y. and Yin, G. and Ye, P.},
	year = {2025},
	note = {Journal Abbreviation: IEEE Int. Conf. Softw. Qual., Reliab. Secur., QRS},
	keywords = {Software engineering, Quality control, Language model, Fine tuning, Requirements engineering, Quality assessment, Human computer interaction, Information management, Graphic methods, Unified Modeling Language, Requirements modeling, Model generation, fine-tuning training, Fine-tuning training, Interactive tool, promote learning, Promote learning, quality assessment, requirements modeling, uml, Uml, UML Model},
	pages = {78--85},
