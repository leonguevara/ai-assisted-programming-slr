@article{zheng_scenario-specific_2025,
	title = {Scenario-specific inconsistency checking for requirement auto-modeling via {LLMs} and {GCN}},
	volume = {16},
	issn = {17939623 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105016586842?origin=resultslist},
	doi = {10.1142/S179396232550059X},
	abstract = {In software development, ensuring requirements consistency is critical, especially for time-dependent behaviors, where scenario-specific inconsistencies may emerge. Traditional manual modeling methods are labor-intensive and often overlook temporal complexities, making them unsuitable for complex and scalable systems. To address this, automated modeling techniques are needed to improve efficiency. However, existing automated methods lack the formal precision required for verifying inconsistencies using theorem provers like Z3 and CVC4. To resolve this, we propose a novel method named Requirement Auto-Modeling Inconsistency Checking with LLMs and GCN (RAMIC-LG), which integrates Large Language Models (LLMs) and Graph Convolutional Network (GCN). This method leverages LLMs to automatically extract use cases from requirement documents and convert them into semi-formal Clock Constraint Specification Language (CCSL) expressions. GCN is then used to analyze these constraints and detect inconsistencies, offering a more efficient and flexible alternative to traditional verification tools. Experimental results demonstrate that RAMIC-LG achieves 0.865 accuracy, 0.884 recall, 0.865 precision, 0.867 F1 score and 0.952 node coverage in detecting temporal inconsistencies, outperforming baseline approaches.  {\textcopyright} 2025 World Scientific Publishing Company.},
	language = {English},
	number = {5},
	journal = {International Journal of Modeling, Simulation, and Scientific Computing},
	publisher = {World Scientific},
	author = {Zheng, L. and Nie, Y. and Shi, J.},
	year = {2025},
	keywords = {Automation, large language models, Language model, Large language model, Requirements engineering, Software design, Modeling languages, Model checking, Formal specification, Specification languages, Convolution, Theorem proving, clock constraint specification language, Clock constraint specification language, Clock constraints, Complex networks, Constraint specification languages, Convolutional networks, graph convolutional network, Graph convolutional network, Inconsistency checking, Requirement auto-modeling inconsistency, Time-dependent behaviour},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: L. Zheng; School of Computer Science, Beijing Information Science and Technology University, Beijing, 100101, China; email: zlw@bistu.edu.cn},
}

@inproceedings{heander_support_2025,
	title = {Support, {Not} {Automation}: {Towards} {AI}-supported {Code} {Review} for {Code} {Quality} and {Beyond}},
	isbn = {15397521 (ISSN); 979-840071276-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105013957113?origin=resultslist},
	doi = {10.1145/3696630.3728505},
	abstract = {Code review is a well-established and valuable software development practice associated with code quality, interpersonal, and team benefits. However, it is also time-consuming, with developers spending 10-20\% of their working time doing code reviews. With recent advances in AI capabilities, there are more and more initiatives aimed at fully automating code reviews to save time and streamline software developer workflows. However, while automated tools might succeed in maintaining the code quality, we risk losing interpersonal and team benefits such as knowledge transfer, shared code ownership, and team awareness. Instead of automating code review and losing these important benefits, we envision a code review platform where AI is used to support code review to increase benefits for both code quality and the development team. We propose an AI agent-based architecture that collects and combines information to support the user throughout the code review and adapt the workflow to their needs. We analyze this design in relation to the benefits of code review and outline a research agenda aimed at realizing the proposed design. {\textcopyright} 2025 Copyright held by the owner/author(s).},
