	keywords = {Artificial intelligence, LLMs, Language model, Large language model, Comparative analyzes, Economics, Cost accounting, Fixed prices, fixed-price-based, Fixed-price-based, Price-based, Pricing models, Pricing services, Result-based, results-based, Service industry, Time based, time-based},
