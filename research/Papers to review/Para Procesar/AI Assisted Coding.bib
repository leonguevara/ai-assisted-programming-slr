	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: B. Al shboul; Department of Software Engineering, Faculty of Prince Al-Hussein bin Abdullah II of Information Technology, The Hashemite University, Zarqa, 13133, Jordan; email: Bashar.Alshboul@hu.edu.jo},
