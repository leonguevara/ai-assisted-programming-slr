	keywords = {Language model, Computation theory, Green computing, Program processors, Energy utilization, Computational efficiency, empirical software engineering, Empirical Software Engineering, Energy efficiency, Large-language model, Energy, llm, Llm, Client devices, Energy usage, energy-efficienct software, Energy-efficienct software, green it, Green-IT, large-language models, Remote servers},
