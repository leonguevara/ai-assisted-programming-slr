	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: S.-K. Kim; Macao Polytechnic University, Macao; email: amang@mpu.edu.mo; Conference name: 2026 International Conference on Electronics, Information, and Communication, ICEIC 2026; Conference date: 18 January 2026 through 21 January 2026; Conference code: 220455},
