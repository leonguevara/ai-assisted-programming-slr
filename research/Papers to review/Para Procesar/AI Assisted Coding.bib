@inproceedings{mendez_investigating_2026,
	title = {Investigating {Requirements}-{Based} {Test} {Case} {Generation} with {LLMs} in {Aerospace} {Applications}},
	isbn = {978-162410765-8 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105031089112?origin=resultslist},
	doi = {10.2514/6.2026-0838},
	abstract = {The rapid evolution of Large Language Models (LLM) has opened the possibility of developing new tools to assist engineers in their software development and verification activities. This paper evaluates the assistance provided by LLMs in test case identification in the aerospace industry. Three different paradigms were considered for the evaluation: Retrieval Augmented Generation (RAG), prompt, and agents. The findings show that these tools can reduce the time to identify the initial set of test cases for a given requirement. However, the evaluation also revealed recurring sources of errors, including incorrect mathematical calculations, unnecessary tests, and imprecise boundary-value derivation that compromise the test quality. The paper summarizes these observations and compares the results obtained with the different application paradigms. {\textcopyright} 2026, American Institute of Aeronautics and Astronautics Inc, AIAA. All rights reserved.},
