@inproceedings{le_van_tool_2025,
	title = {From tool to colleague: how {AI} partnership transforms the developers{\textquoteright} identity across cultural boundaries},
	volume = {4034},
	isbn = {16130073 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105017714843?origin=resultslist},
	abstract = {The increasing availability of Artificial Intelligence (AI) tools is transforming the software development landscape, enabling engineers to generate code with greater ease and efficiency. However, the integration of AI into programming workflows can vary significantly across individuals and cultures. This study investigates the impact of AI on a cohort of software developers from a multinational French company, including participants from France, Romania, and Morocco with diverse levels of experience with Large Language Models (LLMs). Since all participants work for the same company, we can isolate the impact of cultural differences on AI adoption, perception and usage. Using a qualitative approach, we interviewed participants and analyzed their responses using both Hofstede{\textquoteright}s cultural dimensions and Ashforth{\textquoteright}s professional identity frameworks. The results indicate that national cultural patterns are not a primary driver of AI adoption. Our results show that AI usage is associated with a redefinition of developers{\textquoteright} professional identities, as they adapt to new technologies and work practices that challenge their existing roles and self-perceptions. Our research provides valuable insights for managers of multinational software development teams, offering practical advice on how to effectively integrate AI into their workflows and support the evolving professional identities of their team members. {\textcopyright} 2025 Copyright for this paper by its authors.},
