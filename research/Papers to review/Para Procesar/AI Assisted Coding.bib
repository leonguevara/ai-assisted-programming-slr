	keywords = {Engineering education, Risk management, Project management, Language model, Large language model, Software design, Performance, Agile manufacturing systems, Large Language Model, Software Development, Human resource management, Human expertise, Project success, Comparatives studies, Planning tasks, Agile project management, Agile Project Management, Project planning, Project Planning, Scra, Scrum},
