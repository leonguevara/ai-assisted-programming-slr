	author = {Torcal, J. and Moreno, V. and Llorens, J. and Granados, A.},
	year = {2024},
	keywords = {Deep learning, deep learning, Software design, Application programs, Computer software selection and evaluation, Computer software reusability, Learning techniques, Unified Modeling Language, Convolutional neural network, Unified modeling language diagrams, Deep neural networks, convolutional neural networks, Diagram processing, Ground-truth dataset, UML diagram classification, UML diagram dataset, Unified modeling language diagram classification, Unified modeling language diagram dataset, Vision transformer, vision transformers},
	annote = {Export Date: 04 May 2026; Cited By: 3; Correspondence Address: A. Granados; Computer Science Department, Universidad Carlos III de Madrid, Legan{\'e}s, 28911, Spain; email: agranado@inf.uc3m.es},
