	isbn = {27324494 (ISSN); 978-183724263-4 (ISBN); 978-183724314-3 (ISBN); 978-183724315-0 (ISBN); 978-183724316-7 (ISBN); 978-183724323-5 (ISBN); 978-183724334-1 (ISBN); 978-183724335-8 (ISBN); 978-183724684-7 (ISBN); 978-183724685-4 (ISBN); 978-183724700-4 (ISBN); 978-183724701-1 (ISBN); 978-183724702-8 (ISBN); 978-183724703-5 (ISBN); 978-183724704-2 (ISBN); 978-183724727-1 (ISBN)},
