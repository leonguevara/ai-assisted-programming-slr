	note = {Place: Dordrecht},
	keywords = {Datasets, Efficiency, Artificial intelligence, Large language models, Performance evaluation, Effectiveness, Computer Software, Information and Computing Sciences, Productivity, Software development, Software quality, Computers--Software, Optimization, Computer programming, Benchmarks, Large Language Models, Engineering, Software development tools, Prompt engineering, Case studies, Empirical analysis, Code Generation, Coders, Performance Engineering, Performance enhancement, Program Analysis, Root cause analysis, Software Performance},
	pages = {62},
	annote = {Copyright - {\textcopyright} The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2026},
	annote = {E304
},
	annote = {Last updated - 2026-03-31},
