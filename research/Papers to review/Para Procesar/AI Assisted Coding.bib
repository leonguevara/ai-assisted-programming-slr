	doi = {10.1016/j.infsof.2024.107584},
	abstract = {Context: The realm of software development has seen significant transformations with the rise of Low-Code Development (LCD) and the integration of Artificial Intelligence (AI), particularly large language models, into coding practices. The proliferation of open-source software also offers vast resources for developers. Objective: We aim to combine the benefits of modifying retrieved code with the use of an extensive code repository to tackle the challenges of complex control structures and multifunctional requirements in software development. Method: Our study introduces a Search-and-Fill strategy that utilizes natural language processing (NLP) to dissect complex software requirements. It extracts control structures and identifies atomic function points. By leveraging large-scale pre-trained models, the strategy searches for these elements to fill in the automatically transformed program structures derived from descriptions of control structures. This process generates a code snippet that includes program control structures and the implementations of various function points, thereby facilitating both code reuse and efficient development. Results: We have validated the effectiveness of our strategy in generating code snippets. For natural language requirements involving multifunctional complex structures, we constructed two datasets: the Basic Complex Requirements Dataset (BCRD) and the Advanced Complex Requirements Dataset (ACRD). These datasets are based on natural language descriptions and Python code that were randomly extracted and combined. For the code snippets to be generated, we achieved the best results with the ACRD dataset, with BLEU-4 scores reaching up to 0.6326 and TEDS scores peaking at 0.7807. Conclusion: The Search-and-Fill strategy successfully generates a comprehensive code snippets, integrating essential control structures and functions to streamline the development process. Experimental results substantiate our strategy's efficacy in optimizing code reuse by effectively integrating preprocessing and selection optimization approach. Future research will focus on enhancing the recognition of complex software requirements and further refining the code snippets. {\textcopyright} 2024},
	language = {English},
	journal = {Information and Software Technology},
	publisher = {Elsevier B.V.},
	author = {Dong, Y. and Kong, L. and Zhang, L. and Wang, S. and Liu, X. and Liu, S. and Chen, M.},
	year = {2025},
	keywords = {Code generation, Natural language processing, Open source software, Codegeneration, Natural language processing systems, Natural languages, Computer software selection and evaluation, Multiprocessing programs, Code development, Computer software reusability, Language processing, System program documentation, Software requirements, Low-code development, Complex software, BASIC (programming language), Complex software requirement, Complex software requirements, Low-Code Development, Search-and-fill strategy, Search-and-Fill strategy},
	annote = {Export Date: 04 May 2026; Cited By: 7; Correspondence Address: Y. Dong; Qingdao Institute of Software, College of Computer Science and Technology, China University of Petroleum(East China), Shandong, China; email: dongyk@upc.edu.cn; CODEN: ISOTE},
}

@inproceedings{molison_is_2025-1,
	title = {Is {LLM}-{Generated} {Code} {More} {Maintainable} \& {Reliable} {Than} {Human}-{Written} {Code}?},
	isbn = {19493770 (ISSN); 979-833159147-2 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105032675312?origin=resultslist},
	doi = {10.1109/ESEM64174.2025.00036},
	abstract = {Background: The rise of Large Language Models (LLMs) in software development has opened new possibilities for code generation. Despite the widespread use of this technology, it remains unclear how well LLMs generate code solutions in terms of software quality and how they compare to humanwritten code. Aims: This study compares the internal quality attributes of LLM-generated and human-written code. Method: Our empirical study integrates datasets of coding tasks, three LLM configurations (zero-shot, few-shot, and fine-tuning), and SonarQube to assess software quality. The dataset comprises Python code solutions across three difficulty levels: introductory, interview, and competition. We analyzed key code quality metrics, including maintainability and reliability, and the estimated effort required to resolve code issues. Results: Our analysis shows that LLM-generated code has fewer bugs and requires less effort to fix them overall. Interestingly, fine-tuned models reduced the prevalence of high-severity issues, such as blocker and critical bugs, and shifted them to lower-severity categories, but decreased the model's performance. In competition-level problems, the LLM solutions sometimes introduce structural issues that are not present in human-written code. Conclusion: Our findings provide valuable insights into the quality of LLM-generated code; however, the introduction of critical issues in more complex scenarios highlights the need for a systematic evaluation and validation of LLM solutions. Our work deepens the understanding of the strengths and limitations of LLMs for code generation. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Int. {Symp}. {Empir}. {Softw}. {Eng}. {Meas}.},
	publisher = {IEEE Computer Society},
	author = {Molison, A.S. and Moraes, M. and Melo, G. and Santos, F. and Assuncao, F.},
