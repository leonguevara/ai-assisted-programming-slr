	annote = {Export Date: 04 May 2026; Cited By: 1; Correspondence Address: L.A. Costa; Federal University of the State of Rio de Janeiro (UNIRIO), Rio de Janeiro, Brazil; email: luiz.costa@edu.unirio.br; CODEN: JSSOD},
	annote = {Paper\_288
