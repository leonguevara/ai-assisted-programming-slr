@inproceedings{frankford_ai-tutoring_2024,
	title = {{AI}-{Tutoring} in {Software} {Engineering} {Education} {Experiences} with {Large} {Language} {Models} in {Programming} {Assessments}},
	isbn = {02705257 (ISSN); 979-840070498-7 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85195462659?origin=resultslist},
	doi = {10.1145/3639474.3640061},
	abstract = {With the rapid advancement of artificial intelligence (AI) in various domains, the education sector is set for transformation. The potential of AI-driven tools in enhancing the learning experience, especially in programming, is immense. However, the scientific evaluation of Large Language Models (LLMs) used in Automated Programming Assessment Systems (APASs) as an AI-Tutor remains largely unexplored. Therefore, there is a need to understand how students interact with such AI-Tutors and to analyze their experiences. In this paper, we conducted an exploratory case study by integrating the GPT-3.5-Turbo model as an AI-Tutor within the APAS Artemis. Through a combination of empirical data collection and an exploratory survey, we identified different user types based on their interaction patterns with the AI-Tutor. Additionally, the findings highlight advantages, such as timely feedback and scalability. However, challenges like generic responses and students{\textquoteright} concerns about a learning progress inhibition when using the AI-Tutor were also evident. This research adds to the discourse on AI{\textquoteright}s role in education. {\textcopyright} 2024 Copyright held by the owner/author(s).},
