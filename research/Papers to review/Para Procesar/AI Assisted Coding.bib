@article{sisomboon_automated_2026,
	title = {Automated {Software} {Test} {Case} {Generation} {Using} {Directional} {Partially} {Weighted} {Ensemble} {Large} {Language} {Models} {With} {Retrieval}-{Augmented} {Generation} ({RAG})},
	volume = {14},
	issn = {21693536 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105031476496?origin=resultslist},
	doi = {10.1109/ACCESS.2026.3667925},
	abstract = {Ensuring software quality relies on testing practices that can reliably confirm whether delivered systems meet user requirements. While Acceptance Test-Driven Development (ATDD) encourages early collaboration between stakeholders and developers, creating comprehensive acceptance test cases remains a human task that heavily depends on domain expertise. Recent progress in Large Language Models (LLMs) has made automated test case generation feasible. However, approaches based on a single model often suffer from performance instability, uneven test coverage, and a limited ability to generalize across heterogeneous requirements. This study proposes an automated test case generation framework that combines directional partially weighted ensemble large language models (LLMs) with Retrieval-Augmented Generation (RAG). The framework assigns model influence dynamically according to directional performance trends and degrees of partial correctness and consolidates candidate outputs through a weighted majority-voting mechanism and cross-validation conducted over multiple folds. Five state-of-the-art LLMs, Claude, ChatGPT, Gemini, Qwen, and Mistral, were evaluated using 16 criteria derived from four widely adopted closed box testing techniques: Boundary Value Analysis, Equivalence Partitioning, Use Case testing, and State Transition testing. Under the evaluated experimental conditions, the proposed framework achieved 98.44\% test coverage, indicating complete consistency with the defined gold-standard acceptance criteria. Cross-validation results further demonstrate improved robustness, stronger generalization to previously unseen requirements, and linear scalability, supporting practical deployment in real-world software development environments, and complexity analysis to confirm linear throughout growth (O(n)), which supports efficient deployment under increasing workloads. {\textcopyright} 2013 IEEE.},
	language = {English},
	journal = {IEEE Access},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Sisomboon, W. and Kaewyotha, J. and Songpan, W.},
	year = {2026},
	keywords = {LLM, Automation, Software quality, automated software testing, Language model, Large language model, Software design, Computer software selection and evaluation, Human computer interaction, Automated software testing, Model checking, Automatic test pattern generation, Retrieval-augmented generation, RAG, test coverage, Test-coverage, Automated test-case generations, Acceptance test-driven development, Acceptance tests, ATDD, Black-box testing, directional partially, Directional partially, Test driven development, weighted ensemble, Weighted ensemble},
	pages = {31124--31145},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: W. Songpan; Khon Kaen University, College of Computing, Department of Computer Science, Khon Kaen, 40002, Thailand; email: wararat@kku.ac.th},
}

@inproceedings{guan_multi-agent_2026,
	title = {A {Multi}-{Agent} {Coding} {Assistant} for {Cloud}-{Native} {Development}: {From} {Requirements} to {Deployable} {Microservices}},
	isbn = {979-840071998-1 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105036552066?origin=resultslist},
	doi = {10.1145/3795154.3795362},
	abstract = {The rapid adoption of cloud-native architectures has created an urgent demand for automated development tools that can translate natural language requirements into deployable cloud-native microservices. While recent advances in large language models (LLMs) have enabled AI-assisted code generation, existing approaches predominantly focus on isolated code completion tasks rather than end-to-end software delivery. This paper presents CloudMAS, a multi-agent coding assistant framework that orchestrates specialized agents to transform user requirements into deployable cloud-native applications. Our system comprises six specialized agents: an Architect Agent for service decomposition and API design, three parallel Coder Agents specialized in backend, frontend, and infrastructure-as-code (IaC) generation respectively, a Tester Agent for automated test synthesis and execution, and an Ops Agent for container configuration and Kubernetes manifest generation. These agents are coordinated by a dedicated Orchestrator Agent that manages workflow execution and conflict resolution. We introduce a novel conflict resolution mechanism that enables agents to iteratively refine outputs through structured feedback loops. To address the lack of systematic benchmarks for end-to-end cloud-native development, we construct CloudDevBench, a publicly available evaluation dataset containing 50 real-world development tasks with associated test suites and deployment validation criteria. Experimental results demonstrate that CloudMAS achieves 92\% compilation success, 81\% test pass rate, and 84\% deployment success rate, substantially outperforming single-LLM and single-agent baselines across all metrics. {\textcopyright} 2025 Copyright held by the owner/author(s).},
	language = {English},
	booktitle = {Proc. {Int}. {Conf}. {Comput}. {Sci}. {Manag}. {Technol}., {ICCSMT}},
	publisher = {Association for Computing Machinery, Inc},
	author = {Guan, T.},
	year = {2026},
	note = {Journal Abbreviation: Proc. Int. Conf. Comput. Sci. Manag. Technol., ICCSMT},
	keywords = {Automation, code generation, large language models, Computer aided software engineering, Language model, Large language model, automated software engineering, Automated software engineering, Codegeneration, Codes (symbols), Multi agent, Multi agent systems, Automatic programming, Computer architecture, Application programming interfaces (API), Benchmarking, Intelligent agents, Multiagent systems (MASs), Development tools, DevOps, Multi-agent systems, cloud-native development, Cloud-native development, End to end, Microservice, microservices},
	pages = {1285--1290},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: T. Guan; University of California, Irvine, Irvine, United States; email: rttr.rocks8@gmail.com; Conference name: 2025 6th International Conference on Computer Science and Management Technology, ICCSMT 2025; Conference date: 26 December 2025 through 28 December 2025; Conference code: 221600},
