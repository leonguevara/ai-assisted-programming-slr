	keywords = {Software engineering, Metadata, Language model, Codes (symbols), Computer programming languages, Code review, LLM4SE, Summarization, Economic and social effects, Code changes, Pull request, Cognitive loads, Automated tasks, Compression ratio (machinery), External resources, Key practices, Pull Request},
