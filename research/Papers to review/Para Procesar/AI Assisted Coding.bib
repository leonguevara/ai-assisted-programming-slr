@inproceedings{sagodi_reality_2024,
	title = {Reality {Check}: {Assessing} {GPT}-4 in {Fixing} {Real}-{World} {Software} {Vulnerabilities}},
	isbn = {979-840071701-7 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85197411670?origin=resultslist},
	doi = {10.1145/3661167.3661207},
	abstract = {Discovering and mitigating software vulnerabilities is a challenging task. These vulnerabilities are often caused by simple, otherwise (and in other contexts) harmless code snippets (e.g., unchecked path traversal). Large Language Models (LLMs) promise to revolutionize not just human-machine interactions but various software engineering tasks as well, including the automatic repair of vulnerabilities. However, currently, it is hard to assess the performance, robustness, and reliability of these models as most of their evaluation has been done on small, synthetic examples. In our work, we systematically evaluate the automatic vulnerability fixing capabilities of GPT-4, a popular LLM, using a database of real-world Java vulnerabilities, Vul4J. We expect the model to provide fixes for vulnerable methods, which we evaluate manually and based on unit test results included in the Vul4J database. GPT-4 provided perfect fixes consistently for at least 12 out of the total 46 examined vulnerabilities, which could be applied as is. In an additional 5 cases, the provided textual instructions would help to fix the vulnerabilities in a practical scenario (despite the provided code being incorrect). Our findings, similar to others, also show that prompting has a significant effect. {\textcopyright} 2024 ACM.},
	language = {English},
	booktitle = {{ACM} {Int}. {Conf}. {Proc}. {Ser}.},
	publisher = {Association for Computing Machinery},
	author = {S{\'a}godi, Z. and Antal, G. and Bogenf{\"u}rst, B. and Isztin, M. and Heged{\"u}s, P. and Ferenc, R.},
	year = {2024},
	note = {Journal Abbreviation: ACM Int. Conf. Proc. Ser.},
	keywords = {Machine learning, Software engineering, GPT, Software vulnerabilities, Language model, Repair, Codes (symbols), Machine-learning, Real-world, Automated program repair, Simple++, Human machine interaction, Path traversals, Vulnerability fixing},
	pages = {252--261},
