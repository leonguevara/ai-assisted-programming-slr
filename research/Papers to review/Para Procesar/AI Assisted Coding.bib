@inproceedings{zeng_coderujb_2024-1,
	title = {{CoderUJB}: {An} {Executable} and {Unified} {Java} {Benchmark} for {Practical} {Programming} {Scenarios}},
	isbn = {979-840070612-7 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85205591670?origin=resultslist},
	doi = {10.1145/3650212.3652115},
	abstract = {In the evolving landscape of large language models (LLMs) tailored for software engineering, the need for benchmarks that accurately reflect real-world development scenarios is paramount. Current benchmarks are either too simplistic or fail to capture the multi-tasking nature of software development. To address this, we introduce CoderUJB, a new benchmark designed to evaluate LLMs across diverse Java programming tasks that are executable and reflective of actual development scenarios, acknowledging Java's prevalence in real-world software production. CoderUJB comprises 2,239 programming questions derived from 17 real open-source Java projects and spans five practical programming tasks. Our empirical study on this benchmark investigates the coding abilities of various open-source and closed-source LLMs, examining the effects of continued pre-training in specific programming languages code and instruction fine-tuning on their performance. The findings indicate that while LLMs exhibit strong potential, challenges remain, particularly in non-functional code generation (e.g., test generation and defect detection). Importantly, our results advise caution in the specific programming languages continued pre-training and instruction fine-tuning, as these techniques could hinder model performance on certain tasks, suggesting the need for more nuanced strategies. CoderUJB thus marks a significant step towards more realistic evaluations of programming capabilities in LLMs, and our study provides valuable insights for the future development of these models in software engineering.  {\textcopyright} 2024 Copyright is held by the owner/author(s). Publication rights licensed to ACM.},
	language = {English},
	booktitle = {{ISSTA} - {Proc}. {ACM} {SIGSOFT} {Int}. {Symp}. {Softw}. {Test}. {Anal}.},
	publisher = {Association for Computing Machinery, Inc},
	author = {Zeng, Z. and Wang, Y. and Xie, R. and Ye, W. and Zhang, S.},
	editor = {{Christakis M.} and {Pradel M.}},
	year = {2024},
	note = {Journal Abbreviation: ISSTA - Proc. ACM SIGSOFT Int. Symp. Softw. Test. Anal.},
	keywords = {Large Language Models, Open source software, Code Generation, Language model, Large language model, Codegeneration, Software design, Computer software selection and evaluation, Multiprocessing programs, Programming tasks, Real-world, Benchmarking, Open-source, Java programming language, Benchmark, Development scenarios, Pre-training, Unified Modeling Language, Executables},
	pages = {124--136},
