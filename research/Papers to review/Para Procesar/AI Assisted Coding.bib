	note = {Journal Abbreviation: Proc ACM SIGSOFT Symp Found Software Eng},
	keywords = {code generation, Language model, Large language model, Codegeneration, Codes (symbols), Automatic programming, Software design, Application programs, Application programming interfaces (API), Benchmarking, Data mining, Automated code generation, Generation method, Applications programming interfaces, Development scenarios, Large language model hallucination, LLM hallucination, Practical projects},
	pages = {468--479},
