@inproceedings{cornide-reyes_generative_2025,
	title = {Generative {Artificial} {Intelligence} for {AgileRE}: {A} {Systematic} {Mapping}},
	isbn = {15224902 (ISSN); 979-833159716-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105035837043?origin=resultslist},
	doi = {10.1109/SCCC67219.2025.11420613},
	abstract = {This article presents a systematic mapping study on the use of Generative Artificial Intelligence (GenAI) in Agile Requirements Engineering (AgileRE) processes. Given the increasing integration of large language models (LLMs) such as GPT-3, GPT-4, and Codex into software development, this study explores their specific application in agile contexts. Based on the analysis of 32 primary studies published between 2020 and 2024 in indexed databases (Scopus, WoS, ACM, IEEE), we address four research questions regarding GenAI applications, challenges, tools, and impact in AgileRE. The results reveal the growing use of GenAI for requirements interpretation and generation, backlog prioritization, documentation, and automated validation. Reported benefits include productivity gains, improved code quality, and workflow automation. Challenges relate to explain-ability, data availability, organizational readiness, and ethical concerns. This study provides a comprehensive overview of current knowledge and outlines future research directions to support the ethical and practical integration of GenAI into agile software development environments. {\textcopyright} 2025 IEEE.},
