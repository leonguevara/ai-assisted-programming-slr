@inproceedings{jiang_advancements_2023,
	title = {Advancements in {Small}-{Scale} {Fuel} {Cell} {Controller} {Evolution} through {Automated} {Code} {Generation}: {A} {Scientific} {Approach}},
	isbn = {979-835030834-1 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85191460565?origin=resultslist},
	doi = {10.1109/ICARCE59252.2024.10492513},
	abstract = {The fuel cell controller, positioned at the core of the fuel cell system, orchestrates control and monitoring functions to ensure operational efficiency and stability. This paper outlines the design of a fuel cell controller characterized by robust versatility, abundant peripherals, and cost-effectiveness, leveraging the STM32F407 platform. Subsequently, a comprehensive suite of automatic code generation strategies, centered on Waijung1 within the Simulink environment, is introduced, streamlining algorithm development. These methodologies are then employed to rigorously experiment and validate the controller's performance. The test results showcase the controller's elevated precision in signal output and data detection. The output signal error remains under 0.1\%, the captured signal error is contained within 0.4\%, the sensor error is restricted to less than 1.5\%, and the overall controller cost is reduced by 25\%-30\%, attesting to the precision and cost-effectiveness of the system. The automatic code generation solution significantly reduces the software development cycle by more than 30\% compared to traditional C language development approaches, highlighting significant advancements in efficiency. {\textcopyright} 2023 IEEE.},
