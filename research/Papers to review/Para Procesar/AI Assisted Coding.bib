	note = {Journal Abbreviation: Proc ACM SIGSOFT Symp Found Software Eng},
	keywords = {Large language models, Software engineering, Prompt engineering, Language model, Large language model, Benchmarking, Benchmark, Evaluation, Distributed computer systems, Question Answering, Subdomain, Domain Knowledge, Benchmark suites, Information technology systems, Operation, Operations},
	pages = {503--513},
	annote = {Export Date: 04 May 2026; Cited By: 1; Conference name: 33rd ACM International Conference on the Foundations of Software Engineering, FSE Companion 2025; Conference date: 23 June 2025 through 27 June 2025; Conference code: 211130},
