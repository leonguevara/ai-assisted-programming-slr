@inproceedings{chen_llm-based_2025,
	title = {{LLM}-{Based} {Method} for {Generating} {Vulnerable} {Code} {Equivalents}},
	volume = {13519},
	isbn = {0277786X (ISSN); 978-151068831-5 (ISBN)},
