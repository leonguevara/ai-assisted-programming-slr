	keywords = {Decision making, Large Language Models, Language model, Large language model, Software design, Computer software selection and evaluation, Software methodologies, Behavioral research, Decision support systems, Decision Support Systems, Decision supports, Flow entropy, Flow entropy sort, Flow Entropy Sort, Support systems, Expert systems, Entropy, Analytic hierarchy process, Knowledge-based expert systems, Multi criteria decision-making, Multicriteria decision-making},
