	keywords = {Semantics, Software testing, Large Language Models, Cost effectiveness, Language model, Large language model, Application programs, Work-flows, Test case, Mobile applications, Cost engineering, Mobile app, Automatic testing, Well testing, Redundancy, Automatic UI testing, Automatic UI Testing, Cost Optimization, Costs Optimization, Mobile Apps, Model based testing, Real-world tests, Redundant tests},
