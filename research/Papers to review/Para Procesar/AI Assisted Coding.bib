	year = {2021},
	note = {Journal Abbreviation: AISec - Proc. ACM Workshop Artif. Intell. Secur.},
	keywords = {large language models, Vulnerability detection, Language model, Large language model, Software design, Performance, Life cycle, Benchmarking, Learning systems, Detection methods, Secure software development, Overfitting, causal learning, Causal learning, confounding effect, Confounding effect, overfitting, vulnerability discovery, Vulnerability discovery},
	pages = {149--160},
	annote = {Export Date: 04 May 2026; Cited By: 10; Conference name: 16th ACM Workshop on Artificial Intelligence and Security, AISec 2023, co-located with CCS 2023; Conference date: 30 November 2023 through 30 November 2023; Conference code: 194681},
