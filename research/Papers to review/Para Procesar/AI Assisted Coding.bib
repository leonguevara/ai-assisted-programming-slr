	issn = {978-104091517-2 (ISBN); 978-104091524-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105035960936?origin=resultslist},
	doi = {10.1201/9781003774679-63},
	abstract = {FastWrite is a Python-based framework that automates the creation and evaluation of software documentation by harnessing advanced Natural Language Processing and multiple large language model backends. It analyzes source code via Python{\textquoteright}s Abstract Syntax Tree to generate inline comments, comprehensive function and module descriptions, Graphviz-compatible data flow diagrams and illustrative code examples, all through a unified command-line or programmatic interface. FastWrite supports both cloud-hosted and on-premise AI models{\textemdash}such as OpenAI{\textquoteright}s GPT series, Google Gemini, Groq LLMs and Ollama deployments{\textemdash}allowing developers to tailor performance and privacy tradeoffs. In addition, it incorporates objective quality metrics, including BLEU-based scoring, to assess and benchmark the fidelity of generated documentation against reference standards. Through seamless integration with Python 3.11+ environments, FastWrite addresses the persistent challenge of maintaining up-to-date, high-quality documentation, streamlines developer workflows and promotes reproducibility and best practices in modern software engineering. Keywords: NLP, Code documentation, AST Parsing, Python, BLEU Score. {\textcopyright} 2026 selection and editorial matter, Dr. Vivek Sunnapwar, Dr. Hariram Chavan and Dr. Namrata F. Ansari; individual chapters, the contributors.},
