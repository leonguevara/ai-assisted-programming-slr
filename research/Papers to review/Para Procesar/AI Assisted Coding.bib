	author = {Alharbi, M. and Alshayeb, M.},
	year = {2026},
	keywords = {Programming languages, Automatic code generation, Codes (symbols), Computer programming languages, Automatic programming, Systematic literature review, Benchmarking, Reviews, Computer software, Software-systems, Academic research, Automatic code generations, Automatic technique, Development cycle, Generation techniques, Human errors, Industrial practices, Industrial research, Input format},
	annote = {Export Date: 04 May 2026; Cited By: 2; Correspondence Address: M. Alharbi; Information and Computer Science Department, King Fahd University of Petroleum and Minerals, Dhahran, Saudi Arabia; email: g202001360@kfupm.edu.sa; CODEN: ASOEE},
