	year = {2026},
	note = {Journal Abbreviation: Lect. Notes Comput. Sci.},
	keywords = {LLM, Language model, Large language model, Integration testing, Test case, Safety engineering, Testing software, Aircraft control, Flight control systems, Aerial vehicle, Antennas, Autonomous system, Autonomous System, Flight testing, Fuzz Testing, Fuzzing, Safety testing, Testing methodology, Unmanned aerial vehicles (UAV)},
