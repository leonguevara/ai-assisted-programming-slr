@inproceedings{chai_large_2025,
	title = {Large {Language} {Model} for {Geotechnical} {Engineering} {Applications} {Using} {Retrieval} {Augmented} {Generation}},
	volume = {2025-March},
	isbn = {08950563 (ISSN)},
	url = {https://www.scopus.com/pages/publications/86000510156?origin=resultslist},
	doi = {10.1061/9780784485989.001},
	abstract = {The application of Natural Language Processing (NLP) in the field of Civil and geotechnical engineering presents unique challenges with the complexity of the calculations and the necessity for engineering judgment. Large Language Models (LLM) have been successfully presented to be one of the most effective solutions in many specific fields such as arts and literature, finance, and even software development. However, the use of LLM in the field of Civil Engineering and specifically in Geotechnical Engineering has not been widely discussed often compared to the other fields. This paper aims to cover the details with the framework and breakdown of how LLMs can be used to retrieve information from domain-specific data set specifically related to geotechnical engineering. The paper covers topics ranging from settlement analysis, ground improvements, to scripting features with the Rocscience platform. Data sources include research papers, technical documents from geotechnical engineers, and documentation for online help from the relevant geotechnical software. The paper is structured into three main sections: an introduction to LLM models with a focus on pre-trained models and model selection; a discussion of the data retrieval process using domain-specific database using Retrieval Augmented Generation (RAG); and an evaluation of the model{\textquoteright}s performance. Performance benchmarks are established with vector embedding to trace context retrieval, and validation is performed using methods such as Recall-Oriented Understudy for Gisting Evaluation (ROGUE), Bidirectional Encoder Representations From Transformer (BERT), and Bilingual Evaluation Understudy (BLEU) score to compare the result with prompt-completion pairs. The study demonstrates that an LLM with sufficient geotechnical domain-specific data source produces superior responses compared to LLM trained on a generic public data set. The paper concludes with a discussion on the comparative results and the future potential of the LLM in geotechnical engineering. {\textcopyright} ASCE.},
	language = {English},
	number = {GSP 365},
	booktitle = {Geotech {Spec} {Publ}},
	publisher = {American Society of Civil Engineers (ASCE)},
	author = {Chai, S.H. and Chen, I. and Huang, J. and Yacoub, T.},
	editor = {{Beauregard M.S.} and {Budge A.S.}},
	year = {2025},
	note = {Journal Abbreviation: Geotech Spec Publ},
	keywords = {ChatGPT, Language model, Large language model, Large Language Models (LLM), Retrieval augmented generation, API with openai, APIs with OpenAI, Civil Engineering, Fine-tuned model, fine-tuned models, Geotechnical, Retrieval Augmented Generation (RAG), RS2, Settle3, settlement analysis, Settlement analysis},
	pages = {1--10},
	annote = {Export Date: 04 May 2026; Cited By: 4; Correspondence Address: S.H. Chai; Rocscience, Inc., Toronto, Canada; email: steve.chai@rocscience.com; Conference name: Geotechnical Frontiers 2025: Emerging Topics and Geotechnologies; Conference date: 2 March 2025 through 5 March 2025; Conference code: 207193; CODEN: GSPUE},
