@inproceedings{barradas-fernandez_current_2025,
	title = {Current {Status} of {Cluster} {Analysis} {Application} in {Software} {Construction} {Activities}: {A} {Systematic} {Literature} {Review}},
	isbn = {979-833159026-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105032035905?origin=resultslist},
	doi = {10.1109/ENC68268.2025.11311899},
	abstract = {This paper presents a Systematic Literature Review (SLR) on the application of Cluster Analysis (CA) in software construction activities. Following the guidelines of Kitchenham and Quasigold-standard, we identified and analyzed 28 primary studies published between 2019 and 2025. The review revealed nine CA algorithms applied in this context, with K-means being the most frequently adopted for its simplicity and efficiency, followed by Hierarchical Clustering, Fuzzy C-means, and DBSCAN. The findings show that CA has been used to group code fragments, support refactoring, classify developer profiles, automate code generation, organize APIs, and detect dependencies among modules. These applications contribute to improving software quality, scalability, and maintainability. However, challenges remain in selecting the optimal number of clusters, interpreting results reliably, and generalizing across heterogeneous software systems. Overall, CA demonstrates significant potential as a complementary approach to enhance efficiency and quality in software construction, providing practical benefits for software engineers while highlighting the need for methodological guidance and further research.  {\textcopyright} 2025 IEEE.},
