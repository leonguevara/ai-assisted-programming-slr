	year = {2026},
	keywords = {Large language models, Automation, Defects, Software testing, Empirical study, Language model, Large language model, Repair, Codes (symbols), Performance, Model-based OPC, Program debugging, Computer software maintenance, Automated program repair, Empirical studies, Computer debugging, Defect classification, Defect type, Multi-stages, Repair process},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: S. Zhang; School of Internet of Things Engineering, Jiangnan University, Wuxi, Jiangsu, China; email: shanxinzhang@jiangnan.edu.cn},
}

@article{zheng_selink_2026,
	title = {{SELink}: {A} semantic-enhanced modular framework for issue{\textendash}commit link recovery},
	volume = {190},
	issn = {09505849 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105024079062?origin=resultslist},
	doi = {10.1016/j.infsof.2025.107973},
	abstract = {Context: Issue{\textendash}commit link recovery (ICLR) is a fundamental task in software traceability that aims to reconstruct missing or incomplete links between issue reports and code commits. Accurate link recovery supports downstream tasks such as bug localization, defect prediction, and change impact analysis. However, existing approaches often suffer from input truncation and limited semantic discrimination, which reduce their effectiveness in real-world settings. Objective: This study aims to improve the robustness and precision of issue{\textendash}commit link recovery by addressing two key challenges: (1) the loss of semantic information caused by token truncation in long textual inputs, and (2) the difficulty of accurately ranking semantically similar candidate commits. Methods: We propose SELink, a Semantic-Enhanced framework that integrates large language models into the ICLR pipeline. SELink comprises three key components: a semantic summarization module that compresses verbose texts while preserving core semantics; a prediction module based on a pre-trained encoder, with flexibility to adopt various backbone models; and a semantic re-ranking module that refines the top-K candidate links through decoder-only LLM inference. In our implementation, the prediction module is instantiated using the EALink framework, though it can be substituted with other compatible encoders. Results: Experimental results show that SELink significantly outperforms state-of-the-art baseline models across most evaluation metrics and projects. In particular, it achieves notable improvements in Hit@1, NDCG@1, Recall@1 and LAG, highlighting its effectiveness in top-rank prediction accuracy. Ablation studies confirm the contribution of each module, and additional experiments across three different LLMs demonstrate the framework{\textquoteright}s adaptability. Conclusion: SELink effectively addresses two long-standing limitations in issue{\textendash}commit link recovery by leveraging LLM-based semantic compression and re-ranking. Its modular design and superior performance suggest that semantic-enhanced frameworks hold significant potential for advancing traceability tasks in software engineering. {\textcopyright} 2025 Elsevier B.V. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	language = {English},
	journal = {Information and Software Technology},
