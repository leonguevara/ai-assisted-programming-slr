	keywords = {Artificial intelligence, Large language models, Knowledge management, Natural language generation, Computer aided software engineering, Language model, Large language model, Ethical aspects, Natural language processing systems, Software design, Application programs, Software-tools, Knowledge transfer, AI impact on software profession, AI impact on software professions, Ethical implications, Future of programming with AI LLM-enabled software tool, Future of programming with AI LLM-enabled software tools, LLM in programming automation, Model bias, Software engineering AI-driven software development},
	pages = {365--382},
