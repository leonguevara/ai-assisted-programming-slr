	keywords = {Defects, Software testing, Computational linguistics, Language model, Repair, Computer programming languages, Application programs, Model-based OPC, Engineering tasks, Computer systems programming, Detection and repairs, Learn+, Defect detection, Context window, Defect repair, Potential risks, Software defects},
	pages = {319--330},
