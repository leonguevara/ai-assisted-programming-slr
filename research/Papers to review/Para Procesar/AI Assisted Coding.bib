	keywords = {Generative AI, Software testing, GitHub Copilot, Large Language Models, Software development tools, Language model, Large language model, Machine-learning, Computer software selection and evaluation, Empirical studies, Development productivity, Development process, Github copilot, AI assisted software development tool, AI Assisted Software Development Tools},
