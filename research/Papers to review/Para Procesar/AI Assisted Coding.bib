@article{truong_java_2026,
	title = {Java {Code} {Generation} {Using} {Prompt} {Engineering} {Techniques}},
	volume = {36},
	issn = {02181940 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105026785300?origin=resultslist},
	doi = {10.1142/S0218194025500974},
	abstract = {Automated code generation using large language models (LLMs) has attracted significant attention due to its potential to enhance software development. However, ensuring both accuracy and efficiency in generated code remains challenging. Prior research has mainly advanced along two directions: (i) enhancing models through architectural improvements, larger parameter scaling, and domain-specific fine-tuning; and (ii) refining prompt engineering techniques to better structure inputs and guide outputs. In this work, we pursue the latter direction and introduce a prompt engineering-based approach for Java code generation. Rather than directly generating Java code from natural language specifications, we propose a two-step pipeline: (i) generating intermediate Python code and, (ii) translating Python into Java. This design leverages the strong performance of LLMs on Python while enabling systematic optimization of the translation stage. To achieve this, we propose a set of translation strategies combining prompt engineering principles {\textemdash} including explicit instructions, syntax guidance, and domain keyword constraints {\textemdash} with advanced reasoning strategies such as Zero-shot Chain of Thought (Zero-shot-CoT) to efficiently generate Java code. Experiments on the HumanEval-X benchmark using the CodeGeeX3 model show that the proposed strategies significantly improve the accuracy of Java code generation. We further evaluate across diverse programming tasks, including file operations, HTTP APIs, database connectivity, parallel computing, and graphical applications, confirming the robustness of our approach. Finally, we validate the generality of our findings using ChatGPT (GPT-4o), observing substantial improvements over baseline prompt designs. {\textcopyright} 2026 World Scientific Publishing Company.},
	language = {English},
	number = {6},
	journal = {International Journal of Software Engineering and Knowledge Engineering},
	publisher = {World Scientific},
	author = {Truong, A. and Le, P. and Tran, H.},
	year = {2026},
	keywords = {Python, prompt engineering, Engineering research, large language models, Prompt engineering, Computational linguistics, Language model, Large language model, Codegeneration, Codes (symbols), Automatic programming, Natural language processing systems, Software design, Application programming interfaces (API), Benchmarking, Automated code generation, Chains, code translation, Code translation, Engineering techniques, High level languages, Java code generation, Java codes, Java programming language, Program compilers, Program translators, Translation (languages), zero-shot chain-of-thought, Zero-shot chain-of-thought},
