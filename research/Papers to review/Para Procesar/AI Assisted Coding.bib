	keywords = {Engineering, Model validation, Memory management, Model-driven software engineering, Execution engine, Industrial engineering, Model management, Model partitioning, Model processing, Partial loading, Software systems, Sophisticated mechanism, Static program analysis, Underlying systems},
	pages = {436--440},
