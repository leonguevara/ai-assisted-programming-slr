	year = {2025},
	note = {Journal Abbreviation: Proc. - IEEE Int. Symp. Clust., Cloud Internet Comput., CCGrid},
	keywords = {Large Language Models (LLMs), Sustainable development, Open source software, Code Generation, Language model, Large language model, Codegeneration, Codes (symbols), Natural languages, Software design, Open systems, Optimal systems, Energy utilization, Language processing, Energy efficiency, Economic and social effects, Green AI, Early exit, Early Exits, Model inference, Power management, Pruning, Sustainable AI},
