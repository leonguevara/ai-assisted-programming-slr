@inproceedings{praneesh_roshan_sdlc_2025,
	title = {{SDLC} {AutoPilot} {AI}: {Agentic} {Automation} of {Software} {Development} {Life} {Cycle}},
	isbn = {979-833159897-6 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105036673053?origin=resultslist},
	doi = {10.1109/ICOIICS67115.2025.11390299},
	abstract = {The Software Development Life Cycle (SDLC) remains one of the most resource-intensive processes in modern engineering, requiring continuous coordination across requirement gathering, planning, team formation, testing, and deployment. Despite the availability of advanced automation tools, much of this process still depends on manual oversight, which often results in delays, misaligned requirements, and costly rework. To address these challenges, we propose SDLC AutoPilot AI, an intelligent agentic system designed to orchestrate the entire SDLC in an end-to-end manner. Beginning from a high-level project brief, the system leverages large language models and retrieval-augmented pipelines to transform unstructured inputs into well-structured requirements. It then prepares project plans and budget estimates, quantifying uncertainty ranges to improve transparency in forecasting. Using automated reasoning and supervised models, the system performs role assignment, forms collaborative teams within enterprise platforms, and provisions the necessary infrastructure for execution. Furthermore, SDLC AutoPilot AI integrates tightly with collaboration tools, version control platforms, and CI/CD pipelines to support automated verification, test case generation, and staged deployments. Preview environments are provisioned dynamically, enabling early client validation and reducing downstream rework. To ensure accountability and resilience, the system includes governance guardrails for human approval, observability features such as decision logs and audit trails, and safeguards against hallucination and misclassification. This paper presents the architectural design of the system, details the algorithms used for estimation and role allocation, and outlines the integration pathways with enterprise ecosystems. An evaluation framework is also proposed to assess its effectiveness in terms of delivery speed, reduction in rework, defect density, and stakeholder satisfaction. Finally, we reflect on the broader implications of introducing agentic automation into software engineering workflows, with particular attention to governance, reliability, and ethical considerations. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Proc. {Int}. {Conf}. {Intell}. {Comput}., {Inf}. {Control} {Syst}., {ICOIICS}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Praneesh Roshan, P. and Thavasi, M. and Jaslin, C.Q.},
