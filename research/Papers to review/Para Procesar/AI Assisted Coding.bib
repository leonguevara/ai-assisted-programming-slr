@inproceedings{alsobeh_shadowplay_2025,
	title = {{ShadowPlay}: {Engineering} {Defenses} {Against} {Role}-{Based} {Prompt} {Injection} and {Dependency} {Hallucination} in {LLM}-{Powered} {Development}},
	isbn = {979-833156631-9 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105028721365?origin=resultslist},
	doi = {10.1109/Cyber-AI66431.2025.11233258},
	abstract = {Large Language Models (LLMs) have revolutionized software development by providing intelligent code generation and assistance capabilities. However, their integration into development workflows introduces critical security vulnerabilities that traditional cybersecurity measures fail to address. This paper presents ShadowPlay, a novel multi-layered defense framework specifically engineered to detect and mitigate two emerging threat vectors: role-based prompt injection attacks and dependency hallucination vulnerabilities. Our approach combines formal verification techniques with Machine Learning (ML)-based behavioral analysis to create a comprehensive security solution. The framework employs four integrated components: a semantic prompt analysis engine, a real-time dependency verification system, a behavioral monitoring module, and a response validation layer. Through extensive evaluation on over 20,000 attack scenarios across diverse threat categories, ShadowPlay demonstrates superior performance with 95.1\% overall accuracy, 97.2\% precision, and only 1.8\% false positive rate, while maintaining an average response latency of 127 milliseconds. Our contributions include the first formal mathematical model for these attack vectors, a production-ready defense architecture, and comprehensive empirical validation demonstrating significant improvements over existing approaches.  {\textcopyright} 2025 IEEE.},
