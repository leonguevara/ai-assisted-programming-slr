	year = {2025},
	note = {Journal Abbreviation: Proc Int Conf Software Eng},
	keywords = {LLM, Language model, Large language model, Software design, Software prototyping, Model-driven, Retrieval-augmented generation, Retrieval-Augmented Generation (RAG), User interface prototypes, Automated graphical user interface prototyping, Automated GUI Prototyping, Graphical user interfaces, Materials design, Prompt decomposition, Prompt Decomposition, User interfaces - Prototyping, User interfaces generation},
