@inproceedings{nuh_llmtestcraft_2025,
	title = {{LLMTestCraft}: {An} {Automated} {Unit} {Test} {Case} {Generator} using {Large} {Language} {Models}},
	isbn = {979-833157578-6 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105033617177?origin=resultslist},
	doi = {10.1109/ICoDSE68111.2025.11351817},
	abstract = {Automated software testing has become essential in modern development pipelines, particularly for maintaining quality during rapid code evolution. This paper presents LLMTestCraft, an automated unit test generation system powered by large language models (LLMs) such as GPT. The tool is designed to produce both passing and failing test cases, using a modular, agent-based architecture. By decomposing the process into input value generation, test case construction, and file management, the system ensures clarity, extensibility, and robust test coverage. Evaluation results across diverse Python functions demonstrate that LLMTestCraft consistently generates semantically accurate and meaningful test cases with a 92.6 \% correctness rate. The system offers a scalable alternative to manual test writing and represents a significant advancement in AI-assisted software testing. {\textcopyright} 2025 IEEE.},
