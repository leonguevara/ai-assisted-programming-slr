@inproceedings{naresh_kumar_harnessing_2025,
	title = {Harnessing {Advanced} {AI} {Techniques} for {Code} {Generation}: {Transforming} {Software} {Development} with {Intelligent} {Automation} and {Predictive} {Algorithms}},
	isbn = {979-833151224-8 (ISBN)},
