@inproceedings{martinez_montes_emotional_2025,
	title = {Emotional {Strain} and {Frustration} in {LLM} {Interactions} in {Software} {Engineering}},
	isbn = {979-840071385-9 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105027211383?origin=resultslist},
	doi = {10.1145/3756681.3756951},
	abstract = {Large Language Models (LLMs) are increasingly integrated into various daily tasks in Software Engineering, such as coding and requirement elicitation. Despite their various capabilities and constant use, some interactions can lead to unexpected challenges (e.g. hallucinations or verbose answers) and, in turn, cause emotions that develop into frustration. Frustration can negatively impact engineers' productivity and well-being if it escalates into stress and burnout. In this paper, we assess the impact of LLM interactions on software engineers' emotional responses, specifically strains, and identify common causes of frustration when interacting with LLMs at work. Based on 62 survey responses from software engineers in industry and academia across various companies and universities, we found that a majority of our respondents experience frustrations or other related emotions regardless of the nature of their work. Additionally, our results showed that frustration mainly stemmed from issues with correctness and less critical issues, such as adaptability to context or specific format. While such issues may not cause frustration in general, artefacts that do not follow certain preferences, standards, or best practices can make the output unusable without extensive modification, causing frustration over time. In addition to the frustration triggers, our study offers guidelines to improve the software engineers' experience, aiming to minimise long-term consequences on mental health. {\textcopyright} 2025 Copyright held by the owner/author(s).},
	language = {English},
	booktitle = {Proc. {Int}. {Conf}. {Eval}. {Assess}. {Softw}. {Eng}. {EASE}, ed., {EASE}},
	publisher = {Association for Computing Machinery, Inc},
	author = {Martinez Montes, C. and Khojah, R.},
	editor = {{Babar M.A.} and {Tosun A.} and {Wagner S.} and {Stray V.}},
	year = {2025},
	note = {Journal Abbreviation: Proc. Int. Conf. Eval. Assess. Softw. Eng. EASE, ed., EASE},
	keywords = {Large Language Models (LLMs), Software engineering, Engineers, Language model, Large language model, Requirements elicitation, Software Engineering, Behavioral research, Daily tasks, Emotion, Emotional response, Emotions, Frustration, Model interaction, Respondent experiences, Strain, Well being},
	pages = {193--204},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: C. Martinez Montes; Chalmers University of Technology, Gothenburg, Sweden; email: montesc@chalmers.se; Conference name: 29th International Conference on Evaluation and Assessment of Software Engineering, EASE 2025; Conference date: 17 June 2025 through 20 June 2025; Conference code: 216134},
}

@inproceedings{magar_enhancing_2026,
