	keywords = {LLM, AI, MBSE, MDE, Continuous Modeling, Incremental Modeling, Modeling Suggestions},
	pages = {61--72},
	annote = {Export Date: 04 May 2026; Cited By: 0; Conference name: 14th International Conference on Model-Based Software and Systems Engineering, MODELSWARD 2026; Conference date: 7 March 2026 through 9 March 2026; Conference code: 349289},
