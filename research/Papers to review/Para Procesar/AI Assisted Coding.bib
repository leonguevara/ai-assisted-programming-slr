@inproceedings{gutierrez_prompts_2025,
	title = {Prompts {Engineering} {Challenges} in {Software} {Code} {Generation}},
	doi = {10.1109/AmITIC68284.2025.11214606},
	abstract = {This paper presents a Systematic Literature Review where prompt engineering in automatic code generation using large language models or LLMs is examined. A methodological protocol identified 28 relevant primary studies to characterize the current status, trends, and challenges of prompt engineering in software development. The results show that prompt engineering has been established as a key discipline for optimizing interaction with LLMs and improving the accuracy, robustness, and applicability of the generated code. The identified findings were grouped into six recurring thematic categories: structured methodologies, pedagogical strategies, precision and robustness, code improvement techniques, security through prompts, and the relevance of prompt engineering in interactions with LLMs. Important challenges were also identified, including the sensitivity of LLMs to slight variations in prompts, the complexity of their design, and risks related to security, plagiarism, and over-reliance. These challenges not only reflect technical limitations of current models but also involve pedagogical, ethical, and social considerations that need to be carefully addressed. This review provides a knowledge base for researchers and developers seeking to integrate prompt engineering into their processes and practices effectively.},
	booktitle = {2025 {IEEE} {VIII} {Congreso} {Internacional} en {Inteligencia} {Ambiental}, {Ingenieria} de {Software} y {Salud} {Electronica} y {Movil} ({AmITIC})},
