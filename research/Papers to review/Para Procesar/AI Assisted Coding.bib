@article{ghorbian_large_2026,
	title = {Large language models for code generation: {A} survey},
	volume = {98},
	issn = {09205489 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105036514290?origin=resultslist},
	doi = {10.1016/j.csi.2026.104165},
	abstract = {As one of the most advanced achievements of artificial intelligence and a new paradigm in a field long served by other techniques such as Non-Large Language Models approaches, Large language models (LLMs) have brought about a significant transformation in the Code Generation (CoGe) process. With the ability to process vast amounts of text data and comprehend the intricacies of programming languages, these models can generate, complete, and optimize executable code tailored to specific needs, leading to increased productivity and reduced complexity in software development. However, the use of this technology is accompanied by challenges, including the generation of unsafe codes, failure to comply with the best programming standards, and the need to manage extensive computational resources. This review article examines the applications, challenges, and achievements of LLMs in CoGe. It analyzes the impact of this technology on enhancing the precision and productivity of programming. The primary objective of this article is to assess the effects of these models on the CoGe process from multiple perspectives. Through a systematic meta-inference of the selected studies, the results indicate a strong consensus and clear evidence that LLMs substantially enhance the efficiency of code generation, improve code security, and facilitate the learning of complex concepts. Through a systematic meta-inference framework{\textemdash}a novel approach for synthesizing heterogeneous evidence where formal meta-analysis is infeasible{\textemdash}the results indicate a strong consensus and clear evidence that LLMs substantially enhance the efficiency of code generation, improve code security, and facilitate the learning of complex concepts. Accordingly, the findings suggest that LLMs have significant potential in enhancing the quality and efficiency of CoGe processes and can be regarded as a scientifically grounded and methodologically practical instrument for advancing productivity and strengthening standards in software development. {\textcopyright} 2026 Elsevier B.V.},
	language = {English},
	journal = {Computer Standards and Interfaces},
	publisher = {Elsevier B.V.},
	author = {Ghorbian, M. and Ghobaei-Arani, M. and Shakarami, A.},
	year = {2026},
	keywords = {Code generation, Efficiency, Software quality, Language model, Large language model, Codegeneration, Codes (symbols), Computer programming languages, Automatic programming, Software design, AI-driven development, Automated programming, Code security, Formal methods, Generation process, Modeling approach, Text data, Text-to-code},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: M. Ghobaei-Arani; Department of Computer Engineering, Qo.C., Islamic Azad University, Qom, Iran; email: mo.ghobaei@iau.ac.ir; CODEN: CSTIE},
