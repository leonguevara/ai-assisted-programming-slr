@inproceedings{ashrafi_enhancing_2025,
	title = {Enhancing {LLM} {Code} {Generation}: {A} {Systematic} {Evaluation} of {Multi}-{Agent} {Collaboration} and {Runtime} {Debugging} for {Accuracy}, {Reliability}, and {Latency}},
	isbn = {979-833159342-1 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105030483442?origin=resultslist},
	doi = {10.1109/AICT67988.2025.11268754},
	abstract = {Large language models (LLMs) have shown promising code generation capabilities; however, they still face challenges in generating successful code for non-trivial programming tasks. To enhance the LLM{\textquoteright}s code generation abilities, we investigate, in this paper, the combination of two complementary inference-time strategies: multi-agent collaboration and runtime execution-based debugging. We conduct an extensive empirical study to evaluate our proposed framework using 19 diverse LLMs on two established coding benchmarks, measuring functional accuracy as a code quality characteristic. Our study reveals that that our combination outperforms the basic performance of LLMs and the individual approaches. In particlular, on HumanEval benchmark, across 19 LLMs, our approach achieves 64.82\% accuracy compared to 56.48\% achieved by the basic one-shot prompting approach. It also outperforms the individual multi-agent collaboration approach by more than 7.66\%. Moreover, our extensive empirical study revealed that optimal combinatory improvement is achieved when both individual strategies perform at similar levels. The proposed framework can be readily deployed in existing development pipelines to enhance the reliability of code generation while maintaining reasonable generation speeds, offering a practical solution to improve automated code generation in enterprise environments. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {{IEEE} {Int}. {Conf}. {Appl}. {Inf}. {Commun}. {Technol}., {AICT} - {Conf}. {Proc}.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Ashrafi, N. and Bouktif, S. and Mediani, M.},
	year = {2025},
	note = {Journal Abbreviation: IEEE Int. Conf. Appl. Inf. Commun. Technol., AICT - Conf. Proc.},
	keywords = {Program synthesis, Software reliability, Language model, Codegeneration, Codes (symbols), Computer programming languages, Multi agent, Multi agent systems, Automatic programming, Software design, Program debugging, Benchmarking, Intelligent agents, Optimal systems, Program compilers, Computer systems programming, Multiagent systems (MASs), Runtimes, Functional programming, Program Synthesis, Multi-Agent Systems, AI-driven software development, Mathematical programming, AI-Driven Software Development, Code reliability, Code Reliability, Large language model enhancement, LLM Enhancement, Runtime debugging, Runtime Debugging},
