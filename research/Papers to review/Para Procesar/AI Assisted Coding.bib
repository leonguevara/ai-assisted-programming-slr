@inproceedings{rojpaisarnkit_towards_2025,
	title = {Towards {Proficiency} {Assessment} {Through} {Code}},
	isbn = {979-833159587-6 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105022449081?origin=resultslist},
	doi = {10.1109/ICSME64153.2025.00093},
	abstract = {In an era increasingly shaped by generative AI, code understanding remains a critical foundation for ensuring software quality, reliability, and maintainability. While AI systems can accelerate code generation, developers still face substantial challenges in comprehending, debugging, and effectively integrating the resulting artifacts. Code proficiency, defined not only by comprehension but also by the ability to write efficient, idiomatic code, plays a central role in addressing these challenges. Existing tools, such as those assigning CEFR-based levels, which outline six levels of proficiency from A1 to C2, to code constructs that offer initial frameworks for assessing code difficulty. However, their manually derived classifications lack empirical validation and often diverge from pedagogical progressions found in computer science textbooks. This research seeks to address the absence of a standardized, data-driven metric for determining the proficiency levels required to understand specific programming elements. We propose an automated framework grounded in textbook analysis and clustering techniques to establish a scalable proficiency metric applicable to both human-written and AI-generated code. Preliminary findings reveal strong alignment with educational sequencing and suggest promising applications in AI-assisted software development, particularly in enhancing code review workflows and tailoring AI-generated code to developers' proficiency levels.  {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Proc. - {IEEE} {Int}. {Conf}. {Softw}. {Maint}. {Evol}., {ICSME}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Rojpaisarnkit, R. and Matsumoto, K.},
	year = {2025},
	note = {Journal Abbreviation: Proc. - IEEE Int. Conf. Softw. Maint. Evol., ICSME},
	keywords = {Maintainability, Artificial intelligence, Software quality, Software reliability, Codegeneration, Codes (symbols), Software design, Application programs, Computer software selection and evaluation, Code understanding, Computer software maintenance, Software Quality, Software-Reliability, AI systems, Software maintainability, Software Maintenance, Code proficiency, Code Proficiency, Idiomatics, Proficiency level, Quality reliability},
	pages = {860--864},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: R. Rojpaisarnkit; Nara Institute of Science and Technology, Japan; email: rojpaisarnkit.ruksit.rn1@is.naist.jp; Conference name: 41st IEEE International Conference on Software Maintenance and Evolution, ICSME 2025; Conference date: 7 September 2025 through 12 September 2025; Conference code: 214372},
