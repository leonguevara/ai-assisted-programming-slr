	author = {Pratama, D. and Suryanto, N. and Adiputra, A.A. and Le, T.-T.-H. and Kadiptya, A.Y. and Iqbal, M. and Kim, H.},
	year = {2024},
	keywords = {artificial intelligence, Artificial Intelligence, Software, large language model, Open source software, Language model, Large language model, Model evaluation, human, Humans, software, Model checking, Domain specific, Large language model evaluation, LLM evaluation, penetration testing, Penetration testing, AI penetration testing assistant, computer security, Computer Security, Domain specific large language model, domain specific LLM, Pentesting large language model, pentesting LLM, personnel, Research Personnel, vulnerabillity detection, Vulnerabillity detection},
	annote = {Export Date: 04 May 2026; Cited By: 13; Correspondence Address: H. Kim; School of Computer Science and Engineering, Pusan National University, Busan, 46241, South Korea; email: howonkim@pusan.ac.kr},
}

@inproceedings{krishna_using_2024,
	title = {Using {LLMs} in {Software} {Requirements} {Specifications}: {An} {Empirical} {Evaluation}},
	isbn = {1090705X (ISSN); 979-835039511-2 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85202706343?origin=resultslist},
	doi = {10.1109/RE59067.2024.00056},
	abstract = {The creation of a Software Requirements Specification (SRS) document is important for any software development project. Given the recent prowess of Large Language Models (LLMs) in answering natural language queries and generating sophisticated textual outputs, our study explores their capability to produce accurate, coherent, and structured drafts of these documents to accelerate the software development lifecycle. We assess the performance of GPT-4 and CodeLlama in drafting an SRS for a university club management system and compare it against human benchmarks using eight distinct criteria. Our results suggest that LLMs can match the output quality of an entry-level software engineer to generate an SRS, delivering complete and consistent drafts. We also evaluate the capabilities of LLMs to identify and rectify problems in a given requirements document. Our experiments indicate that GPT-4 is capable of identifying issues and giving constructive feedback for rectifying them, while CodeLlama's results for validation were not as encouraging. We repeated the generation exercise for four distinct use cases to study the time saved by employing LLMs for SRS generation. The experiment demonstrates that LLMs may facilitate a significant reduction in development time for entry-level software engineers. Hence, we conclude that the LLMs can be gainfully used by software engineers to increase productivity by saving time and effort in generating, validating and rectifying software requirements.  {\textcopyright} 2024 IEEE.},
