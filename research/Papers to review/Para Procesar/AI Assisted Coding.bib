@article{contreras_architecting_2026,
	title = {Architecting open, accountable, and trustworthy {AI}-{IDEs}},
	volume = {33},
	issn = {09288910 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105033798456?origin=resultslist},
	doi = {10.1007/s10515-026-00608-x},
	abstract = {Generative artificial intelligence (AI) is boosting the use of LLM-based conversational assistants in many domains. In software engineering, numerous integrated development environments (IDEs) offer conversational assistants to improve productivity, leading to AI-IDEs. However, the integration of assistants into IDEs is often ad-hoc, rigid and opaque. Moreover, the assistant-generated code is frequently untraceable, and developers struggle to trust it. Given the diversity of software construction processes, AI-IDE architectures should be: (i) open, permitting the on-demand configuration of assistive tasks, and enabling the coordination of assistants potentially built atop diverse LLMs; (ii) accountable, tracing the assistant contributions and exploiting this information to obtain project insights; (iii) trustworthy, allowing the customisation of safeguard protocols for the assistive tasks. To fill this gap, we propose an open, extensible, accountable architecture for AI-IDEs, which incorporates validation loops for trustworthy assistance. We have implemented this architecture as an extensible plugin for Java development within Eclipse, called Caret. We have conducted offline evaluations and a user study, which demonstrate that Caret can be easily extended with new tasks, and its handling of context and validation loops results in effectiveness improvements up to 147.34\% compared to the baseline. Overall, our architecture facilitates the seamless integration of LLM-based conversational assistants into IDEs, coping with new assistive demands for specific needs, offering detailed accountability of development contributions, and incorporating configurable validation loops for trustworthy development. {\textcopyright} The Author(s) 2026.},
	language = {English},
	number = {2},
	journal = {Automated Software Engineering},
	publisher = {Springer},
	author = {Contreras, A. and Guerra, E. and de Lara, J.},
	year = {2026},
	keywords = {Artificial intelligence, Large language models, Architecture, Integrated development environment, Language model, Large language model, Software design, Integrodifferential equations, AI-driven software development, AI-IDEs, Artificial intelligence-driven software development, Artificial intelligence-integrated development environment, Assistive, Construction process, Conversational assistant, Conversational assistants, Environment architectures, Software construction},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: A. Contreras; Department of Computer Science, Universidad Auton{\'o}ma de Madrid, Madrid, Campus Cantoblanco, 28049, Spain; email: Albert.Contreras@uam.es; CODEN: ASOEE},
}

@article{fahad_can_2026,
	title = {Can we trust the source? {A} systematic review of watermarking and attribution for {AI}-generated code},
	volume = {196},
	issn = {09505849 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105036711959?origin=resultslist},
	doi = {10.1016/j.infsof.2026.108157},
	abstract = {Context: Large Language Models (LLMs) are now widely used in software engineering, especially for code generation tasks. While this has improved developer productivity, it has also raised several concerns. Issues related to intellectual property (IP), academic integrity, and software supply chain security are becoming more common. At the same time, AI-generated code is increasingly hard to distinguish from human-written code. Because of this, identifying the origin of source code has become an important and challenging problem. Objectives: This study aims to systematically analyze and compare existing techniques for tracing the provenance of AI-generated source code, with a focus on two dominant paradigms: active provenance mechanisms (code watermarking) and passive provenance mechanisms (authorship attribution). The goal is to assess their effectiveness, robustness, and practical suitability within real-world software engineering workflows. Method: We performed a Systematic Literature Review following the PRISMA guidelines. The review covers studies published from 2020 to 2025. A quality assessment rubric was designed with a focus on code executability and security relevance. Studies that did not validate functional correctness or lacked sufficient experimental detail were excluded. After filtering, 31 primary studies were selected for detailed analysis. Results: The review reveals a clear trade-off between deployability and reliability. Passive attribution techniques are non-intrusive and easy to deploy, but degrade significantly under common code transformations such as refactoring or variable renaming. Active watermarking methods provide stronger verifiability and ownership guarantees while generally preserving functionality and readability. However, many token-level schemes remain fragile under semantic-preserving transformations. Syntax-aware and semantic-level approaches demonstrate improved robustness but incur higher computational costs. Conclusion: Overall, existing provenance techniques are largely non-intrusive and suitable for clean environments. Current research tends to favor accuracy and invisibility over long-term robustness. Future work should focus more on semantic-level resilience and adopt shared adversarial benchmarks to better reflect real-world threats. {\textcopyright} 2026 Published by Elsevier B.V.},
	language = {English},
