@article{wei_cosformer_2026,
	title = {{CosFormer}: {A} {Code} {Semantic}-{Aware} {Transformer} for {Vulnerability} {Detection}},
	issn = {00985589 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105029114236?origin=resultslist},
	doi = {10.1109/TSE.2026.3659630},
	abstract = {Deep learning-based vulnerability detection has made significant strides, surpassing traditional static and dynamic analysis methods. However, existing approaches, including Graph Neural Networks (GNNs) and Transformer-based models, still struggle to fully capture complex code semantics. In this paper, we propose CosFormer, a novel Code Semantic-aware Transformer tailored for vulnerability detection. CosFormer introduces two key components: Code Semantic-aware Embedding, which enhances semantic representation at both the token and line levels, and Spatial Dependency-aware Encoding, which integrates structural dependencies from Control Flow Graphs (CFGs) and Program Dependency Graphs (PDGs) to guide attention toward vulnerability-relevant code. We evaluate CosFormer on four benchmark datasets, including a real-world dataset, and demonstrate its superior performance. CosFormer achieves the highest F1 scores across all tasks, outperforming state-of-the-art GNN-based and Transformer-based models, as well as large language models (LLMs). Notably, CosFormer achieves a Cross F1 of 69.37 and a Mixed F1 of 58.42 in generalization evaluation, surpassing all baselines. These results highlight CosFormer{\textquoteright}s effectiveness and robustness in detecting vulnerabilities across diverse and previously unseen codebases. {\textcopyright} 1976-2012 IEEE.},
	language = {English},
	journal = {IEEE Transactions on Software Engineering},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Wei, Q. and Zhang, Z. and Yi, Q. and Ji, Z. and Liang, H.},
	year = {2026},
	keywords = {Natural language processing, Software engineering, Semantics, Deep learning, Vulnerability detection, Natural language processing systems, Natural languages, Benchmarking, Software Engineering, Code semantics, Graphic methods, Deep Learning, Language processing, Encoding (symbols), Natural Language Processing, Vulnerability Detection, Flow graphs, Graph neural networks, Semantic Web, Semantic-aware, Static analysis method, Static and dynamic analysis},
	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: Q. Yi; Beijing University of Posts and Telecommunications, Beijing, China; email: yiqiuping@bupt.edu.cn; Z. Ji; PingAn Technology, Beijing, China; email: jizongcheng@gmail.com; CODEN: IESED},
}

