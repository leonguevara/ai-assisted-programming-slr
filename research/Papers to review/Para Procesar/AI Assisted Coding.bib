	keywords = {Software quality, Software testing, prompt engineering, large language models, Prompt engineering, Formal verification, Language model, Large language model, Computer software selection and evaluation, C (programming language), Software Quality, Formal specification, formal verification, Theorem proving, Engineering activities, Heap-manipulating programs, Human labor, separation logic, Separation logic, Specification generations, Static verification},
