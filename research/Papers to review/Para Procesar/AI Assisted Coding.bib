	annote = {Last updated - 2026-01-27},
	file = {PDF:/Users/lguevara/Zotero/storage/VWKP3BMD/Yang Haneul et al. - 2025 - A Comparative Study on Self-Driving Scenario Code Generation Through Prompt Engineering Based on LLM.pdf:application/pdf},
}

