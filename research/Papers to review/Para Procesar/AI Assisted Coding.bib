	keywords = {code generation, Specifications, Codegeneration, Codes (symbols), Software design, Domain model, Performance, Problem oriented languages, Domains specific languages, Code generators, Optimisations, performance, Action language, Computationally efficient, domain specific languages, Financial regulations, vernacular software development, Vernacular software development},
