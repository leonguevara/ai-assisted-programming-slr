	keywords = {Software engineering, Language model, Structured Query Language, Case-studies, Query processing, Canonical job title, canonical job titles, Data cleaning, Data cleaning with large language model, data cleaning with LLMs, Employment, Job satisfaction, Job search, Metadata evaluation, Metadata generation, Normalisation, occupation taxonomy, Occupation taxonomy},
