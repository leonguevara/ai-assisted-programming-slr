@article{fawareh_measuring_2026,
	title = {Measuring the {Impact} of {Incorporation} for the {Artificial} {Intelligence} ({AI}) {Tools} into {Software} {Development} {Lifecycle} for {Improving} {Software} {System} {Projects}},
	volume = {227},
