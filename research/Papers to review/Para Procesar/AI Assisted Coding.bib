	annote = {Export Date: 04 May 2026; Cited By: 0; Correspondence Address: J. Pecuchova; Constantine the Philosopher University in Nitra, Nitra, Tr. A. Hlinku 1, SK 949 01, Slovakia; email: jpecuchova@ukf.sk},
