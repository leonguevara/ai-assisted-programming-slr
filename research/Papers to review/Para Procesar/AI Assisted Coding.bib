@article{umre_csllm_2026,
	title = {{CSLLM}: {Code}-{Specific} {Large} {Language} {Models}{\textemdash}{A} {Survey}},
	volume = {308},
	issn = {09574174 (ISSN)},
	url = {https://www.scopus.com/pages/publications/105029557136?origin=resultslist},
	doi = {10.1016/j.eswa.2025.130991},
	abstract = {Large Language Models (LLMs) have fundamentally changed code engineering by automating code-related tasks, including code generation, completion, debugging, and optimization. General-purpose LLMs sometimes struggle with code-specific challenges, including syntax errors, suboptimal code efficiency, and security vulnerabilities, notwithstanding their success. Using specialized datasets, domain-adaptive training, and focused fine-tuning techniques, CSLLMs (Code-Specific Large Language Models) have emerged to solve these problems. Synthesizing present research on CSLLMs, this literature review investigates their architectures, training paradigms, motivating strategies, fine-tuning techniques, benchmark datasets, and evaluation approaches. To highlight their strengths, constraints, and useful applications, eminent models including Codex, CodeT5, StarCoder, and DeepSeekCoder are arranged and comparatively studied. Driven by methods including identifier-aware pretraining, retrieval-augmented learning, and execution-based evaluation, the results show that CSLLMs routinely outperform general-purpose models in code accuracy, syntactic correctness, and execution reliability. Still, there are important obstacles, including ethical issues in code generation, computational complexity, and dataset biases. Our study emphasizes exciting research directions, supports hybrid architectures, strong execution-based evaluations, and ethical frameworks, and guides next developments in AI-assisted programming for both industry and academia. {\textcopyright} 2025 Elsevier Ltd. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	language = {English},
	journal = {Expert Systems with Applications},
	publisher = {Elsevier Ltd},
	author = {Umre, J. and Parihar, A.S. and Gupta, A.},
	year = {2026},
	keywords = {Software engineering, Computational linguistics, Language model, Syntactics, Codegeneration, Codes (symbols), Computer programming languages, Large datasets, Fine tuning, Automatic programming, Data mining, Optimal systems, Automated code generation, Transformer modeling, AI in programming, AI In programming, Automated code generation,, Ethical technology, Large language model,, Large language models,, Software engineering,, Transformer model,, Transformer models,},
