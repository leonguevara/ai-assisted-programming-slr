@inproceedings{das_-context_2025,
	title = {In-{Context} {Learning} as an {Effective} {Estimator} of {Functional} {Correctness} of {LLM}-{Generated} {Code}},
	isbn = {979-840071592-1 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105011816036?origin=resultslist},
	doi = {10.1145/3726302.3730212},
	abstract = {When applying LLM-based code generation to software development projects that follow a feature-driven or rapid application development approach, it becomes necessary to estimate the functional correctness of the generated code in the absence of test cases. Just as a user selects a relevant document from a ranked list of retrieved ones, a software generation workflow requires a developer to choose (and potentially refine) a generated solution from a ranked list of alternative solutions, ordered by their posterior likelihoods. This implies that estimating the quality of a ranked list - akin to estimating {\textquotedblleft}relevance{\textquotedblright} for query performance prediction (QPP) in IR - is also crucial for generative software development, where quality is defined in terms of {\textquotedblleft}functional correctness{\textquotedblright}. In this paper, we propose an in-context learning (ICL) based approach for code quality estimation. Our findings demonstrate that providing few-shot examples of functionally correct code from a training set enhances the performance of existing QPP approaches as well as a zero-shot-based approach for code quality estimation. {\textcopyright} 2025 Copyright held by the owner/author(s).},
	language = {English},
	booktitle = {{SIGIR} - {Proc}. {Int}. {ACM} {SIGIR} {Conf}. {Res}. {Dev}. {Inf}. {Retr}.},
	publisher = {Association for Computing Machinery, Inc},
	author = {Das, S. and Ghosh, M. and Swami, P. and Ganguly, D. and Calikli, G.},
	year = {2025},
	note = {Journal Abbreviation: SIGIR - Proc. Int. ACM SIGIR Conf. Res. Dev. Inf. Retr.},
	keywords = {Software quality, Software testing, Code Generation, Code quality, Codegeneration, Codes (symbols), Automatic programming, Software design, Application programs, Optimal systems, Context learning, In contexts, In-context learning, Functional correctness, Functional programming, Code quality estimation, Code Quality Estimation, Quality estimation, In-Context Learning, Query-performance predictions, Software development projects},
	pages = {2890--2894},
	annote = {Export Date: 04 May 2026; Cited By: 1; Conference name: 48th International ACM SIGIR Conference on Research and Development in Information Retrieval, SIGIR 2025; Conference date: 13 July 2025 through 18 July 2025; Conference code: 210356},
