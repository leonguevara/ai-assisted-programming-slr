	keywords = {Software quality, Teaching, Software testing, Students, Curricula, Language model, Requirements engineering, Software design, User stories, Application programs, Computer software selection and evaluation, Behavioral research, Model checking, Software agents, Agile software development, AI Technologies, Collaboration network, complex network analysis, Complex network analysis, Creep testing, Negative bias temperature instability, Outages, Story generations, structured collaboration network, Structured collaboration network, Student teams},
	annote = {Export Date: 04 May 2026; Cited By: 4; Conference name: 54th IEEE Frontiers in Education Conference, FIE 2024; Conference date: 13 October 2024 through 16 October 2024; Conference code: 207261; CODEN: PFECD},
