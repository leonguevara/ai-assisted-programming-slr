	year = {2024},
	note = {Journal Abbreviation: Proceeding - IEEE Cloud Summit, Cloud Summit},
	keywords = {LLM, Software testing, Costs, Open source software, Language model, Large language model, Software design, Computer software selection and evaluation, Program processors, C (programming language), Reviews, Problem oriented languages, Model checking, Investments, Block-chain, DevSecOps, Bill of materials, Devsecop, Supply chain management, Blockchain, UNIX, Concrete tanks, Financial markets, Gas cylinders, Llama2, NFT, PBOM, Pipeline bill of material, Plastic bottles, SBOM, Software bill of material},
	pages = {28--35},
