	keywords = {Software quality, Software reliability, Search engines, Large Language Models, Code quality, Computer aided software engineering, Language model, Large language model, Multi agent, Software design, Application programs, Computer operating systems, Computer software selection and evaluation, Software packages, Intelligent agents, Computer software maintenance, Formal methods, Autonomous agents, Multiagent systems (MASs), Multi-agent systems, Agent specialization, Auction mechanisms, Auctions mechanisms, Consensus protocols, Software refactoring, Specialisation},
	pages = {488--493},
