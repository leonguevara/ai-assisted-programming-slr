	year = {2025},
	note = {Journal Abbreviation: Proc. - Annu. Comput. Secur. Appl. Conf. Workshops, ACSACW},
	keywords = {Large Language Models, DevSecOps, Vulnerability Detection, CI/CD, Confidence Calibration, Ensembles, Uncertainty Quantification},
