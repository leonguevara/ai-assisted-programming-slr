	isbn = {979-833159948-5 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105033220011?origin=resultslist},
	doi = {10.1109/CASCON66301.2025.00084},
	abstract = {Understanding and validating user requirements is crucial to successful software development. However, manual User Acceptance Testing is often time-consuming, error-prone, and susceptible to bias, making automation an attractive alternative. This paper proposes a zero-shot learning framework for automating User Acceptance Testcase (UAT) generation using Large Language Models (LLMs). Five state-of-the-art LLMs-Gemma, LLaMA3, Mistral, Phi, and Qwen-are evaluated on the PURE dataset of Software Requirements Specification (SRS) documents. The methodology includes SRS text extraction, self-optimizing prompt generation, iterative test case generation, and comprehensive evaluation using both quantitative metrics (e.g., lexical similarity, semantic similarity via BERTScore, diversity, and test case volume) and qualitative analyses (e.g., word clouds and term frequency distributions). Results indicate that while Gemma produces the highest number of test cases, models like Qwen offer better semantic accuracy (with a BERTScore F1 of 80.58\%), diversity, and broader requirement coverage. This work demonstrates the potential of LLMs to streamline UAT generation and highlights future directions for scaling and optimizing such frameworks within real-world software engineering workflows. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Proc. - {IEEE} {Int}. {Conf}. {Collab}. {Adv}. {Softw}. {Comput}., {CASCON}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
