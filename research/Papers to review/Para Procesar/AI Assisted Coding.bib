@article{kessel_promoting_2024,
	title = {Promoting open science in test-driven software experiments},
	volume = {212},
	issn = {01641212 (ISSN)},
	url = {https://www.scopus.com/pages/publications/85187223996?origin=resultslist},
	doi = {10.1016/j.jss.2024.111971},
	abstract = {A core principle of open science is the clear, concise and accessible publication of empirical data, including {\textquotedblleft}raw{\textquotedblright} observational data as well as processed results. However, in empirical software engineering there are no established standards (de jure or de facto) for representing and {\textquotedblleft}opening{\textquotedblright} observations collected in test-driven software experiments {\textemdash} that is, experiments involving the execution of software subjects in controlled scenarios. Execution data is therefore usually represented in ad hoc ways, often making it abstruse and difficult to access without significant manual effort. In this paper we present new data structures designed to address this problem by clearly defining, correlating and representing the stimuli and responses used to execute software subjects in test-driven experiments. To demonstrate their utility, we show how they can be used to promote the repetition, replication and reproduction of experimental evaluations of AI-based code completion tools. We also show how the proposed data structures facilitate the incremental expansion of execution data sets, and thus promote their repurposing for new experiments addressing new research questions. {\textcopyright} 2024 The Author(s)},
	language = {English},
	journal = {Journal of Systems and Software},
	publisher = {Elsevier Inc.},
	author = {Kessel, M. and Atkinson, C.},
	year = {2024},
	keywords = {Generative artificial intelligence, Large language models, Automation, Machine learning, Software, Software testing, Data structures, Engineering, Behavior, HumanEval, Language model, Large language model, Codes (symbols), Machine-learning, Learning systems, Reproducibilities, Open science, Humaneval, Benchmark, Replication, Cell proliferation, Empirical, Experimentation, Language-to-code, Measurement, Observation, Reproducibility},
	annote = {Export Date: 04 May 2026; Cited By: 4; Correspondence Address: M. Kessel; University of Mannheim, Mannheim, 68159, Germany; email: marcus.kessel@uni-mannheim.de; CODEN: JSSOD},
}

@inproceedings{ramanan_aspire_2024,
	title = {{ASPIRE}: {A} {Multi}-{Agent} {Framework} for {Execution}-{Free} {Code} {Analysis} and {Repair}},
	isbn = {26391589 (ISSN); 979-835036248-0 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85218002870?origin=resultslist},
	doi = {10.1109/BigData62323.2024.10825553},
	abstract = {The proliferation of Large Language Models (LLMs) and agentic systems for code generation introduces new challenges in ensuring the reliability and correctness of generated programs. Errors in dynamically generated code can cascade through workflows, leading to inefficiencies or failures in critical systems. We present ASPIRE, a multi-agent framework designed to address these challenges by providing execution-free static analysis and laying the foundation for program repair. ASPIRE's agents collaboratively simulate runtime traces, predict program states, and evaluate code correctness without requiring actual execution, making it particularly suited for LLM-generated code and agentic workflows. Experimental results on a curated dataset from Codeforces show ASPIRE achieving {\textasciitilde}56\% accuracy in verdict prediction, with a 33\% improvement when employing multi-agent collaboration. While program repair remains an area of future work, ASPIRE demonstrates significant potential as a safeguard for dynamic, LLM-driven code generation systems. {\textcopyright} 2024 IEEE.},
	language = {English},
	booktitle = {Proc. - {IEEE} {Int}. {Conf}. {Big} {Data}, {BigData}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Ramanan, B.A. and Khan, M.A. and Rao, A.},
