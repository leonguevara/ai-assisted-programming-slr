	year = {2024},
	note = {Journal Abbreviation: Lect. Notes Comput. Sci.},
	keywords = {Generative AI, Software testing, Language model, Codegeneration, Software design, Application programs, Program processors, WEB application, Web applications, Benchmarking, Static analysis, Security vulnerabilities, Hybrid approach, Web development, Risk assessment, Security Vulnerabilities, Web Development, Web Design, Application codes, File upload},
	pages = {425--437},
