	keywords = {Maintainability, Software quality, Defects, Software reliability, Large Language Models, Software security, Security systems, Language model, Large language model, Codegeneration, Codes (symbols), Computer programming languages, Software design, Computer software selection and evaluation, Network security, Security vulnerabilities, Software Security, AI code generation, Software defects, Industrial management, Code complexity, Code Complexity, Structural complexity, AI Code Generation, Orthogonal defect classification, Orthogonal Defect Classification, Software Defects},
	pages = {252--263},
	annote = {Export Date: 04 May 2026; Cited By: 1; Correspondence Address: D. Cotroneo; University of Naples Federico Ii, Naples, Italy; email: cotroneo@unina.it; Conference name: 36th IEEE International Symposium on Software Reliability Engineering, ISSRE 2025; Conference date: 21 October 2025 through 24 October 2025; Conference code: 216135; CODEN: PSSRF},
