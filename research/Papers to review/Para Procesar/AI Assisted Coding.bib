@inproceedings{abi-karam_hls-eval_2025,
	title = {{HLS}-{Eval}: {A} {Benchmark} and {Framework} for {Evaluating} {LLMs} on {High}-{Level} {Synthesis} {Design} {Tasks}},
	isbn = {979-833152597-2 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105015892654?origin=resultslist},
	doi = {10.1109/ICLAD65226.2025.00021},
	abstract = {The rapid scaling of large language model (LLM) training and inference has accelerated their adoption in semiconductor design across academia and industry. Most prior works benchmark LLMs for design tasks involving hardware description languages (HDLs), primarily Verilog. Meanwhile, designers are increasingly using high-level synthesis (HLS) to develop domain-specific accelerators and other hardware systems. However, benchmarks and tooling to comprehensively evaluate LLMs for HLS design tasks remain scarce.To address this, we introduce HLS-Eval, the first comprehensive benchmark and evaluation framework for LLM-driven HLS design tasks. HLS-Eval focuses on evaluating two key high-level tasks: 1) generating HLS code from natural language descriptions, and 2) making HLS-specific code edits to existing HLS code, primarily targeting HW optimization and performance gains. To evaluate these tasks, we construct the HLS-Eval benchmark consisting of 94 unique designs as benchmark cases. These designs are drawn from a diverse mix of established community HLS benchmarks and novel sources. Using a semi-automated flow, we prepare each case to be "LLM-ready", supplemented with a natural language description and a corresponding testbench for C-simulation and HLS synthesis validation.Beyond the benchmark designs, HLS-Eval provides a framework for automated, parallel evaluation of both local and hosted LLMs across various HLS design tasks. It features a parallel evaluation engine, seamless HLS tool interfaces for LLMs, and an abstraction to support different LLM interaction paradigms, all wrapped in a modular Python API. With HLS-Eval, users can rapidly prototype and evaluate new benchmark sources, HLS design tasks, and LLM methodologies, speeding up the research and development of new AI-driven HLS workflows.We demonstrate the utility of HLS-Eval through baseline evaluations of popular open-source LLMs for HLS code generation and code editing tasks targeting Vitis HLS. Our evaluation assesses LLM-generated HLS code across four critical metrics: "parseability", "compilability", "runnability", and "synthesizability"- mirroring the iterative debugging and testing process of an HLS designer. Additionally, we provide pass@k metrics for common design tasks, establishing clear evaluation criteria, baselines, and the necessary infrastructure for others in the LLM hardware design community to build upon.We open-source our benchmark, framework, and evaluation results at https://github.com/sharc-lab/hls-eval.  {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Proc. - {IEEE} {Int}. {Conf}. {LLM}-{Aided} {Des}., {ICLAD}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Abi-Karam, S. and Hao, C.},
	year = {2025},
	note = {Journal Abbreviation: Proc. - IEEE Int. Conf. LLM-Aided Des., ICLAD},
	keywords = {Automation, large language model, Open source software, Computer aided software engineering, Language model, Large language model, Codes (symbols), Language description, Natural languages, Software design, Computer hardware, Computer hardware description languages, Open systems, Application programming interfaces (API), C (programming language), Benchmarking, Problem oriented languages, benchmark, Benchmark, Computer simulation languages, High level synthesis, High-level synthesis, Integrated circuit design, Synthesis design, Design tasks, fpga, Fpgum, high-level synthesis, Logic Synthesis, Semiconductor device manufacture, Synthesis code},
	pages = {219--226},
