@inproceedings{yao_cimas_2025,
	title = {{CIMAS}: {A} {Multilingual} {Semantic}-{Driven} {Model} for {Code} {Idiom} {Mining}, {Abstraction} and {Synthesis}},
	isbn = {15301362 (ISSN); 979-833156653-1 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105035192067?origin=resultslist},
