@inproceedings{vera-amaro_towards_2025,
	title = {Towards a {Conceptual} {Model} for {Ai}-{Driven} {Web} {Accessibility} {Remediation}: {A} {Prompt}-{Based} {Approach}},
	isbn = {979-833156728-6 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105034775552?origin=resultslist},
	doi = {10.1109/CONISOFT66928.2025.00044},
	abstract = {Ensuring web accessibility remains challenging, especially for sites not originally built with inclusion in mind. This paper proposes a conceptual model to automate accessibility remediation by leveraging large language models (LLMs) to generate content that is inherently accessible. The proposal is based on a scoping review of 83 relevant studies using an adapted PRISMA-ScR methodology aligned with best practices in software engineering. The model integrates five core components: input acquisition, intermediate transformation, prompt configuration, generative inference, and output evaluation. Its architecture allows flexible input configurations and supports empirical comparison of generative strategies, laying the foundation for adaptable, scalable remediation workflows. By bridging accessibility standards and generative AI capabilities, the model contributes a reproducible framework for integrating inclusive practices into modern software engineering pipelines.  {\textcopyright} 2025 IEEE.},
