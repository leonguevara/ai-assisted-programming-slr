@inproceedings{majdoub_debugging_2024,
	title = {Debugging with {Open}-{Source} {Large} {Language} {Models}: {An} {Evaluation}},
	isbn = {19493770 (ISSN); 979-840071047-6 (ISBN)},
	url = {https://www.scopus.com/pages/publications/85210593799?origin=resultslist},
