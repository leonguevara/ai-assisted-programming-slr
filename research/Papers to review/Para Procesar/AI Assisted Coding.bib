	year = {2024},
	note = {Journal Abbreviation: Proc. - ACM/IEEE Int. Conf. Autom. Softw. Eng., ASE},
	keywords = {Integrated development environment, Language model, Codegeneration, Computer software selection and evaluation, Utility programs, Model-based OPC, Program debugging, Code completions, Domains specific languages, Acceptance rate, General-purpose programming language, Lightspeed, Specific languages, Tachometers},
	pages = {2148--2158},
