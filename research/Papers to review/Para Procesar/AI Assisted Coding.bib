	keywords = {Software engineering, technical debt, code generation, Code Generation, automated software engineering, Computer software, Technical debts, Model-driven Engineering, Automatically generated, Code generators, Software project, Executable codes, code analysis, Odors, code comprehension, UML, code smell, forward engineering, handwritten code, Human comprehensions, model driven engineering},
	pages = {1308--1321},
