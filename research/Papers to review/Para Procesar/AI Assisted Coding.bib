@inproceedings{mehta_electric_2025,
	title = {Electric {Vehicle} ({EV}) {Modelling} {Using} {Simulink}},
	isbn = {979-833156815-3 (ISBN)},
	url = {https://www.scopus.com/pages/publications/105033652673?origin=resultslist},
	doi = {10.1109/ICFT66708.2025.11336427},
	abstract = {As we are progressing towards a greener and cleaner environment, Electric Vehicles (EVs) have begun transforming the world with their environmentally friendly benefits and are replacing internal-combustion-engine vehicles. This paper focuses on modelling and simulation of key EV components using Simulink. The subsystems modelled include a Driver Subsystem, Motor Controller Subsystem, Drivetrain Subsystem, Vehicle Body Subsystem, and a State-of-Charge (SOC) Subsystem. The Driver Subsystem simulates driver behavior to generate throttle and brake commands based on the desired speed and drive cycle. The Motor Controller Subsystem processes these commands to produce appropriate H-bridge signals for the motor. The Drivetrain Subsystem models power transmission to the wheels, producing current and axle speed. The Vehicle Body Subsystem models vehicle dynamics, converting axle speed to vehicle speed. The SOC Subsystem models battery behavior and updates SOC based on the current drawn. Simulink further enables C/C++ code generation; Software-in-the-Loop (SIL) verification can validate generated code prior to hardware integration. In our simulations, the proposed model achieved 70 km range under FTP75, 84 km under NEDC (80 percent SOC), and up to 105 km under NEDC at 100 percent SOC, demonstrating its validity and energy-efficiency analysis capability. This approach pulls together subsystem modelling and SIL verification in a way that's unique. It supports quick EV software development and performance evaluation which makes things faster overall. {\textcopyright} 2025 IEEE.},
	language = {English},
	booktitle = {Int. {Conf}. {Future} {Technol}., {ICFT}},
