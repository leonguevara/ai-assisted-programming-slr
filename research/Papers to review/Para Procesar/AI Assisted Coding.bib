	abstract = {This thesis explores the integration of artificial intelligence (AI) in software development. Conducted at the consultancy company Amaceit AB, the study explores the current usage of artificial intelligence across various stages of the software development life cycle. It explores AI techniques such as machine learning, neural networks, deep learning, generative AI, and large language models, emphasizing their roles in enhancing efficiency and accuracy in software development. The study examines the use of AI in the planning, requirements gathering, design, development, testing, deployment, and maintenance phases of the software development process, showcasing how AI automates tasks, optimizes code generation, improves testing accuracy, and enables proactive maintenance. Furthermore, the thesis reviews popular AI tools like GitHub Copilot, Amazon CodeWhisperer, Google{\textquoteright}s Bard, Microsoft{\textquoteright}s Bing, Anthropic{\textquoteright}s Claude, and OpenAI{\textquoteright}s ChatGPT, comparing their effectiveness in code generation and analyzes their capabilities, benefits, and challenges. The study combines a literature review and a practical implementation, in the form of an AI-based web application using OpenAI{\textquoteright}s GPT-4 for automated test case generation. Findings highlight AI{\textquoteright}s effectiveness in improving coding efficiency and software quality, showing its ability to automate tasks, streamline workflows, and speed up development cycles, thereby reducing costs and enhancing software quality. While AI serves as a powerful assistant in software development by helping programmers in their everyday work lives, it is not a substitute for human expertise. The evaluation at Amaceit shows promising results in improving the efficiency of test case generation. It also addresses privacy and data security concerns related to adopting AI and proposes future steps to scale AI implementations and integrate tools directly into developer environments.},
	language = {en},
	number = {UPTEC IT 24048},
	school = {Uppsala University},
	author = {Haeggstr{\"o}m, M{\"a}rta},
	year = {2024},
	annote = {E277
},
	annote = {Paper\_277
},
	annote = {SciSpace
},
	file = {PDF:/Users/lguevara/Zotero/storage/ZG8XPRPG/Haeggstr{\"o}m - 2024 - Hands-on Use and Adaptation of AI in Developing and Testing Software Applications.pdf:application/pdf},
}

@misc{suryavanshi_effects_2025,
	title = {The {Effects} of {AI}-{Assisted} {Programming} in {Software} {Engineering}: {A} {Study} on {GitHub} {Copilot}},
	url = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5742364},
	doi = {10.2139/ssrn.5742364},
	abstract = {This study investigates the transformative impact of AI-assisted programming through tools like GitHub Copilot on the field of software engineering. With rising reliance on generative AI (GAI), Copilot serves as an advanced code suggestion tool that converts natural language into code in real time. The study explores its role in enhancing developer efficiency, influencing problem-solving strategies, and reshaping software engineering practices. Through qualitative research involving professional engineers, findings indicate that while Copilot boosts efficiency, it sometimes disrupts cognitive flow and can diminish problem-solving skills due to over-reliance. The tool facilitates creativity and streamlines repetitive coding tasks, suggesting a shift in developers{\textquoteright} roles and educational practices. However, ethical concerns around data privacy, code quality, and trust remain unresolved. This study fills a critical gap by providing real-world insights into the cognitive, educational, and professional changes introduced by AI coding tools.},
	language = {en},
	author = {Suryavanshi, Pradnya Niwas and Jadhav, Dr Ramesh D},
	month = nov,
	year = {2025},
	annote = {E131
},
