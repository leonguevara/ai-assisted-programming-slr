@misc{dora_hidden_2025,
	title = {The {Hidden} {Risks} of {LLM}-{Generated} {Web} {Application} {Code}: {A} {Security}-{Centric} {Evaluation} of {Code} {Generation} {Capabilities} in {Large} {Language} {Models}},
