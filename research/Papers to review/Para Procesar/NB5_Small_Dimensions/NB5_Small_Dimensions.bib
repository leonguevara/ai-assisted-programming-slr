@inproceedings{bonin_exploring_2025,
	title = {Exploring the {Impact} of {Generative} {Artificial} {Intelligence} on {Software} {Development} in the {IT} {Sector}: {Preliminary} {Findings} on {Productivity}, {Efficiency} and {Job} {Security}},
	shorttitle = {Exploring the {Impact} of {Generative} {AI} on {Software} {Development}},
	url = {https://arxiv.org/abs/2508.16811},
	doi = {10.48550/arXiv.2508.16811},
	abstract = {This study investigates the impact of Generative AI on software development within the IT sector through a mixed-method approach, utilizing a survey developed based on expert interviews. The preliminary results of an ongoing survey offer early insights into how Generative AI reshapes personal productivity, organizational efficiency, adoption, business strategy and job insecurity. The findings reveal that 97\% of IT workers use Generative AI tools, mainly ChatGPT. Participants report significant personal productivity gain and perceive organizational efficiency improvements that correlate positively with Generative AI adoption by their organizations (r = .470, p {\textless} .05). However, increased organizational adoption of AI strongly correlates with heightened employee job security concerns (r = .549, p {\textless} .001). Key adoption challenges include inaccurate outputs (64.2\%), regulatory compliance issues (58.2\%) and ethical concerns (52.2\%). This research offers early empirical insights into Generative AI's economic and organizational implications.},
	language = {en},
	urldate = {2026-05-24},
	publisher = {International Conference on Information Systems Development},
	author = {Bonin, Anton Ludwig and Smolinski, Pawel Robert and Winiarski, Jacek},
	month = sep,
	year = {2025},
	note = {Preprint accepted for presentation at ISD 2025},
	annote = {E298
},
	annote = {Paper\_298
},
	file = {PDF:files/5778/Bonin et al. - 2025 - Exploring the Impact of Generative Artificial Intelligence on Software Development in the IT Sector.pdf:application/pdf},
}

@misc{li_exploring_2025,
	title = {Exploring {Altered} {Open} {Source} {Software} {Development} {Patterns} in a {Time} of {Generative} {AI}},
	shorttitle = {Altered {OSS} {Development} {Patterns} in the {Time} of {GenAI}},
	url = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5100609},
	doi = {10.2139/ssrn.5100609},
	abstract = {Recent advances in generative artificial intelligence (AI) have enabled tools that can automate elements of knowledge work, with open source software (OSS) development seeing an influx of AI-based assistants. While these tools show promise in increasing productivity, little is known about how developers adapt to and alter their work patterns in response to novel coding assistants. We leverage the March 2023 announcement and April 2023 public release of GitHub Copilot X (CX) as a natural experiment, analyzing a 27-week user-week panel of 1,350 GitHub developers using difference-in-differences with coarsened exact matching. We further augment our GitHub data with matched LinkedIn career trajectories over the subsequent 6{\textendash}12 months. We find that treated developers increase commit frequency by approximately 12\% and active repositories by 6\%. Beyond volume, work patterns shift toward broader engagement, with casual developers driving a 48\% increase in work hours and increasing their exploration of new programming languages, while active developers show no significant increase in time input. However, this expansion comes with trade-offs in code quality, as we document a 2 percentage-point increase in copy-pasted code and a decline in project novelty for casual users. Finally, we find that AI-enabled shifts in development behavior are associated with a higher likelihood of internal promotions in the short- to medium-term. Overall, our results indicate that advanced AI coding assistants reduce participation frictions and enable altered working patterns, especially benefiting less established developers.},
	language = {en},
	publisher = {SSRN},
	author = {Li, Xinyu and Costello, Francis Joseph and Kim, Keongtae},
	month = mar,
	year = {2025},
	note = {Empirical study; OSS development; generative AI; GitHub-based behavioral analysis},
	annote = {E299
},
	annote = {Paper\_299
},
	file = {PDF:files/5857/Li et al. - Exploring Altered Open Source Software Development Patterns in a Time of Generative AI.pdf:application/pdf},
}
