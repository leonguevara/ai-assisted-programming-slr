}

@article{kuhail_will_2024,
	title = {{\textquotedblleft}{Will} {I} be replaced?{\textquotedblright} {Assessing} {ChatGPT}'s effect on software development and programmer perceptions of {AI} tools},
	volume = {235},
	issn = {01676423},
	shorttitle = {{\textquotedblleft}{Will} {I} be replaced?},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0167642324000340},
	doi = {10.1016/j.scico.2024.103111},
	abstract = {ChatGPT is a language model with artificial intelligence (AI) capabilities that has found utility across various sectors. Given its impact, we conducted two empirical studies to assess the potential and limitations of ChatGPT and other AI tools in software development. In the first study, we evaluated ChatGPT 3.5's effectiveness in generating code for 180 coding problems from LeetCode, an online coding interview preparation platform. Our findings suggest that ChatGPT 3.5 is more effective in solving easy and medium coding problems but less reliable for harder problems. Further, ChatGPT 3.5 is somewhat more effective at coding problems with higher popularity scores. In the second study, we administered a questionnaire (N = 99) to programmers to gain insights into their views on ChatGPT and other AI tools. Our findings indicate that programmers use AI tools for various tasks, such as generating boilerplate code, explaining complex code, and conducting research. AI tools also help programmers to become more productive by creating better-performing, shorter, and more readable code, among other benefits. However, AI tools can sometimes misunderstand requirements and generate erroneous code. While most programmers are not currently concerned about AI tools replacing them, they are apprehensive about what the future may hold. Our research has also revealed associations between AI tool usage, trust, perceived productivity, and job security threats caused by the tools.},
	language = {en},
	urldate = {2026-04-23},
	journal = {Science of Computer Programming},
	author = {Kuhail, Mohammad Amin and Mathew, Sujith Samuel and Khalil, Ashraf and Berengueres, Jose and Shah, Syed Jawad Hussain},
	month = jul,
	year = {2024},
	pages = {103111},
	annote = {E093
},
	annote = {Paper\_093
},
	file = {PDF:files/1612/Kuhail et al. - 2024 - {\textquotedblleft}Will I be replaced{\textquotedblright} Assessing ChatGPT's effect on software development and programmer perceptions.pdf:application/pdf},
}

@phdthesis{mohamed_impact_2025,
	address = {Kingston, Ontario, Canada},
	title = {The {Impact} of {LLM}-{Assistants} on {Software} {Developer} {Productivity}},
	url = {https://queensu.scholaris.ca/server/api/core/bitstreams/999a1cb5-75e8-43cc-a78c-ff0390cef43c/content},
	abstract = {Large language models (LLMs) are transforming software engineering by supporting tasks such as coding, debugging, and documentation. Their rapid adoption raises fundamental questions on how they affect developer productivity. To investigate this, this thesis examines the impact of LLMs on software developers{\textquoteright} productivity through both a systematic literature review (SLR) and an empirical study of Stack Overflow. The SLR covers 37 peer-reviewed studies published between 2014 and 2024. The review synthesizes reported benefits, including reduced code search, accelerated development, and automation of routine tasks, alongside risks such as cognitive offloading, reduced code quality, and diminished team collaboration. The review also identifies a gap in understanding how LLMs reshape collaboration on public knowledge-sharing platforms. To address this, we complement it with an empirical study analyzing 192 Stack Overflow contexts where developers share or reference ChatGPT conversations. Results show references are mainly used to report failed AI solutions, support claims, or provide explanations. Emotion analysis reveals mostly neutral tones, with shifts toward confusion in implicit references and reduced gratitude in explicit ones.

Together, these studies offer both a broad synthesis and a focused case study, highlighting how LLMs affect productivity and reshape collaborative practices.},
	language = {en},
	school = {Queen{\textquoteright}s University},
	author = {Mohamed, Amr},
	month = dec,
	year = {2025},
	annote = {E135
},
	annote = {Paper\_135
},
	file = {PDF:files/1647/Mohamed - The Impact of LLM-Assistants on Software Developer Productivity.pdf:application/pdf},
}

@article{omaraliev_artificial_2025,
	title = {Artificial {Intelligence} in {Development}: {Practical} {Scenarios}},
