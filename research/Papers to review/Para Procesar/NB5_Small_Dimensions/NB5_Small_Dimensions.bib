	note = {Place: La Canada},
	keywords = {Applications programs, Artificial intelligence, Chatbots, Competence, Computers--Artificial Intelligence, Economic, Interviews, Semantic web, Social networks, Software, Transformation},
	pages = {17},
	annote = {Copyright - {\textcopyright} 2026. This work is published under http://creativecommons.org/licenses/by/4.0/ (the "License").~~Notwithstanding the ProQuest Terms and Conditions, you may use this content in accordance with the terms of the License.},
