	keywords = {Computer Science - Computers and Society, Economics - General Economics},
	annote = {Comment: Presented at WITS 2025, CIST 2025, SCECR 2025, INFORMS 2024},
	annote = {E121
},
	annote = {Paper\_121
},
	file = {PDF:files/1529/Xu et al. - 2026 - AI-Assisted Programming Decreases the Productivity of Experienced Developers by Increasing the Techn.pdf:application/pdf},
