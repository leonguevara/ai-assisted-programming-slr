	keywords = {51321:Software Publishers, Artificial intelligence, Business And Economics--Banking And Finance, Chatbots, Hypotheses, Influence, Innovations, Productivity, Software development, Software industry, Structural equation modeling, Technological change, Technology adoption},
	pages = {96--117},
	annote = {Copyright - {\textcopyright} 2025. This work is published under https://creativecommons.org/licenses/by-nc/4.0/ (the {\textquotedblleft}License{\textquotedblright}). Notwithstanding the ProQuest Terms and Conditions, you may use this content in accordance with the terms of the License.},
	annote = {E097
},
