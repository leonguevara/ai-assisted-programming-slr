	booktitle = {Proc. of {IEEE} {Symp}. {Vis}. {Lang}. {Hum}.-{Cent}. {Comput}., {VL}/{HCC}},
	publisher = {IEEE Computer Society},
	author = {Meem, Fairuz Nawer and Johnson, Brittany},
